diff --git a/src/gallium/drivers/freedreno/sweetgl/layerdump.c b/src/gallium/drivers/freedreno/sweetgl/layerdump.c
new file mode 100644
index 0000000..e7a2e3c
--- /dev/null
+++ b/src/gallium/drivers/freedreno/sweetgl/layerdump.c
@@ -0,0 +1,216 @@
+/*
+ * SpringBoard side of sweetgl (sweetenv SpringBoard:DYLD_INSERT_LIBRARIES=...).
+ *
+ * Research aid (SWEETGL_LAYERDUMP=1): every
+ * 30 s from 60 s on, the layers of all windows that carry filters, a
+ * compositing filter or a material/backdrop class, with their view, frame,
+ * colour, opacity and visibility. To see what CA is asked to draw for the
+ * CC toggle circles and App Library plates that its GL renderer drops.
+ */
+#include <CoreFoundation/CoreFoundation.h>
+#include <dispatch/dispatch.h>
+#include <objc/message.h>
+#include <objc/runtime.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "sweet_drm.h"
+
+typedef struct { double x, y, w, h; } rect_t;
+
+static SEL S(const char *n) { return sel_registerName(n); }
+static id call(id o, const char *s) { return o ? ((id (*)(id, SEL))objc_msgSend)(o, S(s)) : nil; }
+static unsigned long count(id a) { return a ? ((unsigned long (*)(id, SEL))objc_msgSend)(a, S("count")) : 0; }
+static id at(id a, unsigned long i) { return ((id (*)(id, SEL, unsigned long))objc_msgSend)(a, S("objectAtIndex:"), i); }
+
+static const char *
+desc(id o, char *buf, size_t len)
+{
+	buf[0] = 0;
+	if (o == nil) {
+		return "-";
+	}
+	CFStringRef d = CFCopyDescription((CFTypeRef)o);
+	if (d != NULL) {
+		CFStringGetCString(d, buf, (CFIndex)len, kCFStringEncodingUTF8);
+		CFRelease(d);
+	}
+	for (char *c = buf; *c; c++) {
+		if (*c == '\n') {
+			*c = ' ';
+		}
+	}
+	return buf;
+}
+
+static int lines;
+
+static void
+walk(id layer, int depth, bool deep)
+{
+	if (layer == nil || lines > 900) {
+		return;
+	}
+	id cf = call(layer, "compositingFilter"), filters = call(layer, "filters");
+	const char *cls = object_getClassName(layer);
+	id delegate = call(layer, "delegate");
+	const char *view = delegate ? object_getClassName(delegate) : "-";
+	deep = deep || strstr(view, "PodBackground") != NULL;
+	bool interesting = deep || cf != nil || count(filters) > 0 || strstr(cls, "Backdrop") || strstr(cls, "Material") ||
+	    strstr(view, "Material") || strstr(view, "RoundButton") || strstr(view, "Pod") || strstr(view, "Visual");
+	if (interesting) {
+		rect_t b = ((rect_t (*)(id, SEL))objc_msgSend)(layer, S("bounds"));
+		rect_t r = ((rect_t (*)(id, SEL, rect_t, id))objc_msgSend)(layer, S("convertRect:toLayer:"), b, nil);
+		float op = ((float (*)(id, SEL))objc_msgSend)(layer, S("opacity"));
+		BOOL hid = ((BOOL (*)(id, SEL))objc_msgSend)(layer, S("isHidden"));
+		double rad = ((double (*)(id, SEL))objc_msgSend)(layer, S("cornerRadius"));
+		const void *bg = ((const void *(*)(id, SEL))objc_msgSend)(layer, S("backgroundColor"));
+		char b1[200], b2[300], b3[160];
+		sweet_drm_log("sweetgl: L%d %s (%s) %.0f,%.0f %.0fx%.0f op %.2f hid %d rad %.1f mask %d contents %d bg %.150s cf %.150s",
+		    depth, cls, view, r.x, r.y, r.w, r.h, op, hid, rad, call(layer, "mask") != nil,
+		    call(layer, "contents") != nil, desc((id)bg, b3, sizeof(b3)), desc(cf, b1, sizeof(b1)));
+		for (unsigned long i = 0; i < count(filters) && i < 4; i++) {
+			id f = at(filters, i);
+			sweet_drm_log("sweetgl:   filter %lu: %.300s", i, desc(f, b2, sizeof(b2)));
+			if (deep) {
+				static const char *keys[] = {"inputColorMatrix", "inputAmount", "inputColor", "inputRadius", "enabled"};
+				for (int k = 0; k < 5; k++) {
+					id key = ((id (*)(id, SEL, const char *))objc_msgSend)((id)objc_getClass("NSString"),
+					    S("stringWithUTF8String:"), keys[k]);
+					id v = ((id (*)(id, SEL, id))objc_msgSend)(f, S("valueForKey:"), key);
+					if (v != nil) {
+						sweet_drm_log("sweetgl:     %s = %.300s", keys[k], desc(v, b2, sizeof(b2)));
+					}
+				}
+			}
+		}
+		if (deep) {
+			sweet_drm_log("sweetgl:     contentsFormat %.60s cornerCurve %.40s masksToBounds %d compositingFilter %.100s",
+			    desc(call(layer, "contentsFormat"), b1, sizeof(b1)), desc(call(layer, "cornerCurve"), b2, sizeof(b2)),
+			    ((BOOL (*)(id, SEL))objc_msgSend)(layer, S("masksToBounds")), desc(cf, b3, sizeof(b3)));
+		}
+		lines++;
+	}
+	bool sub_deep = deep || strstr(view, "RoundButton") || strstr(view, "PodBackground");
+	id subs = call(layer, "sublayers");
+	for (unsigned long i = 0; i < count(subs); i++) {
+		walk(at(subs, i), depth + 1, sub_deep);
+	}
+}
+
+static void
+dump(void *ctx)
+{
+	static int round;
+	Class w = objc_getClass("UIWindow");
+	id wins = w ? ((id (*)(id, SEL, BOOL, BOOL))objc_msgSend)((id)w, S("allWindowsIncludingInternalWindows:onlyVisibleWindows:"),
+	    YES, YES) : nil;
+	lines = 0;
+	sweet_drm_log("sweetgl: layer dump %d: %lu windows", round, count(wins));
+	for (unsigned long i = 0; i < count(wins); i++) {
+		id win = at(wins, i);
+		sweet_drm_log("sweetgl: window %s", object_getClassName(win));
+		walk(call(win, "layer"), 0, false);
+	}
+	if (++round < 8) {
+		dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC), dispatch_get_main_queue(), NULL, dump);
+	}
+	(void)ctx;
+}
+
+void
+sweetgl_layerdump_start(void)
+{
+	dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC), dispatch_get_main_queue(), NULL, dump);
+}
+
+/*
+ * CA's GL renderer never draws a solid-colour layer whose only filter is
+ * vibrantColorMatrix (CC toggle off-circles, App Library category plates:
+ * it builds no source surface for it, so the filtered result is empty).
+ * In SpringBoard such layers lose the filter and get their background
+ * colour's alpha scaled instead: the lighter translucent shape the filter
+ * makes of the backdrop.
+ * ponytail: brightness from the matrix bias only, no saturation; plain
+ * CALayer class only (material/backdrop layers render fine).
+ */
+#include <CoreGraphics/CoreGraphics.h>
+
+static IMP orig_set_filters, orig_set_bg;
+static char vibrant_key;
+
+static float
+vibrant_alpha(id filter)
+{
+	id key = ((id (*)(id, SEL, const char *))objc_msgSend)((id)objc_getClass("NSString"), S("stringWithUTF8String:"),
+	    "inputColorMatrix");
+	id v = ((id (*)(id, SEL, id))objc_msgSend)(filter, S("valueForKey:"), key);
+	float m[20] = {0};
+	/* an NSValue holding a CAColorMatrix (20 floats) */
+	if (v != nil && ((BOOL (*)(id, SEL, SEL))objc_msgSend)(v, S("respondsToSelector:"), S("getValue:size:"))) {
+		((void (*)(id, SEL, void *, unsigned long))objc_msgSend)(v, S("getValue:size:"), m, sizeof(m));
+	}
+	float bias = (m[4] + m[9] + m[14]) / 3;     /* rows r,g,b: 5th column */
+	float a = bias > 0.05f ? bias : 0.15f;
+	a = a > 0.5f ? 0.5f : a;
+	static int logged;
+	if (logged++ < 20) {
+		sweet_drm_log("sweetgl: vibrantColorMatrix -> fill alpha %.2f (bias %.3f, m11 %.3f m22 %.3f m33 %.3f)", a, bias, m[0],
+		    m[6], m[12]);
+	}
+	return a;
+}
+
+static id
+scaled_color(id layer, CGColorRef c)
+{
+	id f = objc_getAssociatedObject(layer, &vibrant_key);
+	if (c == NULL || f == nil) {
+		return (id)c;
+	}
+	float a = ((float (*)(id, SEL))objc_msgSend)(f, S("floatValue"));
+	CGColorRef s = CGColorCreateCopyWithAlpha(c, CGColorGetAlpha(c) * a);
+	return (id)CFAutorelease(s);
+}
+
+static void
+set_bg(id self, SEL cmd, CGColorRef c)
+{
+	((void (*)(id, SEL, id))orig_set_bg)(self, cmd, scaled_color(self, c));
+}
+
+static void
+set_filters(id self, SEL cmd, id filters)
+{
+	id one = count(filters) == 1 ? at(filters, 0) : nil;
+	id type = one ? call(one, "type") : nil;
+	const char *t = type ? ((const char *(*)(id, SEL))objc_msgSend)(type, S("UTF8String")) : "";
+	if (object_getClass(self) == objc_getClass("CALayer") && strcmp(t, "vibrantColorMatrix") == 0 &&
+	    call(self, "contents") == nil) {
+		id num = ((id (*)(id, SEL, float))objc_msgSend)((id)objc_getClass("NSNumber"), S("numberWithFloat:"),
+		    vibrant_alpha(one));
+		CGColorRef bg = (CGColorRef)(void *)call(self, "backgroundColor");
+		bool had = objc_getAssociatedObject(self, &vibrant_key) != nil;
+		objc_setAssociatedObject(self, &vibrant_key, num, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+		((void (*)(id, SEL, id))orig_set_filters)(self, cmd, nil);
+		if (!had) {
+			set_bg(self, S("setBackgroundColor:"), bg);
+		}
+		return;
+	}
+	objc_setAssociatedObject(self, &vibrant_key, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+	((void (*)(id, SEL, id))orig_set_filters)(self, cmd, filters);
+}
+
+void
+sweetgl_vibrant_fill_install(void)
+{
+	Class c = objc_getClass("CALayer");
+	Method mf = class_getInstanceMethod(c, S("setFilters:")), mb = class_getInstanceMethod(c, S("setBackgroundColor:"));
+	if (mf == NULL || mb == NULL) {
+		return;
+	}
+	orig_set_filters = method_setImplementation(mf, (IMP)set_filters);
+	orig_set_bg = method_setImplementation(mb, (IMP)set_bg);
+	sweet_drm_log("sweetgl: vibrant fill workaround installed");
+}
diff --git a/src/gallium/drivers/freedreno/sweetgl/river_drm.c b/src/gallium/drivers/freedreno/sweetgl/river_drm.c
new file mode 100644
index 0000000..2a11489
--- /dev/null
+++ b/src/gallium/drivers/freedreno/sweetgl/river_drm.c
@@ -0,0 +1,86 @@
+/*
+ * sweetgl on river: what sweet_drm.c (msm DRM emulation over SweetGPU) did
+ * on the Pixel port. River's freedreno has a native RiverGPU backend
+ * (src/freedreno/drm/river), so only three things remain: an fd for
+ * fd_screen_create, IOSurface import through the screen's own RiverGPU
+ * connection (kernel BO_IMPORT, patch 0183) and the log (RiverGPU LOG).
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <IOKit/IOKitLib.h>
+
+#include "util/u_inlines.h"
+#include "freedreno_screen.h"
+#include "sweet_drm.h"
+#include "sweetgl.h"
+
+int river_device_import_surface(struct fd_device *dev, uint32_t surface_id,
+                                uint32_t *handle, uint64_t *size, uint32_t *offset);
+
+static io_service_t
+river_gpu_service(void)
+{
+	return IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("RiverGPU"));
+}
+
+int
+sweet_drm_open(void)
+{
+	io_service_t svc = river_gpu_service();
+	if (svc == IO_OBJECT_NULL) {
+		return -1;
+	}
+	IOObjectRelease(svc);
+	return open("/dev/null", O_RDWR | O_CLOEXEC);
+}
+
+int
+sweet_drm_import_iosurface(uint32_t surface_id, uint64_t map, uint32_t *handle, uint64_t *size)
+{
+	(void)map;
+	struct pipe_screen *screen = sweetgl_screen();
+	if (screen == NULL) {
+		return -ENODEV;
+	}
+	uint32_t offset = 0;
+	return river_device_import_surface(fd_screen(screen)->dev, surface_id, handle, size, &offset);
+}
+
+static pthread_once_t log_once = PTHREAD_ONCE_INIT;
+static io_connect_t log_conn;
+
+static void
+log_open(void)
+{
+	io_service_t svc = river_gpu_service();
+	if (svc != IO_OBJECT_NULL) {
+		if (IOServiceOpen(svc, mach_task_self(), 0, &log_conn) != KERN_SUCCESS) {
+			log_conn = MACH_PORT_NULL;
+		}
+		IOObjectRelease(svc);
+	}
+}
+
+void
+sweet_drm_log(const char *fmt, ...)
+{
+	pthread_once(&log_once, log_open);
+	if (log_conn == MACH_PORT_NULL) {
+		return;
+	}
+	char line[512];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n <= 0) {
+		return;
+	}
+	if (n > (int)sizeof(line) - 1) {
+		n = sizeof(line) - 1;
+	}
+	IOConnectCallMethod(log_conn, 6 /* LOG */, NULL, 0, line, (size_t)n, NULL, NULL, NULL, NULL);
+}
diff --git a/src/gallium/drivers/freedreno/sweetgl/sweet_drm.h b/src/gallium/drivers/freedreno/sweetgl/sweet_drm.h
new file mode 100644
index 0000000..7b46bec
--- /dev/null
+++ b/src/gallium/drivers/freedreno/sweetgl/sweet_drm.h
@@ -0,0 +1,17 @@
+/* sweetgl on river: RiverGPU glue (river_drm.c) and its log. */
+#ifndef SWEET_DRM_H
+#define SWEET_DRM_H
+
+#include <stdint.h>
+
+/* A placeholder fd for fd_screen_create (dup of /dev/null), or -1 without RiverGPU. */
+int sweet_drm_open(void);
+
+/* A buffer handle (of the screen's RiverGPU connection) for an IOSurface's
+ * memory: 0 or -errno. map is unused on river (the kernel finds the pages). */
+int sweet_drm_import_iosurface(uint32_t surface_id, uint64_t map, uint32_t *handle, uint64_t *size);
+
+/* printf-style line to the kernel log (RiverGPU LOG, i.e. the USB live log). */
+void sweet_drm_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+#endif
diff --git a/src/gallium/drivers/freedreno/sweetgl/sweetgl.c b/src/gallium/drivers/freedreno/sweetgl/sweetgl.c
new file mode 100644
index 0000000..ccf1163
--- /dev/null
+++ b/src/gallium/drivers/freedreno/sweetgl/sweetgl.c
@@ -0,0 +1,303 @@
+/*
+ * sweetgl: Mesa (gallium freedreno + GLES) as a library for iOS processes.
+ *
+ * A minimal gallium frontend after Mesa's Haiku one (frontends/hgl): one
+ * pipe_screen over RiverGPU (river_drm.c; sweet_drm.c on the Pixel port), GLES contexts made
+ * current without a drawable (surfaceless: CoreAnimation draws into FBOs
+ * only). IOSurfaces will come in as EGL-style images (get_egl_image).
+ *
+ * SWEETGL_TEST=1 in the environment runs sweetgl_selftest() on a thread at
+ * load: an offscreen triangle, read back and checked, result in the kernel
+ * log as "sweetgl: ...".
+ */
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <mach/mach_time.h>
+
+#include "pipe/p_screen.h"
+#include "pipe/p_context.h"
+#include "frontend/api.h"
+#include "state_tracker/st_context.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include "freedreno_screen.h"
+#include "renderonly/renderonly.h"
+#include <GLES3/gl3.h>
+
+#include "sweet_drm.h"
+#include "sweetgl.h"
+
+static const driOptionDescription sweetgl_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "driinfo_freedreno.h"
+};
+
+/* freedreno calls these only with a renderonly device (KMS scanout); we pass none */
+void
+renderonly_scanout_destroy(struct renderonly_scanout *scanout, struct renderonly *ro)
+{
+	(void)scanout;
+	(void)ro;
+}
+
+struct renderonly_scanout *
+renderonly_create_gpu_import_for_resource(struct pipe_resource *rsc, struct renderonly *ro,
+    struct winsys_handle *out_handle)
+{
+	(void)rsc;
+	(void)ro;
+	(void)out_handle;
+	return NULL;
+}
+
+struct sweetgl_ctx {
+	struct st_context *st;
+	int api;
+};
+
+/* Mesa 26 calls this from st_api_create_context; NULL crashed (r52). */
+static int
+sweetgl_get_param(struct pipe_frontend_screen *fs, enum st_manager_param param)
+{
+	(void)fs;
+	(void)param;
+	return 0;
+}
+
+static pthread_mutex_t init_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct pipe_frontend_screen *fscreen;
+static driOptionCache opt_info, opts;
+
+bool
+sweetgl_init(void)
+{
+	pthread_mutex_lock(&init_lock);
+	if (fscreen == NULL) {
+		int fd = sweet_drm_open();
+		if (fd >= 0) {
+			/*
+			 * Render straight to memory, no GMEM tiles: tile restore/resolve
+			 * covers whole 32-row blocks past the end of IOSurfaces that were
+			 * not padded for it (GPU fault on the display surface, boot 0154a).
+			 */
+			setenv("FD_MESA_DEBUG", "sysmem,nofp16", 0);
+			/*
+			 * nofp16: CA's shaders count on Apple's mediump/lowp being enough for
+			 * texture coordinates and corner shapes; fp16 is not (App
+			 * Library pod corners/backdrops, the wallpaper "+").
+			 */
+			setenv("IR3_SHADER_DEBUG", "nofp16", 0);
+			/* fd_screen_create fills opts from opt_info (no xmlconfig: defaults) */
+			driParseOptionInfo(&opt_info, sweetgl_driconf, ARRAY_SIZE(sweetgl_driconf));
+			struct pipe_screen_config cfg = {.options = &opts, .options_info = &opt_info};
+			struct pipe_screen *screen = fd_screen_create(fd, &cfg, NULL);
+			if (screen == NULL) {
+				sweet_drm_log("sweetgl: freedreno screen creation failed");
+				close(fd);
+			} else {
+				fscreen = calloc(1, sizeof(*fscreen));
+				fscreen->screen = screen;
+				fscreen->get_param = sweetgl_get_param;
+				sweetgl_image_hooks(fscreen);  /* before any context: st checks them at creation */
+				sweet_drm_log("sweetgl: screen %s (%s)", screen->get_name(screen),
+				    screen->get_vendor(screen));
+			}
+		}
+	}
+	bool ok = fscreen != NULL;
+	pthread_mutex_unlock(&init_lock);
+	return ok;
+}
+
+struct pipe_screen *
+sweetgl_screen(void)
+{
+	return fscreen ? fscreen->screen : NULL;
+}
+
+struct sweetgl_ctx *
+sweetgl_create(int api, struct sweetgl_ctx *share)
+{
+	if (!sweetgl_init()) {
+		return NULL;
+	}
+	struct st_context_attribs attribs = {
+		.profile = API_OPENGLES2,
+		.major = api >= 3 ? 3 : 2,
+		.minor = api >= 3 ? 1 : 0,      /* 3.1: glGetTexLevelParameteriv (eagl.c rect textures) */
+	};
+	enum st_context_error err = ST_CONTEXT_SUCCESS;
+	struct st_context *st = st_api_create_context(fscreen, &attribs, &err, share ? share->st : NULL);
+	if (st == NULL) {
+		sweet_drm_log("sweetgl: GLES %d context failed: %d", attribs.major, err);
+		return NULL;
+	}
+	struct sweetgl_ctx *c = calloc(1, sizeof(*c));
+	c->st = st;
+	c->api = attribs.major;
+	st->frontend_context = c;
+	return c;
+}
+
+bool
+sweetgl_make_current(struct sweetgl_ctx *c)
+{
+	return st_api_make_current(c ? c->st : NULL, NULL, NULL);
+}
+
+void
+sweetgl_destroy(struct sweetgl_ctx *c)
+{
+	if (c == NULL) {
+		return;
+	}
+	if (st_api_get_current() == c->st) {
+		st_api_make_current(NULL, NULL, NULL);
+	}
+	st_destroy_context(c->st);
+	free(c);
+}
+
+static double
+ms_since(uint64_t t0)
+{
+	mach_timebase_info_data_t tb;
+	mach_timebase_info(&tb);
+	return (double)(mach_absolute_time() - t0) * tb.numer / tb.denom / 1e6;
+}
+
+static GLuint
+shader(GLenum type, const char *src)
+{
+	GLuint s = glCreateShader(type);
+	glShaderSource(s, 1, &src, NULL);
+	glCompileShader(s);
+	GLint ok = 0;
+	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[256] = "";
+		glGetShaderInfoLog(s, sizeof(log), NULL, log);
+		sweet_drm_log("sweetgl: shader compile failed: %s", log);
+	}
+	return s;
+}
+
+/*
+ * 256x256 RGBA8 FBO: clear to blue, a red triangle over the lower-left half
+ * (vertices (-1,-1) (1,-1) (-1,1)), read back: pixel (32, 32) must be red,
+ * (224, 224) blue. Returns true if both are.
+ */
+bool
+sweetgl_selftest(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	struct sweetgl_ctx *c = sweetgl_create(3, NULL);
+	if (c == NULL || !sweetgl_make_current(c)) {
+		sweet_drm_log("sweetgl: selftest: no context");
+		return false;
+	}
+	double t_ctx = ms_since(t0);
+	sweet_drm_log("sweetgl: GL_VERSION %s / GL_RENDERER %s / GLSL %s", glGetString(GL_VERSION),
+	    glGetString(GL_RENDERER), glGetString(GL_SHADING_LANGUAGE_VERSION));
+
+	GLuint tex, fbo;
+	glGenTextures(1, &tex);
+	glBindTexture(GL_TEXTURE_2D, tex);
+	glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 256, 256);
+	glGenFramebuffers(1, &fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+	GLenum fbs = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+
+	GLuint prog = glCreateProgram();
+	glAttachShader(prog, shader(GL_VERTEX_SHADER,
+	    "#version 300 es\nlayout(location = 0) in vec2 p;\nvoid main() { gl_Position = vec4(p, 0.0, 1.0); }\n"));
+	glAttachShader(prog, shader(GL_FRAGMENT_SHADER,
+	    "#version 300 es\nprecision mediump float;\nout vec4 c;\nvoid main() { c = vec4(1.0, 0.0, 0.0, 1.0); }\n"));
+	glLinkProgram(prog);
+	GLint linked = 0;
+	glGetProgramiv(prog, GL_LINK_STATUS, &linked);
+	glUseProgram(prog);
+
+	static const float tri[] = {-1, -1, 1, -1, -1, 1};
+	GLuint vbo;
+	glGenBuffers(1, &vbo);
+	glBindBuffer(GL_ARRAY_BUFFER, vbo);
+	glBufferData(GL_ARRAY_BUFFER, sizeof(tri), tri, GL_STATIC_DRAW);
+	glEnableVertexAttribArray(0);
+	glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+
+	uint64_t t1 = mach_absolute_time();
+	glViewport(0, 0, 256, 256);
+	glClearColor(0, 0, 1, 1);
+	glClear(GL_COLOR_BUFFER_BIT);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	static uint8_t px[256 * 256 * 4];
+	glReadPixels(0, 0, 256, 256, GL_RGBA, GL_UNSIGNED_BYTE, px);
+	double t_draw = ms_since(t1);
+	GLenum err = glGetError();
+
+	const uint8_t *a = &px[(32 * 256 + 32) * 4], *b = &px[(224 * 256 + 224) * 4];
+	bool ok = fbs == GL_FRAMEBUFFER_COMPLETE && linked && err == GL_NO_ERROR &&
+	    a[0] == 255 && a[1] == 0 && a[2] == 0 && a[3] == 255 &&
+	    b[0] == 0 && b[1] == 0 && b[2] == 255 && b[3] == 255;
+	sweet_drm_log("sweetgl: selftest fbo %x linked %d err %x px(32,32) %02x%02x%02x%02x px(224,224) %02x%02x%02x%02x "
+	    "context %.1f ms draw+readback %.2f ms -> %s",
+	    fbs, linked, err, a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3], t_ctx, t_draw,
+	    ok ? "MESA GLES ON THE ADRENO WORKS" : "WRONG");
+
+	/* second frame timing, without compile and allocation */
+	uint64_t t2 = mach_absolute_time();
+	glClear(GL_COLOR_BUFFER_BIT);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	glFinish();
+	sweet_drm_log("sweetgl: second frame clear+draw+finish %.2f ms", ms_since(t2));
+
+	sweetgl_make_current(NULL);
+	sweetgl_destroy(c);
+	return ok;
+}
+
+static void *
+selftest_thread(void *arg)
+{
+	(void)arg;
+	/* the GPU service comes up during boot: retry for 2 minutes */
+	for (int i = 0; i < 120 && !sweetgl_init(); i++) {
+		sleep(1);
+	}
+	if (!sweetgl_init()) {
+		sweet_drm_log("sweetgl: selftest: no GPU after 2 minutes");
+		return NULL;
+	}
+	sweetgl_selftest();
+	return NULL;
+}
+
+void sweetgl_layerdump_start(void);
+void sweetgl_vibrant_fill_install(void);
+
+__attribute__((constructor)) static void
+sweetgl_load(void)
+{
+	if (strcmp(getprogname(), "SpringBoard") == 0) {
+		sweetgl_vibrant_fill_install();
+		const char *d = getenv("SWEETGL_LAYERDUMP");
+		if (d && d[0] == '1') {
+			sweetgl_layerdump_start();
+		}
+		return;
+	}
+	sweetgl_eagl_install();
+	const char *t = getenv("SWEETGL_TEST");
+	if (t && t[0] == '1') {
+		pthread_t th;
+		pthread_create(&th, NULL, selftest_thread, NULL);
+		pthread_detach(th);
+	}
+}
