diff --git a/src/gallium/drivers/freedreno/river_gallium_test.c b/src/gallium/drivers/freedreno/river_gallium_test.c
new file mode 100644
index 0000000..2405b74
--- /dev/null
+++ b/src/gallium/drivers/freedreno/river_gallium_test.c
@@ -0,0 +1,166 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * river_gallium_test: first end-to-end check of Mesa freedreno on the river
+ * XNU port (Adreno 506 behind the RiverGPU IOKit service). Creates the
+ * freedreno screen through the river backend, clears a render target with
+ * the GPU (util_blitter: ir3-compiled shaders, a real draw), reads it back
+ * and checks the pixels. Runs as PID 1 (riverinit=), so it logs to the
+ * console and through RiverGPU's LOG selector, and never exits.
+ */
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <mach/mach_time.h>
+#include <IOKit/IOKitLib.h>
+
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "compiler/glsl_types.h"
+#include "util/driconf.h"
+#include "util/u_inlines.h"
+
+#include "freedreno_screen.h"
+
+static const driOptionDescription fd_driconf[] = {
+#include "driinfo_freedreno.h"
+};
+
+static io_connect_t log_conn;
+
+static void
+say(const char *fmt, ...)
+{
+   char line[512];
+   va_list ap;
+   va_start(ap, fmt);
+   int n = vsnprintf(line, sizeof(line), fmt, ap);
+   va_end(ap);
+   printf("river-gallium-test: %s\n", line);
+   if (log_conn && n > 0)
+      IOConnectCallMethod(log_conn, 6, NULL, 0, line,
+                          (size_t)(n < (int)sizeof(line) ? n : (int)sizeof(line) - 1),
+                          NULL, NULL, NULL, NULL);
+}
+
+static double
+ms_since(uint64_t t0)
+{
+   mach_timebase_info_data_t tb;
+   mach_timebase_info(&tb);
+   return (double)(mach_absolute_time() - t0) * tb.numer / tb.denom / 1e6;
+}
+
+static void
+run(void)
+{
+   driOptionCache info = {0}, cache = {0};
+   driParseOptionInfo(&info, fd_driconf, ARRAY_SIZE(fd_driconf));
+   struct pipe_screen_config config = { .options = &cache, .options_info = &info };
+
+   int fd = open("/dev/null", O_RDWR);
+   uint64_t t0 = mach_absolute_time();
+   struct pipe_screen *screen = fd_screen_create(fd, &config, NULL);
+   if (!screen) {
+      say("fd_screen_create failed");
+      return;
+   }
+   say("screen \"%s\" by \"%s\" created in %.1f ms", screen->get_name(screen),
+       screen->get_vendor(screen), ms_since(t0));
+
+   say("context_create begin");
+   struct pipe_context *ctx = screen->context_create(screen, NULL, 0);
+   if (!ctx) {
+      say("context_create failed");
+      return;
+   }
+   say("context_create complete");
+
+   const unsigned W = 64, H = 64;
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+      .width0 = W, .height0 = H, .depth0 = 1, .array_size = 1,
+      .bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW,
+   };
+   struct pipe_resource *rt = screen->resource_create(screen, &templ);
+   if (!rt) {
+      say("resource_create failed");
+      return;
+   }
+
+   struct pipe_surface surf = {
+      .format = templ.format,
+      .texture = rt,
+   };
+   union pipe_color_union color = { .f = { 0.0f, 0.5f, 1.0f, 1.0f } };
+
+   t0 = mach_absolute_time();
+   ctx->clear_render_target(ctx, &surf, &color, 0, 0, W, H, false);
+   struct pipe_fence_handle *fence = NULL;
+   ctx->flush(ctx, &fence, 0);
+   bool done = screen->fence_finish(screen, ctx, fence, OS_TIMEOUT_INFINITE);
+   screen->fence_reference(screen, &fence, NULL);
+   double ms = ms_since(t0);
+
+   struct pipe_box box = { .width = W, .height = H, .depth = 1 };
+   struct pipe_transfer *xfer = NULL;
+   const uint8_t *px = ctx->texture_map(ctx, rt, 0, PIPE_MAP_READ, &box, &xfer);
+   if (!px) {
+      say("texture_map failed");
+      return;
+   }
+   unsigned good = 0;
+   uint32_t first = 0;
+   for (unsigned y = 0; y < H; y++) {
+      const uint8_t *row = px + y * xfer->stride;
+      for (unsigned x = 0; x < W; x++) {
+         const uint8_t *p = row + x * 4;
+         if (x == 0 && y == 0)
+            first = p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+         if (p[0] == 0x00 && (p[1] == 0x7f || p[1] == 0x80) && p[2] == 0xff && p[3] == 0xff)
+            good++;
+      }
+   }
+   ctx->texture_unmap(ctx, xfer);
+   say("GPU clear of %ux%u RGBA8 (0, 0.5, 1, 1): fence %s in %.2f ms, %u/%u pixels right, pixel 0 = %08x",
+       W, H, done ? "signalled" : "NOT signalled", ms, good, W * H, first);
+
+   pipe_resource_reference(&rt, NULL);
+   ctx->destroy(ctx);
+   screen->destroy(screen);
+   say("done");
+}
+
+int
+main(void)
+{
+   int fd = open("/dev/console", O_RDWR);
+   if (fd >= 0) {
+      dup2(fd, 1);
+      dup2(fd, 2);
+   }
+   setvbuf(stdout, NULL, _IONBF, 0);
+
+   io_service_t svc = 0;
+   for (int i = 0; i < 60 && !svc; i++) {
+      svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("RiverGPU"));
+      if (!svc)
+         sleep(1);
+   }
+   if (svc && IOServiceOpen(svc, mach_task_self(), 0, &log_conn))
+      log_conn = 0;
+   say("PID %d, RiverGPU %s", getpid(), svc ? "found" : "NOT found");
+   if (svc) {
+      glsl_type_singleton_init_or_ref();
+      say("GLSL type cache initialized");
+      run();
+      glsl_type_singleton_decref();
+   }
+
+   for (;;)
+      sleep(3600);
+}
diff --git a/src/gallium/drivers/freedreno/river_gl_runtime.c b/src/gallium/drivers/freedreno/river_gl_runtime.c
new file mode 100644
index 0000000..e99e114
--- /dev/null
+++ b/src/gallium/drivers/freedreno/river_gl_runtime.c
@@ -0,0 +1,120 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Minimal surfaceless Mesa GLES frontend for RiverGPU, used by the PID 1
+ * GLES test and by the EAGL adapter in backboardd. All contexts of a
+ * process share one freedreno screen (one RiverGPU connection); a context
+ * may share objects with another (EAGL sharegroups).
+ */
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "frontend/api.h"
+#include "state_tracker/st_context.h"
+#include "util/driconf.h"
+#include "freedreno_screen.h"
+#include "river_gl_runtime.h"
+
+static const driOptionDescription fd_driconf[] = {
+#include "driinfo_freedreno.h"
+};
+
+struct river_gl_context {
+   struct st_context *state_tracker;
+};
+
+static int
+frontend_get_param(struct pipe_frontend_screen *frontend,
+                   enum st_manager_param param)
+{
+   (void)frontend;
+   (void)param;
+   return 0;
+}
+
+static pthread_mutex_t screen_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct pipe_screen *screen;
+static struct pipe_frontend_screen frontend;
+static driOptionCache option_info, option_cache;
+
+/* The process-wide screen, created on first use and kept for the process. */
+static struct pipe_frontend_screen *
+get_frontend(void)
+{
+   pthread_mutex_lock(&screen_lock);
+   if (!screen) {
+      driParseOptionInfo(&option_info, fd_driconf, ARRAY_SIZE(fd_driconf));
+      struct pipe_screen_config config = {
+         .options = &option_cache,
+         .options_info = &option_info,
+      };
+      int fd = open("/dev/null", O_RDWR);
+      if (fd >= 0) {
+         screen = fd_screen_create(fd, &config, NULL);
+         if (!screen)
+            close(fd);
+      }
+      if (screen) {
+         frontend.screen = screen;
+         frontend.get_param = frontend_get_param;
+      }
+   }
+   pthread_mutex_unlock(&screen_lock);
+   return screen ? &frontend : NULL;
+}
+
+struct river_gl_context *
+river_gl_create_shared_context(unsigned major, unsigned minor,
+                               struct river_gl_context *share)
+{
+   struct pipe_frontend_screen *fe = get_frontend();
+   if (!fe)
+      return NULL;
+   struct river_gl_context *context = calloc(1, sizeof(*context));
+   if (!context)
+      return NULL;
+
+   struct st_context_attribs attribs = {
+      .profile = API_OPENGLES2,
+      .major = major,
+      .minor = minor,
+   };
+   enum st_context_error error = ST_CONTEXT_SUCCESS;
+   pthread_mutex_lock(&screen_lock);
+   context->state_tracker =
+      st_api_create_context(fe, &attribs, &error,
+                            share ? share->state_tracker : NULL);
+   pthread_mutex_unlock(&screen_lock);
+   if (!context->state_tracker) {
+      free(context);
+      return NULL;
+   }
+   return context;
+}
+
+struct river_gl_context *
+river_gl_create_context(unsigned major, unsigned minor)
+{
+   return river_gl_create_shared_context(major, minor, NULL);
+}
+
+bool
+river_gl_make_current(struct river_gl_context *context)
+{
+   return st_api_make_current(context ? context->state_tracker : NULL,
+                              NULL, NULL);
+}
+
+void
+river_gl_destroy_context(struct river_gl_context *context)
+{
+   if (!context)
+      return;
+   st_api_make_current(context->state_tracker, NULL, NULL);
+   st_destroy_context(context->state_tracker);
+   st_api_make_current(NULL, NULL, NULL);
+   free(context);
+}
