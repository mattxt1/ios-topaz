diff --git a/include/river-libdrm/xf86drm.h b/include/river-libdrm/xf86drm.h
new file mode 100644
index 0000000..926bd39
--- /dev/null
+++ b/include/river-libdrm/xf86drm.h
@@ -0,0 +1,69 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Minimal libdrm stand-in for freedreno on the river XNU port (iOS), where
+ * there is no DRM: the GPU is reached through the RiverGPU IOKit service
+ * (src/freedreno/drm/river). drmGetVersion() names the device "river" so
+ * fd_device_new() picks that backend; buffer sharing (GEM names, PRIME)
+ * and sync objects are not available and fail with -ENOSYS.
+ */
+#ifndef RIVER_XF86DRM_H
+#define RIVER_XF86DRM_H
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "drm-uapi/drm.h"
+
+#define DRM_NODE_PRIMARY 0
+#define DRM_NODE_CONTROL 1
+#define DRM_NODE_RENDER  2
+
+typedef struct _drmVersion {
+   int version_major;
+   int version_minor;
+   int version_patchlevel;
+   int name_len;
+   char *name;
+   int date_len;
+   char *date;
+   int desc_len;
+   char *desc;
+} drmVersion, *drmVersionPtr;
+
+static inline drmVersionPtr
+drmGetVersion(int fd)
+{
+   drmVersionPtr v = (drmVersionPtr)calloc(1, sizeof(*v));
+   if (!v)
+      return NULL;
+   v->version_major = 1;
+   v->name = strdup("river");
+   v->name_len = 5;
+   return v;
+}
+
+static inline void
+drmFreeVersion(drmVersionPtr v)
+{
+   if (v) {
+      free(v->name);
+      free(v);
+   }
+}
+
+static inline int drmIoctl(int fd, unsigned long request, void *arg) { errno = ENOSYS; return -1; }
+static inline int drmOpenWithType(const char *name, const char *busid, int type) { return -ENOSYS; }
+static inline int drmGetCap(int fd, uint64_t capability, uint64_t *value) { return -ENOSYS; }
+static inline int drmPrimeFDToHandle(int fd, int prime_fd, uint32_t *handle) { return -ENOSYS; }
+static inline int drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *prime_fd) { return -ENOSYS; }
+static inline int drmSyncobjDestroy(int fd, uint32_t handle) { return -ENOSYS; }
+static inline int drmSyncobjFDToHandle(int fd, int obj_fd, uint32_t *handle) { return -ENOSYS; }
+static inline int drmSyncobjExportSyncFile(int fd, uint32_t handle, int *sync_file_fd) { return -ENOSYS; }
+static inline int drmSyncobjImportSyncFile(int fd, uint32_t handle, int sync_file_fd) { return -ENOSYS; }
+static inline int drmSyncobjReset(int fd, const uint32_t *handles, uint32_t handle_count) { return -ENOSYS; }
+
+#endif /* RIVER_XF86DRM_H */
