diff --git a/src/freedreno/drm/river/river_bo.c b/src/freedreno/drm/river/river_bo.c
new file mode 100644
index 0000000..bd0eaa8
--- /dev/null
+++ b/src/freedreno/drm/river/river_bo.c
@@ -0,0 +1,144 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Buffers are cached in the CPU and not coherent with the GPU; the kernel
+ * cleans every buffer named in a submit and RIVER_CPU_PREP waits for the
+ * buffer's last fence and invalidates it before the CPU reads.
+ */
+#include "river_priv.h"
+
+static int
+river_bo_offset(struct fd_bo *bo, uint64_t *offset)
+{
+   /* mapped by IOConnectMapMemory64(type = handle), not by mmap offset */
+   *offset = 0;
+   return 0;
+}
+
+static void *
+river_bo_map(struct fd_bo *bo)
+{
+   mach_vm_address_t addr = 0;
+   mach_vm_size_t size = 0;
+   kern_return_t kr = IOConnectMapMemory64(river_conn(bo->dev), bo->handle,
+                                           mach_task_self(), &addr, &size,
+                                           kIOMapAnywhere);
+   if (kr) {
+      ERROR_MSG("map of bo %u failed: %#x", bo->handle, kr);
+      return NULL;
+   }
+   return (void *)(uintptr_t)addr;
+}
+
+static int
+river_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
+{
+   uint64_t in[2] = { bo->handle, (op & FD_BO_PREP_NOSYNC) ? 0 : 10000 };
+   kern_return_t kr = IOConnectCallScalarMethod(river_conn(bo->dev),
+                                                RIVER_CPU_PREP, in, 2, NULL, NULL);
+   if (kr == kIOReturnTimeout)
+      return -EBUSY;
+   return kr ? -EINVAL : 0;
+}
+
+static int
+river_bo_madvise(struct fd_bo *bo, int willneed)
+{
+   return willneed;
+}
+
+static uint64_t
+river_bo_iova(struct fd_bo *bo)
+{
+   return to_river_bo(bo)->gpuva;
+}
+
+static void
+river_bo_set_name(struct fd_bo *bo, const char *fmt, va_list ap)
+{
+}
+
+static const struct fd_bo_funcs funcs = {
+   .offset = river_bo_offset,
+   .map = river_bo_map,
+   .cpu_prep = river_bo_cpu_prep,
+   .madvise = river_bo_madvise,
+   .iova = river_bo_iova,
+   .set_name = river_bo_set_name,
+   .destroy = fd_bo_fini_common,
+};
+
+struct fd_bo *
+river_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags)
+{
+   uint64_t in = size, out[3];
+   uint32_t n = 3;
+   kern_return_t kr = IOConnectCallScalarMethod(river_conn(dev), RIVER_BO_NEW,
+                                                &in, 1, out, &n);
+   if (kr || n < 3) {
+      ERROR_MSG("bo_new(%u) failed: %#x", size, kr);
+      return NULL;
+   }
+
+   struct river_bo *river_bo = calloc(1, sizeof(*river_bo));
+   if (!river_bo) {
+      uint64_t handle = out[0];
+      IOConnectCallScalarMethod(river_conn(dev), RIVER_BO_FREE, &handle, 1,
+                                NULL, NULL);
+      return NULL;
+   }
+
+   struct fd_bo *bo = &river_bo->base;
+   river_bo->gpuva = out[1];
+   bo->size = size;
+   bo->handle = (uint32_t)out[0];
+   bo->funcs = &funcs;
+
+   fd_bo_init_common(bo, dev);
+
+   return bo;
+}
+
+struct fd_bo *
+river_bo_from_handle(struct fd_device *dev, uint32_t size, uint32_t handle)
+{
+   uint64_t in = handle, out[2];
+   uint32_t n = 2;
+   kern_return_t kr = IOConnectCallScalarMethod(river_conn(dev), RIVER_BO_INFO,
+                                                &in, 1, out, &n);
+   if (kr || n < 2) {
+      ERROR_MSG("bo_info(%u) failed: %#x", handle, kr);
+      return NULL;
+   }
+
+   struct river_bo *river_bo = calloc(1, sizeof(*river_bo));
+   if (!river_bo)
+      return NULL;
+
+   struct fd_bo *bo = &river_bo->base;
+   river_bo->gpuva = out[0];
+   bo->size = size ? size : (uint32_t)out[1];
+   bo->handle = handle;
+   bo->funcs = &funcs;
+
+   fd_bo_init_common(bo, dev);
+
+   return bo;
+}
+
+int
+river_device_import_surface(struct fd_device *dev, uint32_t surface_id,
+                            uint32_t *handle, uint64_t *size, uint32_t *offset)
+{
+   uint64_t in = surface_id, out[4];
+   uint32_t n = 4;
+   kern_return_t kr = IOConnectCallScalarMethod(river_conn(dev), RIVER_BO_IMPORT,
+                                                &in, 1, out, &n);
+   if (kr || n < 4)
+      return kr == kIOReturnNotFound ? -ENOENT : -ENOMEM;
+   *handle = (uint32_t)out[0];
+   *size = out[2];
+   *offset = (uint32_t)out[3];
+   return 0;
+}
diff --git a/src/freedreno/drm/river/river_device.c b/src/freedreno/drm/river/river_device.c
new file mode 100644
index 0000000..34757dc
--- /dev/null
+++ b/src/freedreno/drm/river/river_device.c
@@ -0,0 +1,73 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ */
+#include "river_priv.h"
+
+static void
+river_device_destroy(struct fd_device *dev)
+{
+   struct river_device *river_dev = to_river_device(dev);
+   if (river_dev->conn)
+      IOServiceClose(river_dev->conn);
+}
+
+static void
+river_bo_close_handle(struct fd_bo *bo)
+{
+   uint64_t handle = bo->handle;
+   IOConnectCallScalarMethod(river_conn(bo->dev), RIVER_BO_FREE, &handle, 1,
+                             NULL, NULL);
+}
+
+static const struct fd_device_funcs funcs = {
+   .bo_new = river_bo_new,
+   .bo_from_handle = river_bo_from_handle,
+   .bo_close_handle = river_bo_close_handle,
+   .pipe_new = river_pipe_new,
+   .destroy = river_device_destroy,
+};
+
+int
+river_get_param(struct fd_device *dev, enum river_param p, uint64_t *value)
+{
+   uint64_t in = p;
+   uint32_t n = 1;
+   kern_return_t kr = IOConnectCallScalarMethod(river_conn(dev), RIVER_GET_PARAM,
+                                                &in, 1, value, &n);
+   return kr ? -EINVAL : 0;
+}
+
+struct fd_device *
+river_device_new(int fd, drmVersionPtr version)
+{
+   io_service_t svc =
+      IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("RiverGPU"));
+   if (!svc) {
+      ERROR_MSG("no RiverGPU service");
+      return NULL;
+   }
+
+   io_connect_t conn = 0;
+   kern_return_t kr = IOServiceOpen(svc, mach_task_self(), 0, &conn);
+   IOObjectRelease(svc);
+   if (kr) {
+      ERROR_MSG("RiverGPU open failed: %#x", kr);
+      return NULL;
+   }
+
+   struct river_device *river_dev = calloc(1, sizeof(*river_dev));
+   if (!river_dev) {
+      IOServiceClose(conn);
+      return NULL;
+   }
+
+   struct fd_device *dev = &river_dev->base;
+   river_dev->conn = conn;
+   dev->funcs = &funcs;
+   /* softpin-era msm: fixed GPU addresses, submit queues not needed */
+   dev->version = FD_VERSION_SOFTPIN;
+   dev->bo_size = sizeof(struct river_bo);
+
+   return dev;
+}
diff --git a/src/freedreno/drm/river/river_pipe.c b/src/freedreno/drm/river/river_pipe.c
new file mode 100644
index 0000000..001b1a0
--- /dev/null
+++ b/src/freedreno/drm/river/river_pipe.c
@@ -0,0 +1,126 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ */
+#include "freedreno_ringbuffer_sp.h"
+#include "river_priv.h"
+
+static int
+river_pipe_get_param(struct fd_pipe *pipe, enum fd_param_id param,
+                     uint64_t *value)
+{
+   struct river_pipe *river_pipe = to_river_pipe(pipe);
+
+   switch (param) {
+   case FD_DEVICE_ID:
+   case FD_GPU_ID:
+      *value = river_pipe->gpu_id;
+      return 0;
+   case FD_GMEM_SIZE:
+      *value = river_pipe->gmem;
+      return 0;
+   case FD_GMEM_BASE:
+      *value = river_pipe->gmem_base;
+      return 0;
+   case FD_CHIP_ID:
+      *value = river_pipe->chip_id;
+      return 0;
+   case FD_MAX_FREQ:
+      *value = 133333333; /* GFX3D RCG as set by the kernel today */
+      return 0;
+   case FD_NR_PRIORITIES:
+      *value = 1;
+      return 0;
+   case FD_CTX_FAULTS:
+   case FD_GLOBAL_FAULTS:
+   case FD_SUSPEND_COUNT:
+      *value = 0;
+      return 0;
+   case FD_VA_SIZE:
+      *value = river_pipe->va_size;
+      return 0;
+   default:
+      ERROR_MSG("unsupported param id: %d", param);
+      return -1;
+   }
+}
+
+static int
+river_pipe_set_param(struct fd_pipe *pipe, enum fd_param_id param, uint64_t value)
+{
+   return -1;
+}
+
+static int
+river_pipe_wait(struct fd_pipe *pipe, const struct fd_fence *fence, uint64_t timeout)
+{
+   /* timeout is in ns; the kernel takes ms */
+   uint64_t ms = timeout == OS_TIMEOUT_INFINITE ? 0xffffffffull
+                                                : MAX2(timeout / 1000000, 1);
+   uint64_t in[2] = { fence->kfence, MIN2(ms, 0xffffffffull) };
+   kern_return_t kr = IOConnectCallScalarMethod(river_conn(pipe->dev), RIVER_WAIT,
+                                                in, 2, NULL, NULL);
+   if (kr == kIOReturnTimeout)
+      return -ETIMEDOUT;
+   if (kr) {
+      ERROR_MSG("wait-fence %u failed: %#x", fence->kfence, kr);
+      return -EINVAL;
+   }
+   return 0;
+}
+
+static void
+river_pipe_destroy(struct fd_pipe *pipe)
+{
+   fd_pipe_sp_ringpool_fini(pipe);
+   free(to_river_pipe(pipe));
+}
+
+static const struct fd_pipe_funcs sp_funcs = {
+   .ringbuffer_new_object = fd_ringbuffer_sp_new_object,
+   .submit_new = river_submit_sp_new,
+   .flush = fd_pipe_sp_flush,
+   .get_param = river_pipe_get_param,
+   .set_param = river_pipe_set_param,
+   .wait = river_pipe_wait,
+   .destroy = river_pipe_destroy,
+};
+
+struct fd_pipe *
+river_pipe_new(struct fd_device *dev, enum fd_pipe_id id, uint32_t prio)
+{
+   if (id != FD_PIPE_3D)
+      return NULL;
+
+   struct river_pipe *river_pipe = calloc(1, sizeof(*river_pipe));
+   if (!river_pipe)
+      return NULL;
+
+   struct fd_pipe *pipe = &river_pipe->base;
+   pipe->funcs = &sp_funcs;
+   pipe->dev = dev;
+
+   uint64_t v;
+   if (!river_get_param(dev, RIVER_PARAM_GPU_ID, &v))
+      river_pipe->gpu_id = v;
+   if (!river_get_param(dev, RIVER_PARAM_CHIP_ID, &v))
+      river_pipe->chip_id = v;
+   if (!river_get_param(dev, RIVER_PARAM_GMEM_SIZE, &v))
+      river_pipe->gmem = v;
+   if (!river_get_param(dev, RIVER_PARAM_GMEM_BASE, &v))
+      river_pipe->gmem_base = v;
+   (void)river_get_param(dev, RIVER_PARAM_VA_START, &river_pipe->va_start);
+   (void)river_get_param(dev, RIVER_PARAM_VA_SIZE, &river_pipe->va_size);
+
+   if (!(river_pipe->gpu_id || river_pipe->chip_id)) {
+      free(river_pipe);
+      return NULL;
+   }
+
+   INFO_MSG("RiverGPU pipe: GPU-id %d, chip-id 0x%016" PRIx64 ", GMEM 0x%08x",
+            river_pipe->gpu_id, river_pipe->chip_id, river_pipe->gmem);
+
+   fd_pipe_sp_ringpool_init(pipe);
+
+   return pipe;
+}
diff --git a/src/freedreno/drm/river/river_priv.h b/src/freedreno/drm/river/river_priv.h
new file mode 100644
index 0000000..29f7e62
--- /dev/null
+++ b/src/freedreno/drm/river/river_priv.h
@@ -0,0 +1,93 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * freedreno backend for the RiverGPU IOKit service of the river (Moto G7,
+ * SDM632, Adreno 506) XNU port. The kernel side is iokit/Kernel/arm/RiverGPU.cpp
+ * + bsd/dev/river_gpu.c in https://github.com/mattxt1/ios-topaz (river-bringup):
+ * msm-style GEM buffers with a fixed GPU address (softpin), indirect-buffer
+ * submission with a fence, fence wait and CPU prep, behind an IOKit
+ * connection instead of DRM ioctls.
+ */
+#ifndef RIVER_PRIV_H_
+#define RIVER_PRIV_H_
+
+#include <IOKit/IOKitLib.h>
+
+#include "freedreno_drmif.h"
+#include "freedreno_priv.h"
+
+/* RiverGPUUserClient selectors */
+enum river_sel {
+   RIVER_GET_PARAM = 0,
+   RIVER_BO_NEW = 1,
+   RIVER_BO_FREE = 2,
+   RIVER_SUBMIT = 3,
+   RIVER_WAIT = 4,
+   RIVER_CPU_PREP = 5,
+   RIVER_LOG = 6,
+   RIVER_BO_IMPORT = 7,
+   RIVER_BO_INFO = 8,
+};
+
+/* RIVER_GET_PARAM */
+enum river_param {
+   RIVER_PARAM_CHIP_ID = 0,
+   RIVER_PARAM_GPU_ID = 1,
+   RIVER_PARAM_GMEM_SIZE = 2,
+   RIVER_PARAM_GMEM_BASE = 3,
+   RIVER_PARAM_VA_START = 4,
+   RIVER_PARAM_VA_SIZE = 5,
+   RIVER_PARAM_FENCE = 6,
+};
+
+/* RIVER_SUBMIT limits (bsd/dev/river_gpu.c) */
+#define RIVER_MAX_CMDS 64
+
+struct river_device {
+   struct fd_device base;
+   io_connect_t conn;
+};
+FD_DEFINE_CAST(fd_device, river_device);
+
+struct fd_device *river_device_new(int fd, drmVersionPtr version);
+
+struct river_pipe {
+   struct fd_pipe base;
+   uint32_t gpu_id;
+   uint64_t chip_id;
+   uint64_t gmem_base;
+   uint32_t gmem;
+   uint64_t va_start, va_size;
+};
+FD_DEFINE_CAST(fd_pipe, river_pipe);
+
+struct fd_pipe *river_pipe_new(struct fd_device *dev, enum fd_pipe_id id,
+                               uint32_t prio);
+struct fd_submit *river_submit_sp_new(struct fd_pipe *pipe);
+
+struct river_bo {
+   struct fd_bo base;
+   uint64_t gpuva;
+};
+FD_DEFINE_CAST(fd_bo, river_bo);
+
+struct fd_bo *river_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags);
+struct fd_bo *river_bo_from_handle(struct fd_device *dev, uint32_t size,
+                                   uint32_t handle);
+
+/* An IOSurface's pages as a buffer handle of dev (kernel BO_IMPORT); offset
+ * is where the pixels start in the first page. 0 or -errno. */
+int river_device_import_surface(struct fd_device *dev, uint32_t surface_id,
+                                uint32_t *handle, uint64_t *size,
+                                uint32_t *offset);
+
+static inline io_connect_t
+river_conn(struct fd_device *dev)
+{
+   return to_river_device(dev)->conn;
+}
+
+int river_get_param(struct fd_device *dev, enum river_param p, uint64_t *value);
+
+#endif /* RIVER_PRIV_H_ */
diff --git a/src/freedreno/drm/river/river_ringbuffer_sp.c b/src/freedreno/drm/river/river_ringbuffer_sp.c
new file mode 100644
index 0000000..1421b38
--- /dev/null
+++ b/src/freedreno/drm/river/river_ringbuffer_sp.c
@@ -0,0 +1,93 @@
+/*
+ * Copyright © 2026 river bring-up contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Softpin submit for RiverGPU, after msm_ringbuffer_sp.c: merge deferred
+ * submits, then one RIVER_SUBMIT with { ncmd, nbos, cmds[], handles[] }.
+ */
+#include <assert.h>
+
+#include "drm/freedreno_ringbuffer_sp.h"
+#include "river_priv.h"
+
+static int
+flush_submit_list(struct list_head *submit_list)
+{
+   struct fd_submit_sp *fd_submit = to_fd_submit_sp(last_submit(submit_list));
+   struct fd_pipe *pipe = fd_submit->base.pipe;
+   unsigned nr_cmds = 0;
+
+   MESA_TRACE_FUNC();
+
+   foreach_submit (submit, submit_list)
+      nr_cmds += to_fd_ringbuffer_sp(submit->primary)->u.nr_cmds;
+
+   if (nr_cmds > RIVER_MAX_CMDS) {
+      ERROR_MSG("submit with %u command buffers (max %u)", nr_cmds,
+                RIVER_MAX_CMDS);
+      return -EINVAL;
+   }
+
+   uint32_t cmds[RIVER_MAX_CMDS][3];
+   unsigned cmd_idx = 0;
+
+   foreach_submit_safe (submit, submit_list) {
+      struct fd_ringbuffer_sp *deferred_primary =
+         to_fd_ringbuffer_sp(submit->primary);
+
+      for (unsigned i = 0; i < deferred_primary->u.nr_cmds; i++) {
+         struct fd_bo *ring_bo = deferred_primary->u.cmds[i].ring_bo;
+         (void)fd_submit_append_bo(fd_submit, ring_bo);
+         cmds[cmd_idx][0] = ring_bo->handle;
+         cmds[cmd_idx][1] = submit_offset(ring_bo, deferred_primary->offset);
+         cmds[cmd_idx][2] = deferred_primary->u.cmds[i].size / 4;
+         cmd_idx++;
+      }
+
+      if (submit == last_submit(submit_list))
+         break;
+
+      struct fd_submit_sp *fd_deferred_submit = to_fd_submit_sp(submit);
+      for (unsigned i = 0; i < fd_deferred_submit->nr_bos; i++)
+         fd_submit_append_bo(fd_submit, fd_deferred_submit->bos[i]);
+
+      list_del(&submit->node);
+      fd_submit_del(submit);
+   }
+
+   size_t len = (2 + 3 * nr_cmds + fd_submit->nr_bos) * sizeof(uint32_t);
+   uint32_t *req = malloc(len);
+   if (!req)
+      return -ENOMEM;
+   req[0] = nr_cmds;
+   req[1] = fd_submit->nr_bos;
+   memcpy(&req[2], cmds, 3 * nr_cmds * sizeof(uint32_t));
+   for (unsigned i = 0; i < fd_submit->nr_bos; i++)
+      req[2 + 3 * nr_cmds + i] = fd_submit->bos[i]->handle;
+
+   uint64_t fence = 0;
+   uint32_t nout = 1;
+   kern_return_t kr = IOConnectCallMethod(river_conn(pipe->dev), RIVER_SUBMIT,
+                                          NULL, 0, req, len, &fence, &nout,
+                                          NULL, NULL);
+   free(req);
+
+   if (fd_submit->in_fence_fd != -1)
+      close(fd_submit->in_fence_fd);
+
+   if (kr) {
+      ERROR_MSG("submit failed: %#x (%u cmds, %u bos)", kr, nr_cmds,
+                fd_submit->nr_bos);
+      return -EINVAL;
+   }
+
+   fd_submit->out_fence->kfence = (uint32_t)fence;
+   fd_submit->out_fence->fence_fd = -1;
+   return 0;
+}
+
+struct fd_submit *
+river_submit_sp_new(struct fd_pipe *pipe)
+{
+   return fd_submit_sp_new(pipe, flush_submit_list);
+}
