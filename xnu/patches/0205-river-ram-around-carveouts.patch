+		if (chunk_end > real_avail_end) {
+			chunk_end = real_avail_end;
+		}
+		if (chunk_end > chunk) {
+			arm_vm_physmap_slide(temp_ptov_table, (chunk - gPhysBase + gVirtBase), chunk_end - chunk,
+			    AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT);
+		}
+		if (h < RIVER_PHYS_HOLES && river_phys_holes[h].end > chunk) {
+			chunk = river_phys_holes[h].end;
+		}
+	}
+#else
 	arm_vm_physmap_slide(temp_ptov_table, (args->topOfKernelData - gPhysBase + gVirtBase),
 	    real_avail_end - args->topOfKernelData, AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); // rest of physmem
+#endif
 
 	assert((temp_ptov_table[ptov_index - 1].va + temp_ptov_table[ptov_index - 1].len) <= physmap_end);
 
diff --git a/osfmk/arm64/river_phys.h b/osfmk/arm64/river_phys.h
new file mode 100644
index 0000000..934c39a
--- /dev/null
+++ b/osfmk/arm64/river_phys.h
@@ -0,0 +1,45 @@
+/*
+ * River (Moto G7) physical memory holes inside xnu's RAM range (0205).
+ *
+ * The ADT gives xnu one range, 0x18000000-0x100000000 (DRAM ends at 4 GiB;
+ * ABL's boot buffers end below 0x16000000). Firmware owns parts of it, from
+ * the live FDT's no-map reserved-memory nodes and River's own fixed GPU
+ * pages. These holes are never managed RAM: pa_valid() is false (so the pmap
+ * treats them as I/O, as before), pmap_is_bad_ram() keeps their vm_pages off
+ * the free lists, and the physmap leaves them unmapped so the CPU never even
+ * speculates into TrustZone-protected memory.
+ *
+ *   0x81800000-0x91400000  GPU zap shader 0x81800000, SMMU secure ptbl
+ *                          0x82000000, other/TZ 0x84300000, modem, ADSP,
+ *                          WCNSS (to 0x8ee00000), splash 0x90001000-0x91400000
+ *   0xeefa0000-0xef0c0000  mmi annotate, tzlog, wdog cpuctx, ramoops
+ */
+#ifndef _ARM64_RIVER_PHYS_H_
+#define _ARM64_RIVER_PHYS_H_
+
+#if defined(RIVER)
+#include <stdint.h>
+#include <stdbool.h>
+
+#define RIVER_PHYS_HOLES 2
+
+static const struct {
+	uint64_t start, end;
+} river_phys_holes[RIVER_PHYS_HOLES] = {
+	{ 0x81800000ULL, 0x91400000ULL },
+	{ 0xeefa0000ULL, 0xef0c0000ULL },
+};
+
+static inline bool
+river_phys_hole(uint64_t pa)
+{
+	for (int i = 0; i < RIVER_PHYS_HOLES; i++) {
+		if (pa >= river_phys_holes[i].start && pa < river_phys_holes[i].end) {
+			return true;
+		}
+	}
+	return false;
+}
+#endif /* RIVER */
+
+#endif /* _ARM64_RIVER_PHYS_H_ */
