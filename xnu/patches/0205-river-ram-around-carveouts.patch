@@ -2578,7 +2579,12 @@ static bool need_ram_ranges_init = true;
 bool
 pmap_is_bad_ram(__unused ppnum_t ppn)
 {
+#if defined(RIVER)
+	/* River's firmware holes: pmap_startup keeps them off the free lists (0205). */
