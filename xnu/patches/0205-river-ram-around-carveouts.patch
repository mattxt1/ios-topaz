@@ -38,6 +38,7 @@
 
 #include <kern/ledger.h>
 #include <mach/vm_types.h>
+#include <arm64/river_phys.h>
 #include <mach_assert.h>
 #include <vm/vm_page.h>
 
@@ -74,6 +75,12 @@ extern pmap_paddr_t vm_first_phys, vm_last_phys;
 static inline bool
 pa_valid(pmap_paddr_t pa)
 {
+#if defined(RIVER)
+	/* Firmware holes inside River's RAM range behave as I/O (0205). */
+	if (river_phys_hole(pa)) {
+		return false;
+	}
+#endif
 	return (pa >= vm_first_phys) && (pa < vm_last_phys);
 }
 
