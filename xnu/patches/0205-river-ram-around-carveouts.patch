+++ b/osfmk/arm64/arm_vm_init.c
@@ -51,6 +51,7 @@
 #include <libkern/section_keywords.h>
 
 #include <san/kasan.h>
+#include <arm64/river_phys.h>
 
 #if __ARM_KERNEL_PROTECT__
 /*
@@ -1600,8 +1601,30 @@ arm_vm_physmap_init(boot_args *args)
 	arm_vm_page_granular_RWNX(end_kern, phystokv(args->topOfKernelData) - end_kern,
 	    ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); /* Device Tree (if not locked down), RAM Disk (if present), bootArgs */
 
+#if defined(RIVER)
+	/*
+	 * Rest of physmem, one PTOV entry per stretch between River's firmware
+	 * holes (0205): the holes stay unmapped, so not even speculative
+	 * accesses reach TrustZone-protected memory.
+	 */
+	pmap_paddr_t chunk = args->topOfKernelData;
+	for (int h = 0; h <= RIVER_PHYS_HOLES; h++) {
