@@ -564,6 +567,22 @@ river_emmc_write_block(uint64_t lba, const void *src)
 			return EIO;
 		}
 		if ((status & (1U << 8)) && ((status >> 9) & 0xf) == 4) {
+			if (!write_verify) {
+				return 0;
