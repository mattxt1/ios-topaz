--- a/bsd/dev/river_emmc.c
+++ b/bsd/dev/river_emmc.c
@@ -160,6 +160,9 @@ extern bool river_irq_register(uint32_t intid, bool edge, void (*fn)(void *), vo
 static vm_offset_t hc, core, gcc;
 static bool ready;
 static bool write_enabled;
+static bool write_verify; /* boot-arg rivermmcwriteverify=1: CMD17 after every CMD24 */
+static uint64_t write_verify_count, write_verify_bad;
+static uint32_t write_verify_block[BLOCK / 4];
 static int userdata_minor;
