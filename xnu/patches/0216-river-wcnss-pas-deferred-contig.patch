From 137accc53fe88a572a41ace2af7720b71e01f47b Mon Sep 17 00:00:00 2001
From: mattxt1 <matttysonx1@gmail.com>
Date: Fri, 23 Oct 2026 23:34:51 -0400
Subject: [PATCH] RIVER: defer WCNSS PAS metadata until GPU SCM is ready

---
 bsd/dev/river_gpu.c  |  3 +++
 bsd/dev/sweet_keys.c | 59 ++++++++++++++++++++++++++++++++++++--------
 2 files changed, 52 insertions(+), 10 deletions(-)

diff --git a/bsd/dev/river_gpu.c b/bsd/dev/river_gpu.c
index 81d91e1..0aaf698 100644
--- a/bsd/dev/river_gpu.c
+++ b/bsd/dev/river_gpu.c
@@ -33,6 +33,8 @@ extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 extern void delay(int usec);
 extern bool river_irq_register(uint32_t intid, bool edge, void (*fn)(void *), void *arg);
+static bool rgpu_pas_ok;
+bool river_gpu_pas_ready(void) { return rgpu_pas_ok; }
 
 #define GPU_PA		0x01c00000
 #define GPU_SIZE	0x40000
@@ -1665,6 +1667,7 @@ river_gpu_cp_start(void)
 
 	/* a5xx_hw_init: with the zap shader loaded, the CP leaves secure mode. */
 	if (!zap_load(fw, fw_size)) return;
+	rgpu_pas_ok = true;
 	OUT(pkt7(CP_SET_SECURE_MODE, 1));
 	OUT(0);
 	if (!submit(buf, pa, "CP_SET_SECURE_MODE 0")) return;
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 2838f2f..a3e3293 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -12,10 +12,14 @@
 #include <pexpert/pexpert.h>
 #include <pexpert/device_tree.h>
 #include <vm/memory_types.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
 extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
 extern void sweet_hid_key(int, int);
 extern void sweet_hid_touch(int, int, int, int);
 extern void sweet_dcache_clean(vm_offset_t, unsigned);
+extern bool river_gpu_pas_ready(void);
 void river_input_init(void);
 static vm_offset_t ri_qup, ri_gcc, ri_gcc_ahb, ri_gcc_vote;
 static vm_offset_t ri_tlmm, ri_touch, ri_key, ri_spmi, ri_obs;
@@ -310,28 +314,58 @@ river_wcnss_probe(void)
   return;
  }
  uint64_t pa = ((const uint64_t *)prop)[0], len = ((const uint64_t *)prop)[1];
- if ((pa & 0xfff) || pa >= 0xf0000000ULL || len < 52 || len > 0x10000 ||
+ if ((pa & 0xfff) || pa >= 0xf0000000ULL || len < 52 || len > PAGE_SIZE ||
      pa + len > 0xf0000000ULL) {
   printf("RIVER WCNSS: rejected PAS metadata physical range %#llx+%#llx\n", pa, len);
   return;
  }
+ printf("RIVER WCNSS: validating staged metadata at %#llx+%#llx\n", pa, len);
  const uint8_t *meta = (const uint8_t *)ml_static_ptovirt((vm_offset_t)pa);
  if (!meta || memcmp(meta, "\x7f" "ELF", 4) != 0 || meta[4] != 1 || meta[5] != 1) {
   printf("RIVER WCNSS: invalid ELF32 PAS metadata\n");
   return;
  }
- /* The boot blob is cached, while PAS reads its physical address.  Clean
-  * the exact buffer to PoC before TrustZone protects and reads these pages.
-  * Linux uses a coherent allocation for this same SCM command. */
- sweet_dcache_clean((vm_offset_t)meta, (unsigned)len);
- printf("RIVER WCNSS: PAS init_image about to call with metadata %#llx+%#llx (cache clean complete)\n",
-     pa, len);
+ if (!river_gpu_pas_ready()) {
+  printf("RIVER WCNSS: GPU PAS/crypto clock prerequisite absent; skipping metadata\n");
+  return;
+ }
+ /* Match the working River GPU PAS path: give TrustZone its own contiguous
+  * page, copy metadata into it, and clean it to PoC.  Keep it allocated
+  * because secure firmware may retain or protect the metadata after return. */
+ vm_offset_t buf = 0;
+ if (kmem_alloc_contig(kernel_map, &buf, PAGE_SIZE, PAGE_MASK, 0, 0,
+     KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+  printf("RIVER WCNSS: metadata allocation failed\n");
+  return;
+ }
+ ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)buf);
+ uint64_t mpa = pn ? ptoa_64(pn) : 0;
+ if (!mpa || mpa >= 0xf0000000ULL || (mpa & 0xfff)) {
+  printf("RIVER WCNSS: invalid contiguous metadata physical address %#llx\n", mpa);
+  return;
+ }
+ memcpy((void *)buf, meta, (size_t)len);
+ sweet_dcache_clean(buf, PAGE_SIZE);
+ printf("RIVER WCNSS: PAS init_image about to call with contiguous metadata %#llx+%#llx\n",
+     mpa, len);
  /* Let the USB console receiver persist the marker if TZ resets the SoC. */
  ri_wait(12000);
  uint64_t res = 0;
- int64_t st = river_scm(0x02, 0x01, 2 | (2 << 6), 6, pa, &res);
+ int64_t st = river_scm(0x02, 0x01, 2 | (2 << 6), 6, mpa, &res);
  printf("RIVER WCNSS: PAS init_image metadata %#llx+%#llx status %lld result %llu (no reset)\n",
-     pa, len, st, res);
+     mpa, len, st, res);
+}
+
+static void
+river_wcnss_thread(void *arg, wait_result_t result)
+{
+ (void)arg; (void)result;
+ uint32_t init = 0;
+ if (PE_parse_boot_argn("riverwcnssinit", &init, sizeof(init)) && init) {
+  printf("RIVER WCNSS: deferring PAS metadata probe 45 seconds for USB logging\n");
+  ri_wait(45000);
+ }
+ river_wcnss_probe();
 }
 
 static void
@@ -406,7 +440,6 @@ river_gpu_probe(void)
 static void
 ri_probe(void)
 {
- river_wcnss_probe();
  ri_tlmm = ri_map(0x01008000);
  ri_touch = ri_map(0x01040000);
  ri_key = ri_map(0x01054000);
@@ -472,6 +505,12 @@ static void
 ri_thread(void *arg, wait_result_t result)
 {
  (void)arg; (void)result; ri_wait(3000); ri_probe();
+ uint32_t wcnss = 0;
+ if (PE_parse_boot_argn("riverwcnssprobe", &wcnss, sizeof(wcnss)) && wcnss) {
+  thread_t wt;
+  if (kernel_thread_start(river_wcnss_thread, NULL, &wt) == KERN_SUCCESS)
+   thread_deallocate(wt);
+ }
  int keys[3]={0,0,0}; bool down[10]={false}; unsigned failures=0;
  bool vol_ok=ri_key && !(ri_rd(ri_key,0x1000)&0x23cu);
  /* GPIO65 (ri_touch + 0x1000) INTR_CFG: raw status on (bit 4), rising edge
-- 
