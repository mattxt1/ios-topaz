+/* Read-only charging-state observation; a USB connection alone is not charge. */
+static int
+river_charge_sample_sysctl SYSCTL_HANDLER_ARGS
+{
+ if (!__atomic_load_n(&ri_power_ready, __ATOMIC_ACQUIRE) || !ri_charge_chgr || !ri_charge_dcdc) return ENXIO;
+ int expected = 0;
+ if (!__atomic_compare_exchange_n(&ri_power_busy, &expected, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return EBUSY;
+ uint32_t type, subtype, state, err, limits, temp, command, path;
+ int error = EIO;
+ if (ri_spmi_read(ri_charge_chgr, 4, 1, &type) && ri_spmi_read(ri_charge_chgr, 5, 1, &subtype) &&
+     ri_spmi_read(ri_charge_chgr, 6, 1, &state) && ri_spmi_read(ri_charge_chgr, 7, 1, &err) &&
+     ri_spmi_read(ri_charge_chgr, 0xb, 1, &limits) && ri_spmi_read(ri_charge_chgr, 0xd, 1, &temp) &&
+     ri_spmi_read(ri_charge_chgr, 0x42, 1, &command) && ri_spmi_read(ri_charge_dcdc, 0xb, 1, &path)) {
+  char note[256];
+  snprintf(note, sizeof(note), "type=%#x subtype=%#x state=%#x errors=%#x modes=%#x temp=%#x command=%#x power_path=%#x", type, subtype, state, err, limits, temp, command, path);
+  error = sysctl_handle_string(oidp, note, 0, req);
+ }
+ __atomic_store_n(&ri_power_busy, 0, __ATOMIC_RELEASE);
+ return error;
+}
