index 0000000..dc41276
--- /dev/null
+++ b/bsd/dev/river_gpu.c
@@ -0,0 +1,353 @@
+/*
+ * river (Moto G7, SDM632) Adreno 506 command processor bring-up, boot-arg
+ * rivergpu=3. Runs after sweet_keys.c has powered the GPU, restored its TZ
+ * secure configuration and read RBBM (rivergpu=2 path).
+ *
+ * Follows mainline drivers/gpu/drm/msm/adreno/a5xx_gpu.c a5xx_hw_init()
+ * (A506 branches; no HWCG, preemption or GPMU, which A506 lacks) with GPU
+ * buffers in physically contiguous kernel memory. The GPU SMMU context bank
+ * is left as TZ restored it and only surveyed: with SCTLR.M clear the GPU's
+ * addresses are physical.
+ *
+ * The PM4/PFP microcode (a530_pm4.fw, a530_pfp.fw) is Qualcomm firmware and
+ * never part of this tree: tools/mkpayload.py --blob appends a local
+ * container (tools/river-gpufw.py) to the RAM-only boot image and names it in
+ * the ADT as /chosen/memory-map RiverGPUFW = <phys, size>.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <vm/memory_types.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern void delay(int usec);
+
+#define GPU_PA		0x01c00000
+#define GPU_SIZE	0x40000
+#define SMMU_PA		0x01c40000
+#define SMMU_SIZE	0x10000
+
+/* a5xx.xml.h (Linux v6.6), dword register indices */
+#define VBIF_ROUND_ROBIN_QOS_ARB	0x3049
+#define RBBM_PERFCTR_GPU_BUSY_MASKED	0x046f
+#define RBBM_AHB_CNTL0			0x0093
+#define RBBM_AHB_CNTL1			0x0094
+#define RBBM_AHB_CNTL2			0x0095
+#define RBBM_INTERFACE_HANG_INT_CNTL	0x002f
+#define RBBM_PERFCTR_CNTL		0x0464
+#define CP_PERFCTR_CP_SEL_0		0x0bb0
+#define RBBM_PERFCTR_RBBM_SEL_0		0x046b
+#define UCHE_CACHE_WAYS			0x0e96
+#define UCHE_WRITE_THRU_BASE_LO		0x0e87
+#define UCHE_WRITE_THRU_BASE_HI		0x0e88
+#define UCHE_TRAP_BASE_LO		0x0e89
+#define UCHE_TRAP_BASE_HI		0x0e8a
+#define UCHE_GMEM_RANGE_MIN_LO		0x0e8b
+#define UCHE_GMEM_RANGE_MIN_HI		0x0e8c
+#define UCHE_GMEM_RANGE_MAX_LO		0x0e8d
+#define UCHE_GMEM_RANGE_MAX_HI		0x0e8e
+#define UCHE_MODE_CNTL			0x0e81
+#define CP_ROQ_THRESHOLDS_1		0x081f
+#define CP_ROQ_THRESHOLDS_2		0x0820
+#define CP_MEQ_THRESHOLDS		0x0825
+#define CP_MERCIU_SIZE			0x0826
+#define CP_PFP_ME_CNTL			0x0832
+#define CP_CHICKEN_DBG			0x0833
+#define CP_PFP_INSTR_BASE_LO		0x0835
+#define CP_PFP_INSTR_BASE_HI		0x0836
+#define CP_ME_INSTR_BASE_LO		0x0838
+#define CP_ME_INSTR_BASE_HI		0x0839
+#define CP_RB_BASE			0x0800
+#define CP_RB_BASE_HI			0x0801
+#define CP_RB_CNTL			0x0802
+#define CP_RB_RPTR			0x0806
+#define CP_RB_WPTR			0x0807
+#define CP_PROTECT(i)			(0x0880 + (i))
+#define CP_PROTECT_CNTL			0x08a0
+#define CP_ME_STAT_DATA			0x0b14
+#define CP_INTERRUPT_STATUS		0x0b18
+#define CP_HW_FAULT			0x0b1a
+#define CP_SCRATCH_REG(i)		(0x0b78 + (i))
+#define PC_DBG_ECO_CNTL			0x0d00
+#define RB_DBG_ECO_CNTL			0x0cc4
+#define RB_MODE_CNTL			0x0cc6
+#define TPL1_MODE_CNTL			0x0f02
+#define VPC_DBG_ECO_CNTL		0x0e60
+#define HLSQ_DBG_ECO_CNTL		0x0e04
+#define RBBM_INT_0_MASK			0x0038
+#define RBBM_INT_0_STATUS		0x04e1
+#define RBBM_AHB_ERROR_STATUS		0x04f4
+#define RBBM_STATUS			0x04f5
+#define RBBM_SECVID_TRUST_CNTL		0xf400
+#define RBBM_SECVID_TSB_TRUSTED_BASE_LO	0xf800
+#define RBBM_SECVID_TSB_TRUSTED_BASE_HI	0xf801
+#define RBBM_SECVID_TSB_TRUSTED_SIZE	0xf802
+#define RBBM_SECVID_TSB_CNTL		0xf803
+static const uint32_t addr_mode_cntl[] = {
+	0x0860 /* CP */, 0x0bc1 /* VSC */, 0x0c81 /* GRAS */, 0x0cc5 /* RB */,
+	0x0d01 /* PC */, 0x0e05 /* HLSQ */, 0x0e41 /* VFD */, 0x0e61 /* VPC */,
+	0x0e80 /* UCHE */, 0x0ec1 /* SP */, 0x0f01 /* TPL1 */, 0xf810 /* SECVID_TSB */,
+};
+#define A5XX_RBBM_STATUS_HI_BUSY	0x00000001
+/* adreno_pm4.xml.h opcodes */
+#define CP_ME_INIT	72
+#define CP_MEM_WRITE	61
+
+/* Buffer layout in one contiguous 64 KiB allocation. */
+#define BUF_SIZE	0x10000
+#define OFF_PM4		0x0000
+#define OFF_PFP		0x8000
+#define OFF_RING	0xc000
+#define RING_SIZE	0x1000		/* CP_RB_CNTL BUFSZ = log2(4096 / 8) = 9 */
+#define OFF_SCRATCH	0xf000
+
+static vm_offset_t gr;		/* GPU registers */
+static uint32_t *ring;
+static unsigned wptr;
+
+static uint32_t
+g_rd(uint32_t reg)
+{
+	uint32_t v = *(volatile uint32_t *)(gr + reg * 4);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+static void
+g_wr(uint32_t reg, uint32_t v)
+{
+	*(volatile uint32_t *)(gr + reg * 4) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+static void
+g_rmw(uint32_t reg, uint32_t clear, uint32_t set)
+{
+	g_wr(reg, (g_rd(reg) & ~clear) | set);
+}
+
+/* adreno_gpu.h PM4_PARITY / PKT4 / OUT_PKT7 */
+static uint32_t
+pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	    (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1;
+}
+static uint32_t
+pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) |
+	    (pm4_parity(reg) << 27);
+}
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000 | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) |
+	    (pm4_parity(op) << 23);
+}
+static uint32_t
+protect_rw(uint32_t reg, uint32_t len)
+{
+	uint32_t l = 0;
+	while ((2u << l) <= len) l++;
+	return (1u << 30) | (1u << 29) | ((l & 0x1f) << 24) | ((reg << 2) & 0xfffff);
+}
+
+/* Find one file in the RiverGPUFW container ("RIVGPUFW", u32 count, then
+ * count x { char name[24]; u32 off; u32 size }, offsets from the start). */
+static const uint8_t *
+fw_find(const uint8_t *c, uint64_t csize, const char *name, uint32_t *size)
+{
+	if (csize < 12 || memcmp(c, "RIVGPUFW", 8)) return NULL;
+	uint32_t n = *(const uint32_t *)(c + 8);
+	for (uint32_t i = 0; i < n && 12 + (i + 1) * 32 <= csize; i++) {
+		const uint8_t *e = c + 12 + i * 32;
+		uint32_t off = *(const uint32_t *)(e + 24), sz = *(const uint32_t *)(e + 28);
+		if (!strncmp((const char *)e, name, 24) && (uint64_t)off + sz <= csize) {
+			*size = sz;
+			return c + off;
+		}
+	}
+	return NULL;
+}
+
+/* Hand the CP everything written since the last submit; wait until RPTR
+ * catches up (adreno_idle) and RBBM is idle apart from HI_BUSY. */
+static bool
+submit(vm_offset_t buf, uint64_t pa, const char *what)
+{
+	flush_dcache64((addr64_t)(pa + OFF_RING), RING_SIZE, TRUE);
+	(void)buf;
+	g_wr(CP_RB_WPTR, wptr);
+	for (unsigned i = 0; i < 100000; i++) {
+		if (g_rd(CP_RB_RPTR) == wptr && !(g_rd(RBBM_STATUS) & ~A5XX_RBBM_STATUS_HI_BUSY))
+			return true;
+		delay(1);
+	}
+	printf("RIVER GPU: %s timed out: rptr %u wptr %u RBBM_STATUS %#x INT_0 %#x CP_HW_FAULT %#x CP_INT %#x AHB_ERR %#x\n",
+	    what, g_rd(CP_RB_RPTR), wptr, g_rd(RBBM_STATUS), g_rd(RBBM_INT_0_STATUS),
+	    g_rd(CP_HW_FAULT), g_rd(CP_INTERRUPT_STATUS), g_rd(RBBM_AHB_ERROR_STATUS));
+	return false;
+}
+
+void river_gpu_cp_start(void);
+void
+river_gpu_cp_start(void)
+{
+	/* Firmware container from the ADT. */
+	DTEntry mm;
+	void const *prop;
+	unsigned int psize;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "RiverGPUFW", &prop, &psize) != kSuccess || psize != 16) {
+		printf("RIVER GPU: no RiverGPUFW in the boot image; CP not started\n");
+		return;
+	}
+	uint64_t fw_pa = ((const uint64_t *)prop)[0], fw_size = ((const uint64_t *)prop)[1];
+	const uint8_t *fw = (const uint8_t *)ml_static_ptovirt((vm_offset_t)fw_pa);
+	uint32_t pm4_size = 0, pfp_size = 0;
+	const uint8_t *pm4 = fw ? fw_find(fw, fw_size, "a530_pm4.fw", &pm4_size) : NULL;
+	const uint8_t *pfp = fw ? fw_find(fw, fw_size, "a530_pfp.fw", &pfp_size) : NULL;
+	if (!pm4 || !pfp || pm4_size <= 16 || pfp_size <= 16 ||
+	    pm4_size - 4 > OFF_PFP - OFF_PM4 || pfp_size - 4 > OFF_RING - OFF_PFP) {
+		printf("RIVER GPU: firmware container at %#llx+%#llx incomplete (pm4 %u, pfp %u)\n",
+		    fw_pa, fw_size, pm4_size, pfp_size);
+		return;
+	}
+	const uint32_t *p4 = (const uint32_t *)pm4, *pf = (const uint32_t *)pfp;
+	printf("RIVER GPU: microcode pm4 %u bytes [%#x %#x %#x], pfp %u bytes [%#x %#x %#x]\n",
+	    pm4_size, p4[1], p4[2], p4[3], pfp_size, pf[1], pf[2], pf[3]);
+
+	gr = ml_io_map_unmappable(GPU_PA, GPU_SIZE, VM_WIMG_IO);
+	vm_offset_t sm = ml_io_map_unmappable(SMMU_PA, SMMU_SIZE, VM_WIMG_IO);
+	if (!gr || !sm) { printf("RIVER GPU: register map failed\n"); return; }
+
+	/* GPU SMMU survey (IDR0 NUMSMRG 4, IDR1: 4 KiB pages, CB space at +0x8000). */
+	volatile uint32_t *s = (volatile uint32_t *)sm;
+	printf("RIVER GPU: reading SMMU SMR/S2CR\n");
+	printf("RIVER GPU: SMMU SMR %#x %#x %#x %#x S2CR %#x %#x %#x %#x\n",
+	    s[0x800/4], s[0x804/4], s[0x808/4], s[0x80c/4], s[0xc00/4], s[0xc04/4], s[0xc08/4], s[0xc0c/4]);
+	printf("RIVER GPU: reading SMMU CB0 (gfx3d_user)\n");
+	printf("RIVER GPU: SMMU CB0 SCTLR %#x TCR %#x FSR %#x\n",
+	    s[0x8000/4], s[0x8030/4], s[0x8058/4]);
+
+	/* GPU buffers. */
+	vm_offset_t buf = 0;
+	if (kmem_alloc_contig(kernel_map, &buf, BUF_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("RIVER GPU: no buffer memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)buf);
+	uint64_t pa = pn ? ptoa_64(pn) : 0;
+	if (!pa) { printf("RIVER GPU: buffer has no physical address\n"); return; }
+	/* adreno_fw_create_bo: the first dword of the .fw file is not loaded. */
+	memcpy((void *)(buf + OFF_PM4), pm4 + 4, pm4_size - 4);
+	memcpy((void *)(buf + OFF_PFP), pfp + 4, pfp_size - 4);
+	ring = (uint32_t *)(buf + OFF_RING);
+	volatile uint32_t *scratch = (volatile uint32_t *)(buf + OFF_SCRATCH);
+	scratch[0] = 0xdeadbeef;
+	flush_dcache64((addr64_t)pa, BUF_SIZE, TRUE);
+	printf("RIVER GPU: buffers at pa %#llx (pm4 +%#x pfp +%#x ring +%#x scratch +%#x)\n",
+	    pa, OFF_PM4, OFF_PFP, OFF_RING, OFF_SCRATCH);
+
+	/* a5xx_hw_init, A506 path. */
+	g_wr(VBIF_ROUND_ROBIN_QOS_ARB, 0x00000003);
+	g_wr(RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	g_wr(RBBM_AHB_CNTL0, 0x00000001);
+	g_wr(RBBM_INTERFACE_HANG_INT_CNTL, (1u << 30) | 0xffff);
+	g_wr(RBBM_PERFCTR_CNTL, 0x01);
+	g_wr(CP_PERFCTR_CP_SEL_0, 0);			/* PERF_CP_ALWAYS_COUNT */
+	g_wr(RBBM_PERFCTR_RBBM_SEL_0, 6);
+	g_wr(UCHE_CACHE_WAYS, 0x02);
+	g_wr(UCHE_TRAP_BASE_LO, 0xffff0000);
+	g_wr(UCHE_TRAP_BASE_HI, 0x0001ffff);
+	g_wr(UCHE_WRITE_THRU_BASE_LO, 0xffff0000);
+	g_wr(UCHE_WRITE_THRU_BASE_HI, 0x0001ffff);
+	g_wr(UCHE_GMEM_RANGE_MIN_LO, 0x00100000);
+	g_wr(UCHE_GMEM_RANGE_MIN_HI, 0);
+	g_wr(UCHE_GMEM_RANGE_MAX_LO, 0x00100000 + (128 + 8) * 1024 - 1);
+	g_wr(UCHE_GMEM_RANGE_MAX_HI, 0);
+	g_wr(CP_MEQ_THRESHOLDS, 0x20);
+	g_wr(CP_MERCIU_SIZE, 0x400);
+	g_wr(CP_ROQ_THRESHOLDS_2, 0x40000030);
+	g_wr(CP_ROQ_THRESHOLDS_1, 0x20100d0a);
+	g_wr(PC_DBG_ECO_CNTL, (0x100u << 11) | (0x100u << 22));
+	g_rmw(PC_DBG_ECO_CNTL, 0, 1u << 8);		/* TWO_PASS_USE_WFI */
+	g_rmw(RB_DBG_ECO_CNTL, 0, 1u << 9);		/* 1-SP: no DP2 clock gating */
+	g_wr(UCHE_MODE_CNTL, 1u << 29);
+	g_wr(CP_CHICKEN_DBG, 0x02000000);
+	g_wr(RBBM_AHB_CNTL1, 0xa6ffffff);
+	g_wr(RBBM_AHB_CNTL2, 0x0000003f);
+	g_wr(TPL1_MODE_CNTL, 1u << 7);			/* highest bank bit, regbit 1 */
+	g_wr(RB_MODE_CNTL, 1u << 1);
+	g_rmw(VPC_DBG_ECO_CNTL, 0, 1u << 10);
+	g_wr(CP_PROTECT_CNTL, 0x00000007);
+	static const uint32_t prot[][2] = {
+		{0x04, 4}, {0x08, 8}, {0x10, 16}, {0x20, 32}, {0x40, 64}, {0x80, 64},
+		{RBBM_SECVID_TSB_TRUSTED_BASE_LO, 16}, {RBBM_SECVID_TRUST_CNTL, 2},
+		{0x800, 64}, {0x840, 8}, {0x880, 32}, {0xaa0, 1}, {0xcc0, 1}, {0xcf0, 2},
+		{0xe68, 8}, {0xe70, 16}, {0xe80, 16}, {0x10000, 0x8000},
+	};
+	for (unsigned i = 0; i < sizeof(prot) / sizeof(prot[0]); i++)
+		g_wr(CP_PROTECT(i), protect_rw(prot[i][0], prot[i][1]));
+	g_wr(RBBM_SECVID_TSB_CNTL, 0);
+	g_wr(RBBM_SECVID_TSB_TRUSTED_BASE_LO, 0);
+	g_wr(RBBM_SECVID_TSB_TRUSTED_BASE_HI, 0);
+	g_wr(RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	for (unsigned i = 0; i < sizeof(addr_mode_cntl) / sizeof(addr_mode_cntl[0]); i++)
+		g_wr(addr_mode_cntl[i], 0x1);
+	g_rmw(VPC_DBG_ECO_CNTL, 0, 1u << 23);		/* LMLOADKILL_DISABLE */
+	g_rmw(HLSQ_DBG_ECO_CNTL, 1u << 18, 0);
+
+	g_wr(CP_ME_INSTR_BASE_LO, (uint32_t)(pa + OFF_PM4));
+	g_wr(CP_ME_INSTR_BASE_HI, (uint32_t)((pa + OFF_PM4) >> 32));
+	g_wr(CP_PFP_INSTR_BASE_LO, (uint32_t)(pa + OFF_PFP));
+	g_wr(CP_PFP_INSTR_BASE_HI, (uint32_t)((pa + OFF_PFP) >> 32));
+	g_wr(CP_RB_BASE, (uint32_t)(pa + OFF_RING));
+	g_wr(CP_RB_BASE_HI, (uint32_t)((pa + OFF_RING) >> 32));
+	g_wr(CP_RB_CNTL, 0x08000000 | (2u << 8) | 9u);	/* NO_UPDATE, BLKSZ 32 B, 4 KiB */
+	g_wr(RBBM_INT_0_MASK, 0);			/* polled; GPU IRQ not routed */
+	printf("RIVER GPU: hw_init done; RBBM_STATUS %#x CP_PFP_ME_CNTL %#x rptr %u\n",
+	    g_rd(RBBM_STATUS), g_rd(CP_PFP_ME_CNTL), g_rd(CP_RB_RPTR));
+
+	/* Clear ME_HALT and send CP_ME_INIT (a5xx_me_init, A506 workaround 0x0b). */
+	g_wr(CP_PFP_ME_CNTL, 0);
+	wptr = 0;
+	ring[wptr++] = pkt7(CP_ME_INIT, 8);
+	ring[wptr++] = 0x0000002f;
+	ring[wptr++] = 0x00000003;
+	ring[wptr++] = 0x20000000;
+	ring[wptr++] = 0;
+	ring[wptr++] = 0;
+	ring[wptr++] = 0x0000000b;
+	ring[wptr++] = 0;
+	ring[wptr++] = 0;
+	if (!submit(buf, pa, "CP_ME_INIT")) return;
+	printf("RIVER GPU: CP_ME_INIT consumed (rptr %u), RBBM_STATUS %#x\n", g_rd(CP_RB_RPTR), g_rd(RBBM_STATUS));
+
+	/* Proof of execution: the CP writes a scratch register (PKT4) ... */
+	g_wr(CP_SCRATCH_REG(0), 0);
+	ring[wptr++] = pkt4(CP_SCRATCH_REG(0), 1);
+	ring[wptr++] = 0x05060a5e;
+	if (!submit(buf, pa, "scratch write")) return;
+	printf("RIVER GPU: CP wrote CP_SCRATCH_REG0 = %#x (expect 0x5060a5e)\n", g_rd(CP_SCRATCH_REG(0)));
+
+	/* ... then memory (CP_MEM_WRITE: addr lo, hi, data). Still in secure
+	 * mode until a zap shader runs, so this may be refused; it is last. */
+	uint64_t spa = pa + OFF_SCRATCH;
+	ring[wptr++] = pkt7(CP_MEM_WRITE, 3);
+	ring[wptr++] = (uint32_t)spa;
+	ring[wptr++] = (uint32_t)(spa >> 32);
+	ring[wptr++] = 0x1c0ffee5;
+	bool ok = submit(buf, pa, "CP_MEM_WRITE");
+	flush_dcache64((addr64_t)spa, 64, TRUE);
+	printf("RIVER GPU: CP_MEM_WRITE %s; memory now %#x (expect 0x1c0ffee5, was 0xdeadbeef); SMMU CB0 FSR %#x GFSR %#x\n",
+	    ok ? "consumed" : "stuck", scratch[0], s[0x8058/4], s[0x48/4]);
+}
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 5183a39..35f1708 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -321,6 +321,10 @@ river_gpu_probe(void)
      ri_rd(r, 0x4f5 * 4), ri_rd(r, 0x530 * 4), ri_rd(r, 0x4e1 * 4), ri_rd(r, 0x800 * 4));
  uint32_t c0 = ri_rd(r, 0x4d2 * 4); delay(1000); uint32_t c1 = ri_rd(r, 0x4d2 * 4);
  printf("RIVER GPU: ALWAYSON_COUNTER %#x -> %#x after 1 ms (%s)\n", c0, c1, c1 != c0 ? "GPU alive" : "not counting");
+ if (on >= 3 && c1 != c0) {
+  extern void river_gpu_cp_start(void);
+  river_gpu_cp_start();
+ }
 }
 
 static void
