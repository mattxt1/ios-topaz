+/* Persistent console area: last 4 MiB + 4 KiB, aligned to 4 KiB and wholly
+ * inside userdata. Never enable it if the HFS volume reaches that area. */
+#define RIVER_LOG_BLOCKS4K 1025ULL
+static uint64_t river_log_base4k;
+uint64_t river_emmc_log_base(void);
+int river_emmc_log_write(uint64_t block4k, uint32_t count4k, const void *src);
+
+uint64_t
+river_emmc_log_base(void)
+{
+	return river_log_base4k;
+}
+
+int
+river_emmc_log_write(uint64_t block4k, uint32_t count4k, const void *src)
+{
+	if (!write_enabled || river_log_base4k == 0 || count4k == 0 || count4k > 16 ||
+	    block4k < river_log_base4k ||
+	    block4k - river_log_base4k >= RIVER_LOG_BLOCKS4K ||
+	    count4k > RIVER_LOG_BLOCKS4K - (block4k - river_log_base4k)) {
+		return EROFS;
+	}
+	int error = 0;
+	lck_mtx_lock(&river_emmc_lock);
+	for (uint32_t n = 0; n < count4k * 8 && !error; n++) {
+		error = river_emmc_write_block(block4k * 8 + n, (const uint8_t *)src + n * BLOCK);
+	}
+	lck_mtx_unlock(&river_emmc_lock);
+	return error;
+}
+
+static uint32_t
+river_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static void
+river_emmc_log_init(void)
+{
+	uint32_t on = 0, header[BLOCK / 4];
+	if (!write_enabled || !PE_parse_boot_argn("riverlog", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	lck_mtx_lock(&river_emmc_lock);
+	int error = river_emmc_read_block(parts[64].first + 2, header);
+	lck_mtx_unlock(&river_emmc_lock);
+	const uint8_t *h = (const uint8_t *)header;
+	if (error || h[0] != 'H' || (h[1] != 'X' && h[1] != '+')) {
+		printf("RIVER LOG: no HFS volume header; refusing log writes\n");
+		return;
+	}
+	uint32_t blockSize = river_be32(h + 40), blocks = river_be32(h + 44);
+	uint64_t base = ((parts[64].first + parts[64].count) / 8 - RIVER_LOG_BLOCKS4K) * 8;
+	uint64_t volumeBytes = (uint64_t)blockSize * blocks;
+	if (blockSize < 512 || blockSize > (1U << 20) || (blockSize & (blockSize - 1)) ||
+	    !blocks || base <= parts[64].first || volumeBytes > (base - parts[64].first) * BLOCK) {
+		printf("RIVER LOG: HFS volume overlaps reserved log area; refusing log writes\n");
+		return;
+	}
+	river_log_base4k = base / 8;
+	printf("RIVER LOG: HFS %llu bytes; log outside filesystem at userdata tail\n", volumeBytes);
+}
+
 void river_emmc_probe(void);
 void
 river_emmc_probe(void)
@@ -993,6 +1061,7 @@ river_emmc_probe(void)
 		river_emmc_bench();
 	}
 	river_emmc_devices();
+	river_emmc_log_init();
 	printf("RIVER eMMC: probe done\n");
 }
