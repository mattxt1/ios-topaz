+/*
+ * Minimal SPI routing for river drivers (no IOKit interrupt controller):
+ * river_irq_register() sets the SPI's trigger (GICD_ICFGR), Group 1,
+ * priority 0xa0 and target (Gold CPU0's interface), then enables it.
+ * sleh_irq calls river_irq_dispatch() for every SPI; the handler runs in
+ * interrupt context and must quiet its device before returning.
+ */
+#define RIVER_IRQ_MAX	288
+#define GICD_V2_ICFGR	0xc00
+typedef void (*river_irq_fn_t)(void *arg);
+static river_irq_fn_t river_irq_fn[RIVER_IRQ_MAX];
+static void *river_irq_arg[RIVER_IRQ_MAX];
+bool river_irq_register(uint32_t intid, bool edge, river_irq_fn_t fn, void *arg);
+bool river_irq_dispatch(uint32_t intid);
+
+bool
+river_irq_register(uint32_t intid, bool edge, river_irq_fn_t fn, void *arg)
+{
+	if (intid < 32 || intid >= RIVER_IRQ_MAX || !river_gicd_base || !river_gic_iface[0] || !fn) {
+		return false;
+	}
+	vm_offset_t d = river_gicd_base;
+	river_gic_mask_intid(intid);
+	river_irq_arg[intid] = arg;
+	__asm__ volatile("dmb ish" ::: "memory");
+	river_irq_fn[intid] = fn;
+	vm_offset_t cfg = d + GICD_V2_ICFGR + 4 * (intid / 16);
+	uint32_t bit = 2U << (2 * (intid % 16));
+	river_gic_write32(cfg, edge ? (river_gic_read32(cfg) | bit) : (river_gic_read32(cfg) & ~bit));
+	vm_offset_t grp = d + GICD_V2_IGROUPR0 + 4 * (intid / 32);
+	river_gic_write32(grp, river_gic_read32(grp) | (1U << (intid % 32)));
+	*(volatile uint8_t *)(d + GICD_V2_IPRIORITYR + intid) = 0xa0;
+	*(volatile uint8_t *)(d + GICD_V2_ITARGETSR0 + intid) = river_gic_iface[0];
+	__asm__ volatile("dsb sy" ::: "memory");
+	river_gic_write32(d + GICD_V2_ISENABLER0 + 4 * (intid / 32), 1U << (intid % 32));
+	kprintf("RIVER GIC: SPI INTID %u %s -> iface %#x\n", intid, edge ? "edge" : "level", river_gic_iface[0]);
+	return true;
+}
+
+bool
+river_irq_dispatch(uint32_t intid)
+{
+	if (intid >= RIVER_IRQ_MAX || river_irq_fn[intid] == NULL) {
+		return false;
+	}
+	river_irq_fn[intid](river_irq_arg[intid]);
+	return true;
+}
