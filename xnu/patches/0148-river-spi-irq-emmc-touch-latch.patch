+/*
+ * sdhc_1 hc_irq (river DT: SPI 0x7b, INTID 155, level). After the probe,
+ * a DMA read sleeps until the controller signals XFER_DONE or an error
+ * instead of spinning; the handler masks the signal so the line drops.
+ * The status is still checked afterwards, so a lost interrupt only costs
+ * the 200 ms timeout. Boot-arg rivermmcirq=0 keeps spinning.
+ */
+#define SDHC1_HC_IRQ		(32 + 0x7b)
+static bool emmc_irq_ready;
+static int emmc_irq_event;
+static uint64_t emmc_irq_waits, emmc_irq_fired;
+
+static void
+river_emmc_irq(__unused void *arg)
+{
+	*(volatile uint32_t *)(hc + SDHCI_SIGNAL_ENABLE) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	emmc_irq_fired++;
+	thread_wakeup((event_t)&emmc_irq_event);
+}
