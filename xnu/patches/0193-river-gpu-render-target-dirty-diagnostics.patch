+void
+river_gpu_import_describe(void *import, char *buf, size_t len)
+{
+	SweetSurface *s = (SweetSurface *)import;
+	uint32_t f = s->pixelFormat;
+	char fcc[5] = { (char)(f >> 24), (char)(f >> 16), (char)(f >> 8), (char)f, 0 };
+	for (int i = 0; i < 4; i++) {
+		if (fcc[i] < 0x20 || fcc[i] > 0x7e) fcc[i] = '.';
+	}
+	snprintf(buf, len, "surface %u %ux%u '%s' bpr %u cache %u, mapped by %u: %s %s %s %s", s->id, s->width,
+	    s->height, fcc, s->bytesPerRow, s->cacheMode, s->riverMapperCount, s->riverMappers[0],
+	    s->riverMappers[1], s->riverMappers[2], s->riverMappers[3]);
+}
