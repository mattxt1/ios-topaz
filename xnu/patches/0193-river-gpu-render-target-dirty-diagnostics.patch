+/*
+ * 0193 diagnostics: does a render target hold CPU-written data that is not
+ * yet in memory when the GPU is about to use it? Compare 32 cache lines read
+ * through an uncached mapping (memory) with the cached kernel view.
+ */
+static uint32_t rgpu_rt_sampled, rgpu_rt_dirty_surfaces, rgpu_rt_detail;
+static uint64_t rgpu_rt_report;
+
+static void
+rgpu_rt_sample(struct rgpu_bo *b)
+{
+	uint64_t now = mach_absolute_time(), ns;
+	absolutetime_to_nanoseconds(now - b->sampled_at, &ns);
+	if (b->sampled_at != 0 && ns < 2000000000ULL) {
+		return;
+	}
+	b->sampled_at = now;
+	unsigned dirty = 0, n = 0;
+	for (unsigned i = 0; i < 32; i++) {
+		uint32_t p = (uint32_t)(((uint64_t)i * b->npages) / 32);
+		uint64_t off = ((uint64_t)(i * 1237u) % (PAGE_SIZE / 64)) * 64;
+		uint64_t pa = b->pa[p];
+		if (!pmap_valid_page((ppnum_t)atop_64(pa))) {
+			continue;
+		}
+		vm_offset_t u = ml_io_map_unmappable((vm_offset_t)pa, PAGE_SIZE, VM_WIMG_IO);
+		if (u == 0) {
+			continue;
+		}
+		const volatile uint64_t *mem = (const volatile uint64_t *)(u + off);
+		const volatile uint64_t *cpu = (const volatile uint64_t *)(phystokv(pa) + off);
+		uint64_t m[8];
+		for (unsigned k = 0; k < 8; k++) m[k] = mem[k];
+		bool diff = false;
+		for (unsigned k = 0; k < 8; k++) diff |= cpu[k] != m[k];
+		ml_io_unmap(u, PAGE_SIZE);
+		dirty += diff;
+		n++;
+	}
+	rgpu_rt_sampled++;
+	if (dirty) {
+		rgpu_rt_dirty_surfaces++;
+		if (rgpu_rt_detail++ < 6) {
+			char d[200];
+			river_gpu_import_describe(b->import, d, sizeof(d));
+			printf("RIVER GPU: render target with CPU-dirty lines %u/%u: %s\n", dirty, n, d);
+		}
+	}
+	absolutetime_to_nanoseconds(now - rgpu_rt_report, &ns);
+	if (ns >= 10000000000ULL) {
+		if (rgpu_rt_report != 0) {
+			printf("RIVER GPU: 10 s: %u render-target samples, %u with CPU-dirty lines\n",
+			    rgpu_rt_sampled, rgpu_rt_dirty_surfaces);
+		}
+		rgpu_rt_report = now;
+		rgpu_rt_sampled = rgpu_rt_dirty_surfaces = rgpu_rt_detail = 0;
+	}
+}
+
 /*
  * Before the GPU uses a buffer: write-combined client buffers need nothing;
  * an imported surface is cleaned only when the CPU wrote it since the last
@@ -1021,6 +1084,9 @@ rgpu_bo_prepare_gpu(struct rgpu_bo *b)
 		return;		/* uncached pages (0192): nothing in the CPU cache */
 	}
 	if (rgpu_flush_all) {
+		if (b->import != NULL && b->gpu_only) {
+			rgpu_rt_sample(b);	/* 0193: before the clean */
+		}
 		rgpu_bo_flush(b);
 		return;
 	}
