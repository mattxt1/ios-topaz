diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 7d8e58e..dc0115f 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -209,15 +209,64 @@ sweet_surface_seed_value(SweetSurface *s)
 #if defined(RIVER)
 extern "C" void flush_dcache64(addr64_t addr, unsigned count, int phys);
 
+extern "C" bool river_gpu_fence_done(uint32_t fence);
+extern "C" int river_gpu_wait(uint32_t fence, uint32_t ms);
+
+/* r61 diagnostics: panel copies of GPU surfaces, GPU still busy, stale cache seen */
+static uint32_t river_rd_copies, river_rd_busy, river_rd_stale, river_rd_timeout;
+static uint64_t river_rd_wait_ns, river_rd_report;
+
+static uint64_t
+river_rd_sample(uintptr_t va, uint64_t len)
+{
+	/* 8 rows' worth of 64-byte samples spread over the range */
+	uint64_t h = 0xcbf29ce484222325ULL;
+	for (unsigned i = 0; i < 64; i++) {
+		const volatile uint64_t *p = (const volatile uint64_t *)((va + (len / 64) * i) & ~(uintptr_t)63);
+		for (unsigned k = 0; k < 8; k++) {
+			h = (h ^ p[k]) * 0x100000001b3ULL;
+		}
+	}
+	return h;
+}
+
 void
 river_surface_cpu_read(SweetSurface *s, uintptr_t va, uint64_t len)
 {
+	if (!s->gpuTouched || s->scanoutPhys != 0 || va == 0 || len == 0) {
+		return;
+	}
 	/*
-	 * Sticky: the GPU may still be drawing the next frame into this surface
-	 * while the panel copies it (r55 flickered when the mark was cleared).
+	 * 0191: wait until the GPU finished every submit using this surface
+	 * (r55-r60 flickered with fast frames), then drop stale cache lines.
 	 */
-	if (s->gpuTouched && s->scanoutPhys == 0 && va != 0 && len != 0) {
-		flush_dcache64((addr64_t)va, (unsigned)len, FALSE);
+	uint32_t f = s->gpuFence;
+	uint64_t t0 = mach_absolute_time();
+	river_rd_copies++;
+	if (f != 0 && !river_gpu_fence_done(f)) {
+		river_rd_busy++;
+		if (river_gpu_wait(f, 50) != 0) {
+			river_rd_timeout++;
+		}
+	}
+	uint64_t t1 = mach_absolute_time(), ns;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	river_rd_wait_ns += ns;
+	uint64_t before = river_rd_sample(va, len);
+	flush_dcache64((addr64_t)va, (unsigned)len, FALSE);
+	if (river_rd_sample(va, len) != before) {
+		river_rd_stale++;
+	}
+	absolutetime_to_nanoseconds(t1 - river_rd_report, &ns);
+	if (ns >= 10000000000ULL) {
+		if (river_rd_report != 0) {
+			IOLog("RIVER FB: 10 s: %u GPU-surface copies, %u found GPU busy (%u timed out, %llu us waited), "
+			    "%u saw stale cache\n", river_rd_copies, river_rd_busy, river_rd_timeout,
+			    river_rd_wait_ns / 1000, river_rd_stale);
+		}
+		river_rd_report = t1;
+		river_rd_copies = river_rd_busy = river_rd_stale = river_rd_timeout = 0;
+		river_rd_wait_ns = 0;
 	}
 }
 #endif
