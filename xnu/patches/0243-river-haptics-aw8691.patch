+static vm_offset_t
+ri_spmi_chnl(vm_offset_t core, unsigned ppid)
+{
+ for (unsigned i = 0; i < 256; i++) {
+  if (((ri_rd(core, 0x800 + i*4) >> 8) & 0xfff) == ppid) return ri_map(0x02400000 + i*0x8000);
+ }
+ return 0;
+}
+static bool
+ri_spmi_write(vm_offset_t chnl, unsigned addr, uint8_t val)
+{
+ if (!chnl) return false;
+ ri_wr(chnl, 0x10, (uint32_t)val);
+ ri_wr(chnl, 0x00, ((addr & 0xff) << 4));
+ for (unsigned i = 0; i < 1000; i++) {
+  uint32_t s = ri_rd(chnl, 0x08);
+  if (s & 1) { ri_wr(chnl, 0x08, 1); return true; }
+  if (s & 2) { ri_wr(chnl, 0x08, 2); return false; }
+  delay(1);
+ }
+ return false;
+}
+
+void
+river_haptics_init(void)
+{
+ int enabled = 1;
+ (void)PE_parse_boot_argn("riverhaptics", &enabled, sizeof(enabled));
+ if (!enabled) return;
+
+ if (ri_gcc_vote) ri_wr(ri_gcc_vote, 0x1004, ri_rd(ri_gcc_vote, 0x1004) | (1u << 10));
+ if (ri_gcc_ahb) ri_wr(ri_gcc_ahb, 0x1008, ri_rd(ri_gcc_ahb, 0x1008) | 1);
+
+ vm_offset_t gcc_qup2 = ri_map(0x01803000);
+ if (gcc_qup2) {
+  ri_wr(gcc_qup2, 4, 1); ri_wr(gcc_qup2, 0, ri_rd(gcc_qup2, 0) | 1);
+  for (unsigned i = 0; i < 1000 && (ri_rd(gcc_qup2, 0) & 1); i++) delay(1);
+  ri_wr(gcc_qup2, 0x10, ri_rd(gcc_qup2, 0x10) | 1);
+  for (unsigned i = 0; i < 1000 && (ri_rd(gcc_qup2, 0x10) & 0x80000000u); i++) delay(1);
+ }
+
+ vm_offset_t tlmm_qup2 = ri_map(0x01006000);
+ if (tlmm_qup2) {
+  ri_wr(tlmm_qup2, 0x0000, 8);
+  ri_wr(tlmm_qup2, 0x1000, 8);
+ }
+
+ vm_offset_t spmi_core = ri_map(0x0200f000);
+ if (spmi_core) {
+  vm_offset_t ch_rst = ri_spmi_chnl(spmi_core, 0x2c7);
+  if (ch_rst) {
+   ri_spmi_write(ch_rst, 0x40, 1);
+   ri_spmi_write(ch_rst, 0x41, 0);
+   ri_spmi_write(ch_rst, 0x42, 1);
+   ri_spmi_write(ch_rst, 0x46, 0x80);
+   delay(5000);
+  }
+ }
+
+ ri_qup2 = ri_map(0x078b6000);
+ if (!ri_qup2) {
+  printf("RIVER HAPTICS: failed to map QUP2 MMIO\n");
+  return;
+ }
+
+ ri_wr(ri_qup2, 0xc, 1); delay(100);
+ if (!ri_qup_state(ri_qup2, 0)) { printf("RIVER HAPTICS: QUP2 reset timeout\n"); return; }
+ ri_wr(ri_qup2, 0, 0x207); ri_wr(ri_qup2, 0x408, 1);
+ ri_wr(ri_qup2, 0x20, 0); ri_wr(ri_qup2, 0x28, 0x300);
+
+ uint8_t chipid = 0;
+ for (unsigned t = 0; t < 5; t++) {
+  if (ri_aw_rd(0x00, &chipid) && chipid == 0x91) break;
+  delay(2000);
+ }
+ if (chipid != 0x91) {
+  printf("RIVER HAPTICS: AW8691 probe failed (read %#x, expected 0x91)\n", chipid);
+  return;
+ }
+ printf("RIVER HAPTICS: AW8691 haptic driver IC detected (chip ID 0x%02x) on I2C QUP2 (0x5b)\n", chipid);
+
+ ri_aw_wr(0x04, 0x01);
+ delay(1000);
+ ri_aw_wr(0x36, 0x01);
+ ri_aw_wr(0x34, 0x38);
+ ri_aw_wr(0x39, 0x20);
+
+ ri_aw_wr(0x04, 0x21);
+ delay(1000);
+ ri_aw_wr(0x21, 0x10);
+ ri_aw_wr(0x22, 0x00);
+ ri_aw_wr(0x23, 0x04);
+ ri_aw_wr(0x24, 0x00);
+ ri_aw_wr(0x25, 0x0c);
+ ri_aw_wr(0x26, 0x00);
+ ri_aw_wr(0x40, 0x10);
+ ri_aw_wr(0x41, 0x00);
+ for (unsigned i = 0; i < sizeof(ri_aw869x_fw); i++) {
+  ri_aw_wr(0x42, ri_aw869x_fw[i]);
+ }
+ ri_aw_wr(0x04, 0x01);
+
+ ri_haptics_ok = true;
+ printf("RIVER HAPTICS: AW8691 initialized with Motorola haptic waveform table (ready)\n");
+}
+
+void
+river_vibrate(unsigned ms)
+{
+ if (!ri_haptics_ok || !ri_qup2) return;
+ if (ms == 0) {
+  ri_aw_wr(0x04, 0x01);
+  ri_vib_deadline = 0;
+  return;
+ }
+ ri_aw_wr(0x07, 0x01);
+ ri_aw_wr(0x08, 0x00);
+ ri_aw_wr(0x39, ms > 50 ? 0x28 : 0x20);
+ ri_aw_wr(0x04, 0x20);
+ ri_aw_wr(0x02, 0xff);
+ ri_aw_wr(0x05, 0x01);
+
+ uint64_t dur_mat = 0;
+ nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &dur_mat);
+ ri_vib_deadline = mach_absolute_time() + dur_mat;
+}
+
+static int
+river_vibrate_sysctl SYSCTL_HANDLER_ARGS
+{
+ int val = 0, error;
+ error = sysctl_handle_int(oidp, &val, 0, req);
+ if (error || !req->newptr) return error;
+ river_vibrate((unsigned)val);
+ return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_vibrate, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+            NULL, 0, river_vibrate_sysctl, "I", "River haptic vibrate");
