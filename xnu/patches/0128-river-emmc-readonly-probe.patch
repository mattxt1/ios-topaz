+/*
+ * river (Moto G7, SDM632) eMMC: READ-ONLY polled driver for the SDHCI-MSM
+ * host sdhc_1. Boot-arg rivermmc=1 enables it; otherwise nothing is mapped.
+ *
+ * ABL hands over the host in legacy MCI mode (HC_MODE_EN clear, photo
+ * IMG_0326), so this driver initialises it as Linux's sdhci-msm does, in the
+ * simplest mode: SDHCI mode, software reset, the MSM power-control
+ * handshake acknowledged (regulators are already on from ABL and are not
+ * touched), GCC sdcc1_apps at 400 kHz from XO (the MSM host has no SDHCI
+ * divider), 1.8 V signalling, 1-bit bus, default timing, PIO, no DMA and no
+ * interrupts. It then enumerates the card with CMD0/1/2/3/7.
+ *
+ * Read-only by construction: river_emmc_cmd() accepts only CMD0 GO_IDLE,
+ * CMD1 SEND_OP_COND, CMD2 ALL_SEND_CID, CMD3 SET_RELATIVE_ADDR, CMD7
+ * SELECT_CARD, CMD13 SEND_STATUS and CMD17 READ_SINGLE_BLOCK, and panics on
+ * any other index. No write, erase, lock, switch (CMD6) or programming
+ * command can reach the eMMC from this file. The probe reads the protective
+ * MBR, both GPT headers and the partition table, and checks that boot_b
+ * starts with ANDROID!. Addresses come from the ADT node /river-emmc.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(RIVER)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void delay(int usec);
+
+/* SD Host Controller Simplified Spec 3.0 register offsets (32-bit access) */
+#define SDHCI_BLOCK		0x04	/* block size | block count << 16 */
+#define SDHCI_ARG		0x08
+#define SDHCI_XFER_CMD		0x0c	/* transfer mode | command << 16 */
+#define SDHCI_RESP0		0x10
+#define SDHCI_BUFFER		0x20
+#define SDHCI_PRESENT		0x24
+#define SDHCI_HOST_CTRL		0x28	/* host ctl1 | power << 8 | gap | wakeup */
+#define SDHCI_CLOCK		0x2c	/* clock | timeout << 16 | reset << 24 */
+#define SDHCI_INT_STATUS	0x30	/* normal | error << 16, write 1 to clear */
+#define SDHCI_INT_ENABLE	0x34
+#define SDHCI_SIGNAL_ENABLE	0x38
+#define SDHCI_HOST_CTRL2	0x3c	/* auto-cmd status | host ctl2 << 16 */
+#define SDHCI_CAPS		0x40
+#define SDHCI_VERSION		0xfc	/* slot int status | version << 16 */
+
+#define PRESENT_CMD_INHIBIT	(1U << 0)
+#define PRESENT_DAT_INHIBIT	(1U << 1)
+#define PRESENT_CARD		(1U << 16)
+#define INT_CMD_DONE		(1U << 0)
+#define INT_XFER_DONE		(1U << 1)
+#define INT_READ_READY		(1U << 5)
+#define INT_ERROR		(1U << 15)
+#define RESET_ALL		(1U << 24)
+#define RESET_CMD		(1U << 25)
+#define RESET_DAT		(1U << 26)
+#define CLOCK_INT_ENABLE	(1U << 0)
+#define CLOCK_INT_STABLE	(1U << 1)
+#define CLOCK_SD_ENABLE		(1U << 2)
+#define POWER_ON_3V0		((0x6U << 1 | 1U) << 8)	/* 3.0 V select + bus power */
+#define CTRL2_1V8		(1U << (16 + 3))
+
+/* command register flags: response type, CRC check, index check, data */
+#define RSP_NONE		0x00
+#define RSP_136			0x09	/* R2: 136 bit, CRC */
+#define RSP_R3			0x02	/* 48 bit, no checks */
+#define RSP_R1			0x1a	/* 48 bit, CRC + index */
+#define RSP_R1B			0x1b	/* 48 bit busy, CRC + index */
+#define CMD_DATA		0x20
+#define XFER_READ		0x10
+
+/* sdhci-msm core_mem (MCI variant) */
+#define MSM_HC_MODE		0x78
+#define MSM_HC_MODE_EN		(1U << 0)
+#define MSM_FF_CLK_SW_RST_DIS	(1U << 13)
+#define MSM_MCI_VERSION		0x50
+#define MSM_PWRCTL_STATUS	0xdc
+#define MSM_PWRCTL_MASK		0xe0
+#define MSM_PWRCTL_CLEAR	0xe4
+#define MSM_PWRCTL_CTL		0xe8
+#define PWRCTL_BUS_OFF		(1U << 0)
+#define PWRCTL_BUS_ON		(1U << 1)
+#define PWRCTL_IO_LOW		(1U << 2)
+#define PWRCTL_IO_HIGH		(1U << 3)
+/* sdhci-msm vendor registers in hc_mem (MCI variant offsets) */
+#define MSM_VENDOR_SPEC		0x10c
+#define MSM_VENDOR_SPEC_POR	0xa9c	/* default MCLK select, HC_SELECT_IN off */
+#define MSM_VENDOR_SPEC3	0x1b0
+#define MSM_PWRSAVE_DLL		(1U << 3)
+#define MSM_DLL_CONFIG		0x100	/* core_mem */
+#define PWRCTL_BUS_SUCCESS	(1U << 0)
+#define PWRCTL_IO_SUCCESS	(1U << 2)
+
+/* GCC page 0x1842000: sdcc1_apps RCG2 and branches (gcc-msm8953.c) */
+#define GCC_RCG_CMD		0x004
+#define GCC_RCG_CFG		0x008
+#define GCC_RCG_M		0x00c
+#define GCC_RCG_N		0x010
+#define GCC_RCG_D		0x014
+#define GCC_APPS_CBCR		0x018
+#define GCC_AHB_CBCR		0x01c
+#define CBCR_CLK_OFF		(1U << 31)
+#define RCG_UPDATE		(1U << 0)
+/* 400 kHz = XO 19.2 MHz / 12 * 1/4: div field 2*12-1, src XO (0), dual edge */
+#define RCG_CFG_400K		(23U | 0U << 8 | 2U << 12)
+/* 25 MHz = GPLL0_DIV2 400 MHz / 16, no M/N (bypass): default-speed eMMC */
+#define RCG_CFG_25M		(31U | 4U << 8)
+
+#define TIMEOUT_NS		(200ULL * NSEC_PER_MSEC)
+#define BLOCK			512
+#define RCA			1
+
+static vm_offset_t hc, core, gcc;
+static bool ready;
+static uint32_t block[BLOCK / 4];
+
+/* minor 0 = whole user area, minor N = GPT entry N (1-based); count 0 = none */
+#define MAX_PARTS		129
+static struct {
+	uint64_t first, count;
+	uint32_t secsize;
+} parts[MAX_PARTS];
+static int bmajor = -1, cmajor = -1;
+static LCK_GRP_DECLARE(river_emmc_grp, "river_emmc");
+static LCK_MTX_DECLARE(river_emmc_lock, &river_emmc_grp);
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint64_t
+deadline(uint64_t ns)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(ns, &t);
+	return mach_absolute_time() + t;
+}
+
+/*
+ * Acknowledge MSM power-control requests raised by power/voltage/reset
+ * writes. The supplies stay as ABL left them, so every request succeeds.
+ * Polls up to `ms` for a request; returns the request bits seen.
+ */
+static uint32_t
+river_emmc_pwrctl(unsigned ms)
+{
+	uint64_t end = deadline((uint64_t)ms * NSEC_PER_MSEC);
+	uint32_t seen = 0;
+	do {
+		uint32_t st = rd(core, MSM_PWRCTL_STATUS) & 0xf;
+		if (st) {
+			wr(core, MSM_PWRCTL_CLEAR, st);
+			for (int i = 0; i < 10 && (rd(core, MSM_PWRCTL_STATUS) & st); i++) {
+				delay(10);
+				wr(core, MSM_PWRCTL_CLEAR, st);
+			}
+			uint32_t ack = 0;
+			if (st & (PWRCTL_BUS_ON | PWRCTL_BUS_OFF)) {
+				ack |= PWRCTL_BUS_SUCCESS;
+			}
+			if (st & (PWRCTL_IO_LOW | PWRCTL_IO_HIGH)) {
+				ack |= PWRCTL_IO_SUCCESS;
+			}
+			wr(core, MSM_PWRCTL_CTL, ack);
+			seen |= st;
+		}
+	} while (mach_absolute_time() < end);
+	return seen;
+}
+
+/* Wait for any of `bits` in the normal status; 0, or EIO/ETIMEDOUT. */
+static int
+river_emmc_wait(uint32_t bits, uint32_t *status)
+{
+	uint64_t end = deadline(TIMEOUT_NS);
+	for (;;) {
+		uint32_t s = rd(hc, SDHCI_INT_STATUS);
+		if (s & INT_ERROR) {
+			*status = s;
+			return EIO;
+		}
+		if (s & bits) {
+			*status = s;
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			*status = s;
+			return ETIMEDOUT;
+		}
+	}
+}
+
+static int
+river_emmc_reset(uint32_t which)
+{
+	uint32_t c = rd(hc, SDHCI_CLOCK) & 0x00ffffff;
+	wr(hc, SDHCI_CLOCK, c | which);
+	uint64_t end = deadline(TIMEOUT_NS);
+	while (rd(hc, SDHCI_CLOCK) & which) {
+		/* A full reset raises BUS_OFF on MSM and waits for the ack. */
+		river_emmc_pwrctl(0);
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	wr(hc, SDHCI_INT_STATUS, 0xffffffff);
+	return 0;
+}
+
+/*
+ * The only way this file talks to the card. Read-only by construction:
+ * identification/selection, status, and single-block reads into `buf`.
+ */
+static int
+river_emmc_cmd(uint32_t index, uint32_t arg, uint32_t rsp, uint32_t *resp, uint32_t *buf)
+{
+	switch (index) {
+	case 0: case 1: case 2: case 3: case 7: case 13: case 17:
+		break;
+	default:
+		panic("river eMMC: refusing CMD%u (read-only driver)", index);
+	}
+	bool data = index == 17;
+	uint32_t inhibit = PRESENT_CMD_INHIBIT | (data || rsp == RSP_R1B ? PRESENT_DAT_INHIBIT : 0);
+	uint64_t end = deadline(TIMEOUT_NS);
+	while (rd(hc, SDHCI_PRESENT) & inhibit) {
+		if (mach_absolute_time() > end) {
+			return EBUSY;
+		}
+	}
+	wr(hc, SDHCI_INT_STATUS, 0xffffffff);
+	if (data) {
+		wr(hc, SDHCI_BLOCK, (1U << 16) | BLOCK);
+	}
+	wr(hc, SDHCI_ARG, arg);
+	uint32_t cmd = index << 8 | rsp | (data ? CMD_DATA : 0);
+	wr(hc, SDHCI_XFER_CMD, cmd << 16 | (data ? XFER_READ : 0));
+
+	uint32_t status;
+	int error = river_emmc_wait(INT_CMD_DONE, &status);
+	if (error) {
+		printf("RIVER eMMC: CMD%u arg 0x%x %s, status 0x%08x\n", index, arg,
+		    error == EIO ? "error" : "timeout", status);
+		river_emmc_reset(RESET_CMD | RESET_DAT);
+		return error;
+	}
+	for (int i = 0; resp && i < (rsp == RSP_136 ? 4 : 1); i++) {
+		resp[i] = rd(hc, SDHCI_RESP0 + 4 * i);
+	}
+	wr(hc, SDHCI_INT_STATUS, INT_CMD_DONE);
+	if (rsp == RSP_R1B) {
+		(void)river_emmc_wait(INT_XFER_DONE, &status);	/* end of busy */
+		wr(hc, SDHCI_INT_STATUS, 0xffffffff);
+	}
+	if (!data) {
+		return 0;
+	}
+	error = river_emmc_wait(INT_READ_READY, &status);
+	if (!error) {
+		wr(hc, SDHCI_INT_STATUS, INT_READ_READY);
+		for (int i = 0; i < BLOCK / 4; i++) {
+			buf[i] = rd(hc, SDHCI_BUFFER);
+		}
+		error = river_emmc_wait(INT_XFER_DONE, &status);
+	}
+	if (error) {
+		printf("RIVER eMMC: CMD17 LBA 0x%x data %s, status 0x%08x\n", arg,
+		    error == EIO ? "error" : "timeout", status);
+		river_emmc_reset(RESET_CMD | RESET_DAT);
+		return error;
+	}
+	wr(hc, SDHCI_INT_STATUS, 0xffffffff);
+	return 0;
+}
+
+/* Read one 512-byte block (sector addressing: >2 GB eMMC). */
+int river_emmc_read_block(uint64_t lba, void *dst);
+int
+river_emmc_read_block(uint64_t lba, void *dst)
+{
+	uint32_t resp;
+	if (!ready || lba >> 32) {
+		return ENXIO;
+	}
+	return river_emmc_cmd(17, (uint32_t)lba, RSP_R1, &resp, (uint32_t *)dst);
+}
+
+/* Reprogram GCC sdcc1_apps_clk_src; the branch stays enabled. */
+static int
+river_emmc_set_rcg(uint32_t cfg, bool mnd)
+{
+	if (mnd) {	/* only the 400 kHz XO rate uses M/N: 1/4 */
+		wr(gcc, GCC_RCG_M, 1);
+		wr(gcc, GCC_RCG_N, ~(4U - 1U) & 0xff);
+		wr(gcc, GCC_RCG_D, ~4U & 0xff);
+	}
+	wr(gcc, GCC_RCG_CFG, cfg);
+	wr(gcc, GCC_RCG_CMD, rd(gcc, GCC_RCG_CMD) | RCG_UPDATE);
+	uint64_t end = deadline(TIMEOUT_NS);
+	while (rd(gcc, GCC_RCG_CMD) & RCG_UPDATE) {
+		if (mach_absolute_time() > end) {
+			printf("RIVER eMMC: RCG update stuck, cmd 0x%x\n", rd(gcc, GCC_RCG_CMD));
+			return ETIMEDOUT;
+		}
+	}
+	printf("RIVER eMMC: sdcc1_apps RCG now cmd 0x%x cfg 0x%x m 0x%x n 0x%x d 0x%x, CBCR 0x%x\n",
+	    rd(gcc, GCC_RCG_CMD), rd(gcc, GCC_RCG_CFG), rd(gcc, GCC_RCG_M),
+	    rd(gcc, GCC_RCG_N), rd(gcc, GCC_RCG_D), rd(gcc, GCC_APPS_CBCR));
+	return 0;
+}
+
+static int
+river_emmc_clock_400k(void)
+{
+	printf("RIVER eMMC: sdcc1_apps RCG was cmd 0x%x cfg 0x%x m 0x%x n 0x%x d 0x%x\n",
+	    rd(gcc, GCC_RCG_CMD), rd(gcc, GCC_RCG_CFG), rd(gcc, GCC_RCG_M),
+	    rd(gcc, GCC_RCG_N), rd(gcc, GCC_RCG_D));
+	return river_emmc_set_rcg(RCG_CFG_400K, true);
+}
+
+/*
+ * Change the card clock with the SD clock gated, as sdhci does. The MSM
+ * host has no SDHCI divider, so the GCC rate is the card clock.
+ */
+static int
+river_emmc_card_clock(uint32_t cfg, bool mnd)
+{
+	wr(hc, SDHCI_CLOCK, 0xe << 16 | CLOCK_INT_ENABLE);
+	int error = river_emmc_set_rcg(cfg, mnd);
+	uint64_t end = deadline(TIMEOUT_NS);
+	while (!(rd(hc, SDHCI_CLOCK) & CLOCK_INT_STABLE)) {
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	wr(hc, SDHCI_CLOCK, 0xe << 16 | CLOCK_INT_ENABLE | CLOCK_SD_ENABLE);
+	delay(100);
+	return error;
+}
+
+/* 25 MHz default speed (1-bit, no CMD6); back to 400 kHz if CMD13 fails. */
+static bool
+river_emmc_speed_up(void)
+{
+	uint32_t r;
+	if (!river_emmc_card_clock(RCG_CFG_25M, false) &&
+	    !river_emmc_cmd(13, RCA << 16, RSP_R1, &r, NULL) && ((r >> 9) & 0xf) == 4) {
+		printf("RIVER eMMC: 25 MHz default speed, 1-bit\n");
+		return true;
+	}
+	printf("RIVER eMMC: 25 MHz failed; back to 400 kHz\n");
+	(void)river_emmc_card_clock(RCG_CFG_400K, true);
+	return false;
+}
+
+static int
+river_emmc_host_init(void)
+{
+	uint32_t mode = rd(core, MSM_HC_MODE);
+	printf("RIVER eMMC: MCI version 0x%08x, HC_MODE 0x%x -> SDHCI mode\n",
+	    rd(core, MSM_MCI_VERSION), mode);
+	wr(core, MSM_HC_MODE, MSM_HC_MODE_EN);
+	wr(core, MSM_HC_MODE, rd(core, MSM_HC_MODE) | MSM_FF_CLK_SW_RST_DIS);
+	wr(core, MSM_PWRCTL_MASK, 0xf);
+	/*
+	 * ABL ran HS400 (sdcc1_apps at 384 MHz, IMG_0327): the MCLK select and
+	 * HC_SELECT_IN may still route the divided DLL clock. Return the vendor
+	 * registers to Linux's probe/default-mode state before the GCC rate
+	 * drops, as sdhci-msm does (POR value, power-save DLL off).
+	 */
+	printf("RIVER eMMC: vendor_spec 0x%08x spec3 0x%08x dll_config 0x%08x\n",
+	    rd(hc, MSM_VENDOR_SPEC), rd(hc, MSM_VENDOR_SPEC3), rd(core, MSM_DLL_CONFIG));
+	wr(hc, MSM_VENDOR_SPEC, MSM_VENDOR_SPEC_POR);
+	wr(hc, MSM_VENDOR_SPEC3, rd(hc, MSM_VENDOR_SPEC3) & ~MSM_PWRSAVE_DLL);
+	printf("RIVER eMMC: SDHCI v%u caps 0x%08x present 0x%08x\n",
+	    (rd(hc, SDHCI_VERSION) >> 16) & 0xff, rd(hc, SDHCI_CAPS), rd(hc, SDHCI_PRESENT));
+
+	if (river_emmc_reset(RESET_ALL)) {
+		printf("RIVER eMMC: host reset timed out\n");
+		return ETIMEDOUT;
+	}
+	uint32_t p = river_emmc_pwrctl(5);
+	if (river_emmc_clock_400k()) {
+		return ETIMEDOUT;
+	}
+	/* 1.8 V signalling (eMMC VCCQ), then bus power; ack both requests,
+	 * then the clocks (power before clock, as the MMC core does). */
+	wr(hc, SDHCI_HOST_CTRL2, CTRL2_1V8);
+	p |= river_emmc_pwrctl(5);
+	wr(hc, SDHCI_HOST_CTRL, POWER_ON_3V0);	/* 1-bit, default speed, SDMA select 0 */
+	p |= river_emmc_pwrctl(10);
+	/* Internal clock on, wait stable, then the card clock (no divider on MSM). */
+	wr(hc, SDHCI_CLOCK, 0xe << 16 | CLOCK_INT_ENABLE);
+	uint64_t end = deadline(TIMEOUT_NS);
+	while (!(rd(hc, SDHCI_CLOCK) & CLOCK_INT_STABLE)) {
+		if (mach_absolute_time() > end) {
+			printf("RIVER eMMC: internal clock not stable\n");
+			return ETIMEDOUT;
+		}
+	}
+	wr(hc, SDHCI_CLOCK, 0xe << 16 | CLOCK_INT_ENABLE | CLOCK_SD_ENABLE);
+	wr(hc, SDHCI_SIGNAL_ENABLE, 0);
+	wr(hc, SDHCI_INT_ENABLE, 0x03ff00ff);
+	printf("RIVER eMMC: pwrctl 0x%x acked; host 0x%08x clock 0x%08x\n",
+	    p, rd(hc, SDHCI_HOST_CTRL), rd(hc, SDHCI_CLOCK));
+	printf("RIVER eMMC: ctrl2 0x%08x present 0x%08x vendor_spec 0x%08x\n",
+	    rd(hc, SDHCI_HOST_CTRL2), rd(hc, SDHCI_PRESENT), rd(hc, MSM_VENDOR_SPEC));
+	delay(2000);	/* >= 1 ms and 74 card clocks before CMD0 */
+	return 0;
+}
+
+static int
+river_emmc_card_init(void)
+{
+	uint32_t r[4] = { 0 };
+
+	/* CMD0, then CMD1 until ready (sector mode, 2.7-3.6 V and 1.70-1.95 V
+	 * windows); one more CMD0 if the card does not answer at all. */
+	int error = EIO;
+	for (int attempt = 0; attempt < 2 && error; attempt++) {
+		(void)river_emmc_cmd(0, 0, RSP_NONE, NULL, NULL);
+		delay(1000);
+		uint64_t end = deadline(1000ULL * NSEC_PER_MSEC);
+		do {
+			error = river_emmc_cmd(1, 0x40ff8080, RSP_R3, r, NULL);
+			if (error || (r[0] & (1U << 31))) {
+				break;
+			}
+			delay(1000);
+		} while (mach_absolute_time() < end);
+	}
+	if (error) {
+		return EIO;
+	}
+	printf("RIVER eMMC: OCR 0x%08x%s\n", r[0],
+	    (r[0] & (1U << 31)) ? ((r[0] & (1U << 30)) ? " ready, sector mode" : " ready, byte mode") : " NOT ready");
+	if (!(r[0] & (1U << 31)) || !(r[0] & (1U << 30))) {
+		return EIO;
+	}
+	if (river_emmc_cmd(2, 0, RSP_136, r, NULL)) {
+		return EIO;
+	}
+	/* R2 in RESP0-3 is CID[127:8]; product name is CID[103:56]. */
+	char pnm[7];
+	uint8_t const *c = (uint8_t const *)r;	/* little endian: byte i = CID bits 8i+8.. */
+	for (int i = 0; i < 6; i++) {
+		pnm[i] = (char)c[11 - i];
+	}
+	pnm[6] = 0;
+	for (int i = 0; i < 6; i++) {
+		if (pnm[i] < 0x20 || pnm[i] > 0x7e) {
+			pnm[i] = '?';
+		}
+	}
+	printf("RIVER eMMC: CID manufacturer 0x%02x product \"%s\"\n", c[14], pnm);
+	if (river_emmc_cmd(3, RCA << 16, RSP_R1, r, NULL) ||
+	    river_emmc_cmd(7, RCA << 16, RSP_R1B, r, NULL) ||
+	    river_emmc_cmd(13, RCA << 16, RSP_R1, r, NULL)) {
+		return EIO;
+	}
+	printf("RIVER eMMC: selected RCA %u, status 0x%08x (state %u, 4 = tran)\n",
+	    RCA, r[0], (r[0] >> 9) & 0xf);
+	return ((r[0] >> 9) & 0xf) == 4 ? 0 : EIO;
+}
+
+static uint64_t
+le64(const uint8_t *b)
+{
+	uint64_t v = 0;
+	for (int i = 7; i >= 0; i--) {
+		v = v << 8 | b[i];
+	}
+	return v;
+}
+
+static uint32_t
+le32(const uint8_t *b)
+{
+	return (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+}
+
+/* GPT entry name (UTF-16LE) to ASCII. */
+static void
+gpt_name(const uint8_t *e, char *out, size_t n)
+{
+	size_t i;
+	for (i = 0; i + 1 < n && i < 36 && e[56 + 2 * i]; i++) {
+		out[i] = (char)e[56 + 2 * i];
+	}
+	out[i] = 0;
+}
+
+static int
+river_emmc_gpt(void)
+{
+	uint8_t *b = (uint8_t *)block;
+	char name[40];
+
+	if (river_emmc_read_block(0, b) || b[510] != 0x55 || b[511] != 0xaa || b[450] != 0xee) {
+		printf("RIVER eMMC: LBA 0 is not a protective MBR\n");
+		return EIO;
+	}
+	if (river_emmc_read_block(1, b) || memcmp(b, "EFI PART", 8)) {
+		printf("RIVER eMMC: no primary GPT header at LBA 1\n");
+		return EIO;
+	}
+	uint64_t backup = le64(b + 32), last_usable = le64(b + 48), entries = le64(b + 72);
+	uint32_t count = le32(b + 80), esize = le32(b + 84);
+	printf("RIVER eMMC: GPT %u entries of %u bytes at LBA %llu; last LBA %llu (%llu MiB)\n",
+	    count, esize, entries, backup, (backup + 1) >> 11);
+	if (esize != 128 || count == 0 || count >= MAX_PARTS) {
+		return EIO;
+	}
+	parts[0].first = 0;
+	parts[0].count = backup + 1;
+	if (river_emmc_read_block(backup, b) || memcmp(b, "EFI PART", 8)) {
+		printf("RIVER eMMC: backup GPT header at LBA %llu missing\n", backup);
+	} else {
+		printf("RIVER eMMC: backup GPT header OK at LBA %llu\n", backup);
+	}
+
+	uint32_t used = 0;
+	uint64_t boot_b = 0;
+	for (uint32_t i = 0; i < count; i++) {
+		if (i % 4 == 0 && river_emmc_read_block(entries + i / 4, b)) {
+			return EIO;
+		}
+		const uint8_t *e = b + (i % 4) * 128;
+		uint64_t first = le64(e + 32), last = le64(e + 40);
+		if (!first || last < first || last > last_usable) {
+			continue;
+		}
+		used++;
+		parts[i + 1].first = first;
+		parts[i + 1].count = last - first + 1;
+		gpt_name(e, name, sizeof(name));
+		if (!strcmp(name, "boot_b")) {
+			boot_b = first;
+		}
+		if (!strcmp(name, "boot_a") || !strcmp(name, "boot_b") ||
+		    !strcmp(name, "system_b") || !strcmp(name, "vendor_b") ||
+		    !strcmp(name, "userdata") || i < 2) {
+			printf("RIVER eMMC: p%u %-10s LBA %llu +%llu MiB\n", i + 1, name,
+			    first, (last - first + 1) >> 11);
+		}
+	}
+	printf("RIVER eMMC: %u partitions\n", used);
+	if (boot_b && !river_emmc_read_block(boot_b, b)) {
+		printf("RIVER eMMC: boot_b starts with %s\n",
+		    memcmp(b, "ANDROID!", 8) ? "something else" : "ANDROID! (header v1 found)");
+	}
+	return 0;
+}
+
+/*
+ * Read-only BSD disk: /dev/emmc0 + /dev/remmc0 (whole user area) and
+ * /dev/emmc0sN + /dev/remmc0sN for GPT entry N. Opens for writing and every
+ * write request fail with EROFS; only river_emmc_read_block() touches the
+ * card, through river_emmc_cmd()'s read-only command list.
+ */
+static int
+river_emmc_open(dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	int m = minor(dev);
+	if (!ready || m < 0 || m >= MAX_PARTS || !parts[m].count) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+river_emmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+river_emmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	int m = minor(buf_device(bp));
+	uint32_t count = buf_count(bp);
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (!ready || m < 0 || m >= MAX_PARTS || !parts[m].count) {
+		error = ENXIO;
+		goto done;
+	}
+	uint64_t off = (uint64_t)buf_blkno(bp) * parts[m].secsize;
+	uint64_t bytes = parts[m].count * BLOCK;
+	if (off > bytes || count > bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+	/*
+	 * physio() on /dev/remmc0* hands over the caller's own (wired) user
+	 * address, and strategy runs in that thread: copy out to it. Storing
+	 * to it directly is a kernel data abort (IMG_0330).
+	 */
+	bool user = (buf_flags(bp) & B_PHYS) && (vm_offset_t)vaddr < VM_MIN_KERNEL_ADDRESS;
+	lck_mtx_lock(&river_emmc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % BLOCK);
+		uint32_t want = MIN(count - done, BLOCK - skip);
+		error = river_emmc_read_block(parts[m].first + pos / BLOCK, block);
+		if (error) {
+			break;
+		}
+		if (user) {
+			error = copyout((const char *)block + skip,
+			    (user_addr_t)(uintptr_t)(vaddr + done), want);
+			if (error) {
+				break;
+			}
+		} else {
+			memcpy(vaddr + done, (const char *)block + skip, want);
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&river_emmc_lock);
+	buf_unmap(bp);
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+river_emmc_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	int m = minor(dev);
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	if (m < 0 || m >= MAX_PARTS || !parts[m].count) {
+		return ENXIO;
+	}
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = parts[m].secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > 4096 || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		parts[m].secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = parts[m].count * BLOCK / parts[m].secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = (128 * 1024) / parts[m].secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+river_emmc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return river_emmc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+river_emmc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return river_emmc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+/*
+ * Despite the name, specfs's set_blocksize() takes d_psize as the vnode's
+ * block size (memdev.c returns its sector size too). Returning the
+ * partition length made /dev/emmc0s42 reads fail (IMG_0333).
+ */
+static int
+river_emmc_psize(dev_t dev)
+{
+	int m = minor(dev);
+	if (!ready || m < 0 || m >= MAX_PARTS || !parts[m].count) {
+		return -1;
+	}
+	return (int)parts[m].secsize;
+}
+
+static int
+river_emmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int m = minor(dev);
+	if (m < 0 || m >= MAX_PARTS || !parts[m].count) {
+		return ENXIO;
+	}
+	return physio(river_emmc_strategy, NULL, dev, B_READ, minphys, uio, (int)parts[m].secsize);
+}
+
+static int
+river_emmc_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw river_emmc_bdevsw = {
+	.d_open     = river_emmc_open,
+	.d_close    = river_emmc_close,
+	.d_strategy = river_emmc_strategy,
+	.d_ioctl    = river_emmc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = river_emmc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw river_emmc_cdevsw = {
+	.d_open       = river_emmc_open,
+	.d_close      = river_emmc_close,
+	.d_read       = river_emmc_read,
+	.d_write      = river_emmc_write,
+	.d_ioctl      = river_emmc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static void
+river_emmc_devices(void)
+{
+	bmajor = bdevsw_add(-1, &river_emmc_bdevsw);
+	if (bmajor < 0) {
+		printf("RIVER eMMC: no block major\n");
+		return;
+	}
+	cmajor = cdevsw_add_with_bdev(-1, &river_emmc_cdevsw, bmajor);
+	if (cmajor < 0) {
+		printf("RIVER eMMC: no char major\n");
+		return;
+	}
+	uint32_t n = 0;
+	for (int m = 0; m < MAX_PARTS; m++) {
+		if (!parts[m].count) {
+			continue;
+		}
+		parts[m].secsize = BLOCK;
+		if (m == 0) {
+			devfs_make_node(makedev(bmajor, 0), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0440, "emmc0");
+			devfs_make_node(makedev(cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0440, "remmc0");
+		} else {
+			devfs_make_node(makedev(bmajor, m), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0440, "emmc0s%d", m);
+			devfs_make_node(makedev(cmajor, m), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0440, "remmc0s%d", m);
+			n++;
+		}
+	}
+	printf("RIVER eMMC: read-only /dev/emmc0, /dev/remmc0 and %u partitions (b %d, c %d)\n",
+	    n, bmajor, cmajor);
+}
+
+/* Root device for rd=emmc0sN (IOFindBSDRoot); read-only like every node. */
+int river_emmc_rootdev(const char *name, dev_t *dev);
+int
+river_emmc_rootdev(const char *name, dev_t *dev)
+{
+	int n = 0;
+	const char *p = name + 6;	/* after "emmc0s" */
+	if (!*p) {
+		return EINVAL;
+	}
+	for (; *p; p++) {
+		if (*p < '0' || *p > '9' || n >= MAX_PARTS) {
+			return EINVAL;
+		}
+		n = n * 10 + (*p - '0');
+	}
+	if (!ready || bmajor < 0 || n <= 0 || n >= MAX_PARTS || !parts[n].count) {
+		return ENXIO;
+	}
+	*dev = makedev(bmajor, n);
+	return 0;
+}
+
+/* Time 1 MiB of single-block reads from boot_b (p42). */
+static void
+river_emmc_bench(void)
+{
+	if (!parts[42].count) {
+		return;
+	}
+	uint64_t t0 = mach_absolute_time(), ns;
+	for (uint32_t i = 0; i < 2048; i++) {
+		if (river_emmc_read_block(parts[42].first + i, block)) {
+			printf("RIVER eMMC: bench read %u failed\n", i);
+			return;
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("RIVER eMMC: 1 MiB in %llu ms (%llu KiB/s)\n", ns / NSEC_PER_MSEC,
+	    ns ? 1024ULL * NSEC_PER_SEC / ns : 0);
+}
+
+void river_emmc_probe(void);
+void
+river_emmc_probe(void)
+{
+	uint32_t on = 0;
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+
+	if (!PE_parse_boot_argn("rivermmc", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/river-emmc", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 6 * sizeof(uint64_t)) {
+		printf("RIVER eMMC: no /river-emmc node\n");
+		return;
+	}
+	/* reg = <hc size> <core size> <gcc sdcc1 page, size> (absolute PAs) */
+	gcc = ml_io_map(reg[4], reg[5]);
+	uint32_t apps = rd(gcc, GCC_APPS_CBCR), ahb = rd(gcc, GCC_AHB_CBCR);
+	printf("RIVER eMMC: GCC SDCC1 apps CBCR 0x%08x, ahb CBCR 0x%08x\n", apps, ahb);
+	if ((apps | ahb) & CBCR_CLK_OFF) {
+		printf("RIVER eMMC: SDCC1 clocks are off; not touching the host\n");
+		return;
+	}
+	core = ml_io_map(reg[2], reg[3]);
+	hc = ml_io_map(reg[0], reg[1]);
+	if (river_emmc_host_init() || river_emmc_card_init()) {
+		printf("RIVER eMMC: init failed; host left idle\n");
+		return;
+	}
+	ready = true;
+	if (river_emmc_gpt()) {
+		printf("RIVER eMMC: GPT read failed\n");
+		ready = false;
+		return;
+	}
+	if (river_emmc_speed_up()) {
+		river_emmc_bench();
+	}
+	river_emmc_devices();
+	printf("RIVER eMMC: read-only probe done\n");
+}
