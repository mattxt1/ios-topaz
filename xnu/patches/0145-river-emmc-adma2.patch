+/*
+ * ADMA2 for multi-block reads (boot-arg rivermmcdma=0 disables). Requires the
+ * capability bit, a contiguous buffer below 4 GiB, and 64 blocks of boot_b
+ * read by DMA matching single-block PIO reads.
+ */
+static void
+river_emmc_dma_init(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("rivermmcdma", &on, sizeof(on));
+	uint32_t caps = rd(hc, SDHCI_CAPS);
+	if (!on || !multi_ok || !(caps & (1U << 19)) || !parts[42].count) {
+		printf("RIVER eMMC: ADMA2 not used (arg %u, multi %d, caps 0x%08x)\n", on, multi_ok, caps);
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &adma_va, ADMA_DATA + PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("RIVER eMMC: no ADMA2 memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)adma_va);
+	adma_pa = pn ? ptoa_64(pn) : 0;
+	if (!adma_pa || adma_pa + ADMA_DATA + PAGE_SIZE > (1ULL << 32)) {
+		printf("RIVER eMMC: ADMA2 buffer at 0x%llx unusable\n", adma_pa);
+		return;
+	}
+	host_ctrl |= CTRL_ADMA2_32;
+	wr(hc, SDHCI_HOST_CTRL, host_ctrl);
+	adma_ok = true;
+	bool same = !river_emmc_read_multi(parts[42].first, 64, mblock);
+	for (uint32_t i = 0; same && i < 64; i++) {
+		same = !river_emmc_read_block(parts[42].first + i, block) &&
+		    !memcmp(block, mblock + i * (BLOCK / 4), BLOCK);
+	}
+	if (!same) {
+		adma_ok = false;
+		host_ctrl &= ~CTRL_ADMA2_32;
+		wr(hc, SDHCI_HOST_CTRL, host_ctrl);
+	}
+	printf("RIVER eMMC: ADMA2 %s (buffer 0x%llx)\n", same ? "on, verified" : "verify FAILED; PIO", adma_pa);
+}
