+/* Initial EAPOL uses TX_LOW non-QoS unencrypted 802.11 data. One of64
+ * descriptor pairs at a time is backed by a permanent buffer in the gap.
+ * No reuse until both descriptors return ownership; timeout stops TX. */
+static unsigned river_data_pair;
+static bool
+river_eapol_tx(const uint8_t *eapol, unsigned n)
+{
+ if (n < 99 || n > 512 || !river_dxe_ready || river_wpa.data_tx_stalled) return false;
+ volatile struct river_dxe_desc *ring = (volatile struct river_dxe_desc *)river_dxe_dma;
+ unsigned pair = river_data_pair;
+ volatile struct river_dxe_desc *bd = &ring[2*pair], *data = bd+1;
+ if ((bd->ctrl | data->ctrl) & 1) return false;
+ __asm__ volatile("dmb oshld" ::: "memory");
+ volatile uint8_t *b = (volatile uint8_t *)(river_dxe_dma+0xb800), *f = b+0x100;
+ for (unsigned k = 0; k < 40; k++) b[k] = 0;
+ for (unsigned k = 0; k < 32; k++) f[k] = 0;
+ f[0] = 8; f[1] = 1; /* ToDS data */
+ for (unsigned k = 0; k < 6; k++) { f[4+k] = f[16+k] = river_target.bssid[k]; f[10+k] = river_test_mac[k]; }
+ static const uint8_t llc[] = {170,170,3,0,0,0,136,142};
+ for (unsigned k = 0; k < 8; k++) f[24+k] = llc[k];
+ for (unsigned k = 0; k < n; k++) f[32+k] = eapol[k];
+ river_put_be32(b, (25u<<24) | (river_peer_sign<<21) | 8u);
+ river_put_be32(b+12, (24u<<24) | (40u<<16) | (64u<<7));
+ river_put_be32(b+16, ((n+32)<<16) | (1u<<12));
+ river_put_be32(b+20, (river_peer_dpu<<24) | (river_peer_sta<<16) | (9u<<7));
+ river_put_be32(b+24, 0xbdbdbdbd);
+ bd->src = river_dxe_pa+0xb800; bd->dst = 6; bd->len = 40;
+ data->src = river_dxe_pa+0xb900; data->dst = 6; data->len = n+32;
+ __asm__ volatile("dmb oshst" ::: "memory"); data->ctrl = 0x328a4d;
+ __asm__ volatile("dmb oshst" ::: "memory"); bd->ctrl = 0x308a45;
+ __asm__ volatile("dsb osh" ::: "memory");
+ vm_offset_t dxe = river_dxe_mmio+0x2000;
+ ri_wr(dxe, 0x400, 0x843e8b4d);
+ for (unsigned w = 0; w < 20; w++) {
+  river_dxe_poll(); uint32_t status = ri_rd(dxe, 0x404);
+  if (status & 0x4000) break;
+  if (!((bd->ctrl | data->ctrl) & 1u)) {
+   __asm__ volatile("dmb oshld" ::: "memory");
+   ri_wr(dxe, 0x30, 1);
+   if (status & 0x8000) ri_wr(dxe, 0x38, 1);
+   if (status & 0x2000) ri_wr(dxe, 0x34, 1);
+   river_data_pair = (pair+1)%64;
+   return true;
+  }
+  ri_wait(10);
+ }
+ river_wpa.data_tx_stalled = true;
+ printf("RIVER WPA: EAPOL DMA stalled; buffers retained\n");
+ return false;
+}
