+static bool
+river_wpa_reply(unsigned info, const uint8_t replay[8], bool snonce, bool rsn)
+{
+ uint8_t msg[121] = {0}, mic[20];
+ unsigned n = 99 + (rsn ? river_target.rsn_len : 0);
+ msg[0] = 2; msg[1] = 3; river_be_put16(msg+2, n-4); msg[4] = 2;
+ river_be_put16(msg+5, info); /* RSN replies leave key_length zero. */ memcpy(msg+9, replay, 8);
+ if (snonce) memcpy(msg+17, river_wpa.snonce, 32);
+ if (rsn) { river_be_put16(msg+97, river_target.rsn_len); memcpy(msg+99, river_target.rsn, river_target.rsn_len); }
+ river_hmac_sha1(river_wpa.ptk, 16, msg, n, mic); memcpy(msg+81, mic, 16);
+ bool ok = river_eapol_tx(msg, n);
+ river_secret_clear(msg, sizeof(msg)); river_secret_clear(mic, sizeof(mic));
+ return ok;
+}
+static bool
+river_wpa_install(vm_offset_t smem, uint32_t info, uint32_t fifo,
+    vm_offset_t ipc, const uint8_t gtk[16], unsigned keyid, const uint8_t rsc[8])
+{
+ if (river_wpa.keys_installed) return false;
+ /* Follow wcn36xx main.c key setup: reconfigure encryption, then PTK/GTK.
+  * Mark installation attempted before commands: never reinstall on retry. */
+ river_wpa.keys_installed = true;
+ if (!river_config_target_bss(smem, info, fifo, ipc, true, river_assoc_aid)) return false;
+ uint8_t sta[124] = {0}; river_fill_sta(sta+8, river_assoc_aid);
+ if (!river_scan_xact(smem, info, fifo, ipc, 12, sta, 114)) return false;
+ uint8_t pairwise[248] = {0};
+ river_le_put(pairwise+8, river_peer_sta, 2); river_le_put(pairwise+10, 4, 4);
+ uint8_t *k = pairwise+19;
+ k[1] = 1; river_le_put(k+2, 2, 4); river_le_put(k+23, 16, 2);
+ memcpy(k+25, river_wpa.ptk+32, 16); pairwise[247] = 1;
+ bool ok = river_scan_xact(smem, info, fifo, ipc, 26, pairwise, sizeof(pairwise));
+ river_secret_clear(pairwise, sizeof(pairwise));
+ if (!ok) return false;
+ uint8_t group[243] = {0}; group[8] = river_target_bss;
+ river_le_put(group+9, 4, 4); group[13] = 1; k = group+14;
+ k[0] = keyid; river_le_put(k+2, 1, 4); memcpy(k+6, rsc, 8);
+ river_le_put(k+23, 16, 2); memcpy(k+25, gtk, 16);
+ ok = river_scan_xact(smem, info, fifo, ipc, 24, group, sizeof(group));
+ river_secret_clear(group, sizeof(group));
+ return ok;
+}
+static bool
+river_wpa_keydata(const uint8_t *data, unsigned n, uint8_t gtk[16], unsigned *keyid)
+{
+ bool have_rsn = false, have_gtk = false;
+ for (unsigned off = 0; off < n;) {
+  /* 802.11 key-data padding is DD followed by zeros. */
+  if (data[off] == 221 && (off+1 == n || data[off+1] == 0)) {
+   for (unsigned j = off+1; j < n; j++) if (data[j]) return false;
+   break;
+  }
+  if (off+2 > n || data[off+1] > n-off-2) return false;
+  unsigned id = data[off], size = data[off+1];
+  const uint8_t *p = data+off+2;
+  if (id == 48) {
+   if (have_rsn || size+2 != river_target.ap_rsn_len ||
+       !river_constant_equal(data+off, river_target.ap_rsn, size+2)) return false;
+   have_rsn = true;
+  }
+  if (id == 221 && size >= 4 && !p[0] && p[1] == 15 && p[2] == 172 && p[3] == 1) {
+   if (have_gtk || size != 22 || (p[4] & 0xf8) || p[5]) return false;
+   *keyid = p[4]&3; memcpy(gtk, p+6, 16); have_gtk = true;
+  }
+  off += size+2;
+ }
+ return have_rsn && have_gtk;
+}
+static void
+river_wpa_step(vm_offset_t smem, uint32_t info, uint32_t fifo, vm_offset_t ipc)
+{
+ if (!river_wpa.associated || !river_wpa.pending_len) return;
+ uint8_t msg[512], mic[20], saved_mic[16];
+ unsigned n = river_wpa.pending_len;
+ memcpy(msg, river_wpa.pending, n); river_secret_clear(river_wpa.pending, n); river_wpa.pending_len = 0;
+ unsigned flags = river_be16(msg+5);
+ /* Pairwise, ACK, HMAC-SHA1/AES descriptor version2, no request/error/index. */
+ if ((flags & 0xecbf) != 0x008a || river_be16(msg+7) != 16) goto done;
+ if (!(flags & 0x100)) {
+  /* M1 must not assert install/secure/encrypted. One nonce per initial M1.
+   * Retransmit M2 only for identical ANonce/replay; reject session changes. */
+  if (flags != 0x008a || n != 99 || river_wpa.keys_installed || river_wpa.stage > 1) goto done;
+  uint8_t zero[32] = {0}; if (river_constant_equal(msg+17, zero, 32)) goto done;
+  if (!river_wpa.stage) {
+   read_random(river_wpa.snonce, 32); memcpy(river_wpa.anonce, msg+17, 32);
+   memcpy(river_wpa.replay, msg+9, 8); river_derive_ptk(); river_wpa.stage = 1;
+  } else if (!river_constant_equal(msg+17, river_wpa.anonce, 32) ||
+      !river_constant_equal(msg+9, river_wpa.replay, 8)) goto done;
+  bool ok = river_wpa_reply(0x010a, msg+9, true, true);
+  printf("RIVER WPA: M1 accepted, M2 DMA=%u\n", ok);
+  goto done;
+ }
+ /* Only M3 (install/secure/encrypted/MIC). Authenticate before decrypting
+  * or touching driver key state; replay must advance beyond M1. */
+ if (flags != 0x13ca || !river_wpa.stage ||
+     !river_constant_equal(msg+17, river_wpa.anonce, 32) ||
+     memcmp(msg+9, river_wpa.replay, 8) <= 0) goto done;
+ memcpy(saved_mic, msg+81, 16); memset(msg+81, 0, 16);
+ river_hmac_sha1(river_wpa.ptk, 16, msg, n, mic);
+ if (!river_constant_equal(mic, saved_mic, 16)) {
+  printf("RIVER WPA: M3 MIC rejected; no key installed\n"); goto done;
+ }
+ if (river_wpa.stage == 2) {
+  if (river_constant_equal(msg+9, river_wpa.m3replay, 8))
+   (void)river_wpa_reply(0x030a, msg+9, false, false);
+  goto done; /* no PTK/GTK reinstallation */
+ }
+ if (river_wpa.keys_installed) goto done;
+ unsigned wrapped = river_be16(msg+97), keyid = 0;
+ uint8_t plain[400] = {0}, gtk[16] = {0};
+ bool ok = river_aes_unwrap(river_wpa.ptk+16, msg+99, wrapped, plain) &&
+     river_wpa_keydata(plain, wrapped-8, gtk, &keyid);
+ if (ok) ok = river_wpa_install(smem, info, fifo, ipc, gtk, keyid, msg+65);
+ river_secret_clear(plain, sizeof(plain)); river_secret_clear(gtk, sizeof(gtk));
+ if (!ok) { printf("RIVER WPA: key validation/installation failed; port closed\n"); goto done; }
+ memcpy(river_wpa.m3replay, msg+9, 8);
+ ok = river_wpa_reply(0x030a, msg+9, false, false);
+ if (ok) { river_wpa.stage = 2; printf("RIVER WPA: PTK/GTK installed once; M4 DMA complete; handshake gate passed\n"); }
+ /* Keep controlled networking unpublished until encrypted traffic is tested. */
+ done:
+ river_secret_clear(msg, sizeof(msg)); river_secret_clear(mic, sizeof(mic)); river_secret_clear(saved_mic, sizeof(saved_mic));
+}
+static void
+river_wpa_run(vm_offset_t smem, uint32_t info, uint32_t fifo, vm_offset_t ipc)
+{
+ if (!river_wpa.pmk_ready || !river_wpa.associated) return;
+ for (unsigned w = 0; w < 1000 && river_dxe_ready; w++) {
+  river_dxe_poll(); river_wpa_step(smem, info, fifo, ipc); ri_wait(10);
+ }
+ printf("RIVER WPA: initial window complete stage=%u keys-attempted=%u; no IP interface published\n",
+     river_wpa.stage, river_wpa.keys_installed);
+}
