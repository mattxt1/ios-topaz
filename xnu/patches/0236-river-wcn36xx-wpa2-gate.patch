+/* Narrow WPA2-PSK/CCMP handshake gate. No key material is logged.
+ * SHA1/AES use the existing portable kernel providers; RFC3394 unwrap.
+ * One initial PTK installation only: retransmitted M3 never reinstalls keys. */
+static struct {
+ uint8_t pmk[32], ptk[48], snonce[32], anonce[32], replay[8], m3replay[8];
+ uint8_t pending[512];
+ unsigned pending_len, stage;
+ bool pmk_ready, keys_installed, associated, data_tx_stalled;
+} river_wpa;
+static unsigned river_peer_sta, river_peer_dpu, river_peer_sign;
+static void
+river_secret_clear(void *p, unsigned n)
+{
+ volatile uint8_t *v = p;
+ while (n--) *v++ = 0;
+}
+static bool
+river_constant_equal(const uint8_t *a, const uint8_t *b, unsigned n)
+{
+ unsigned diff = 0;
+ for (unsigned i = 0; i < n; i++) diff |= a[i] ^ b[i];
+ return diff == 0;
+}
+static unsigned
+river_be16(const uint8_t *p)
+{
+ return ((unsigned)p[0] << 8) | p[1];
+}
+static void
+river_be_put16(uint8_t *p, unsigned v)
+{
+ p[0] = v >> 8; p[1] = v;
+}
+static void
+river_hmac_sha1(const uint8_t *key, unsigned nk, const uint8_t *msg, unsigned n, uint8_t out[20])
+{
+ uint8_t pad[64] = {0}, inner[20];
+ SHA1_CTX sha;
+ if (nk > 64) { SHA1Init(&sha); SHA1Update(&sha, key, nk); SHA1Final(pad, &sha); }
+ else memcpy(pad, key, nk);
+ for (unsigned i = 0; i < 64; i++) pad[i] ^= 0x36;
+ SHA1Init(&sha); SHA1Update(&sha, pad, 64); SHA1Update(&sha, msg, n); SHA1Final(inner, &sha);
+ for (unsigned i = 0; i < 64; i++) pad[i] ^= 0x36 ^ 0x5c;
+ SHA1Init(&sha); SHA1Update(&sha, pad, 64); SHA1Update(&sha, inner, 20); SHA1Final(out, &sha);
+ river_secret_clear(&sha, sizeof(sha)); river_secret_clear(pad, sizeof(pad)); river_secret_clear(inner, sizeof(inner));
+}
+static void
+river_derive_ptk(void)
+{
+ uint8_t input[100], digest[20];
+ static const char label[] = "Pairwise key expansion";
+ unsigned off = sizeof(label); memcpy(input, label, off);
+ const uint8_t *a = river_target.bssid, *b = river_test_mac;
+ if (memcmp(a, b, 6) > 0) { a = river_test_mac; b = river_target.bssid; }
+ memcpy(input+off, a, 6); memcpy(input+off+6, b, 6); off += 12;
+ a = river_wpa.anonce; b = river_wpa.snonce;
+ if (memcmp(a, b, 32) > 0) { a = river_wpa.snonce; b = river_wpa.anonce; }
+ memcpy(input+off, a, 32); memcpy(input+off+32, b, 32); off += 64;
+ for (unsigned block = 0, done = 0; done < sizeof(river_wpa.ptk); block++) {
+  input[off] = block;
+  river_hmac_sha1(river_wpa.pmk, 32, input, off+1, digest);
+  unsigned n = sizeof(river_wpa.ptk)-done; if (n > 20) n = 20;
+  memcpy(river_wpa.ptk+done, digest, n); done += n;
+ }
+ river_secret_clear(input, sizeof(input)); river_secret_clear(digest, sizeof(digest));
+}
+static bool
+river_aes_unwrap(const uint8_t kek[16], const uint8_t *input, unsigned n, uint8_t *out)
+{
+ if (n < 24 || n > 408 || (n & 7)) return false;
+ aes_decrypt_ctx ctx;
+ if (aes_decrypt_key128(kek, &ctx)) return false;
+ uint8_t a[8], block[16], plain[16];
+ memcpy(a, input, 8); memcpy(out, input+8, n-8);
+ unsigned count = n/8-1;
+ bool ok = true;
+ for (int j = 5; j >= 0 && ok; j--)
+  for (unsigned i = count; i > 0; i--) {
+   memcpy(block, a, 8); unsigned t = count*j+i;
+   for (unsigned k = 0; k < 8; k++) { block[7-k] ^= t & 255; t >>= 8; }
+   memcpy(block+8, out+8*(i-1), 8);
+   if (aes_decrypt(block, plain, &ctx)) { ok = false; break; }
+   memcpy(a, plain, 8); memcpy(out+8*(i-1), plain+8, 8);
+  }
+ static const uint8_t iv[8] = {166,166,166,166,166,166,166,166};
+ ok = ok && river_constant_equal(a, iv, 8);
+ if (!ok) river_secret_clear(out, n-8);
+ river_secret_clear(&ctx, sizeof(ctx)); river_secret_clear(a, sizeof(a));
+ river_secret_clear(block, sizeof(block)); river_secret_clear(plain, sizeof(plain));
+ return ok;
+}
+static void
+river_wpa_load(void)
+{
+ DTEntry mm; const void *prop; unsigned size;
+ if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+     SecureDTGetProperty(mm, "RiverWiFiPMK", &prop, &size) != kSuccess || size != 16) return;
+ uint64_t pa = ((const uint64_t *)prop)[0], len = ((const uint64_t *)prop)[1];
+ if ((pa & 0xfff) || pa < 0x18000000ULL || pa >= 0x81800000ULL || len != 32 || pa+len > 0x81800000ULL) return;
+ uint8_t *p = (uint8_t *)ml_static_ptovirt((vm_offset_t)pa);
+ if (!p) return;
+ memcpy(river_wpa.pmk, p, 32); river_secret_clear(p, 32);
+ river_wpa.pmk_ready = true;
+ printf("RIVER WPA: private PMK loaded; key material logging disabled\n");
+}
+static void
+river_wpa_queue(const volatile uint8_t *p, unsigned n)
+{
+ if (!river_wpa.pmk_ready || n < 99 || n > sizeof(river_wpa.pending) || river_wpa.pending_len) return;
+ for (unsigned k = 0; k < n; k++) river_wpa.pending[k] = p[k];
+ if (river_wpa.pending[1] != 3 || river_be16(river_wpa.pending+2)+4 != n ||
+     river_wpa.pending[4] != 2 || river_be16(river_wpa.pending+97)+99 != n) {
+  river_secret_clear(river_wpa.pending, n); return;
+ }
+ river_wpa.pending_len = n;
+}
