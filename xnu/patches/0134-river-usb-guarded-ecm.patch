+#if defined(RIVER)
+/* DT and matching msm-clocks-hwio-8953.h: never read gated USB blocks.
+ * riverusb=1 reads state only; =2 reuses the DWC3 CDC-ECM gadget below,
+ * but only if ABL left clocks, PHY PLL and device mode ready. */
+static void
+river_usb_probe_mode(void)
+{
+ int enabled = 0;
+ PE_parse_boot_argn("riverusb", &enabled, sizeof(enabled));
+ if (enabled != 1 && enabled != 2) return;
+ vm_offset_t gcc = usb_map(0x0183c000, 0x4000);
+ if (!gcc) return;
+ uint32_t gdsc = usb_rd(gcc, 0x3078);
+ printf("RIVER USB: GDSC %#x (%s) mode=%d\n", gdsc, (gdsc & (1u<<31)) ? "on" : "off", enabled);
+ const struct { const char *name; uint32_t off; } clocks[] = {
+  {"master",0x3000},{"sleep",0x3004},{"utmi",0x3008},
+  {"pcnoc-axi",0x3038},{"phy-cfg-ahb",0x3080},
+ };
+ bool on = !!(gdsc & (1u<<31));
+ for (unsigned i=0; i<sizeof(clocks)/sizeof(clocks[0]); i++) {
+  uint32_t v=usb_rd(gcc,clocks[i].off);
+  printf("RIVER USB: clk %s CBCR %#x (%s)\n",clocks[i].name,v,(v&CBCR_CLK_OFF)?"off":"on");
+  if(v&CBCR_CLK_OFF)on=false;
+ }
+ if(!on) { printf("RIVER USB: gated; controller and PHY untouched\n"); return; }
+ vm_offset_t ref=usb_map(0x01840000,0x4000);
+ if(!ref) return;
+ uint32_t refclk=usb_rd(ref,0x1030);
+ printf("RIVER USB: QUSB reference clock %#x\n",refclk);
+ if(!(refclk&1)) { printf("RIVER USB: reference clock disabled; stopping\n"); return; }
+ vm_offset_t phy=usb_map(QUSB2_PA,QUSB2_SIZE);
+ if(!phy) return;
+ uint32_t pll=usb_rd(phy,0x38),power=usb_rd(phy,0xb4);
+ printf("RIVER USB: QUSB2v1 PLL %#x POWERDOWN %#x TUNE1 %#x\n",pll,power,usb_rd(phy,0x80));
+ if(!(pll&(1u<<5)) || (power&1)) { printf("RIVER USB: PHY not ready; stopping\n"); return; }
+ vm_offset_t dwc=usb_map(DWC3_PA,DWC3_SIZE);
+ if(!dwc) return;
+ uint32_t id=usb_rd(dwc,0xc120),ctl=usb_rd(dwc,0xc110);
+ printf("RIVER USB: GSNPSID %#x GCTL %#x DCFG %#x DCTL %#x DSTS %#x\n",id,ctl,usb_rd(dwc,0xc700),usb_rd(dwc,0xc704),usb_rd(dwc,0xc70c));
+ printf("RIVER USB: events %#x:%#x size=%#x count=%#x hwparams0=%#x\n",usb_rd(dwc,0xc404),usb_rd(dwc,0xc400),usb_rd(dwc,0xc408),usb_rd(dwc,0xc40c),usb_rd(dwc,0xc140));
+ if((id&0xffff0000u)!=0x55330000u || ((ctl>>12)&3)!=2) { printf("RIVER USB: unsupported controller or non-device mode; stopping\n"); return; }
+ if(enabled==2) sweet_usb_gadget_start(dwc);
+}
+#endif
