+/* CMD6 then CMD13: the switch must leave the card in tran without SWITCH_ERROR. */
+static int
+river_emmc_switch(uint32_t index, uint32_t value)
+{
+	uint32_t r;
+	int error = river_emmc_cmd(6, CMD6_WRITE_BYTE(index, value), RSP_R1B, &r, NULL);
+	if (!error) {
+		error = river_emmc_cmd(13, RCA << 16, RSP_R1, &r, NULL);
+	}
+	if (!error && ((r & (R1_ERRORS | R1_SWITCH_ERROR)) || ((r >> 9) & 0xf) != 4)) {
+		printf("RIVER eMMC: CMD6 EXT_CSD[%u]=%u status 0x%x\n", index, value, r);
+		error = EIO;
+	}
+	return error;
+}
+
+static void
+river_emmc_host_bus(uint32_t bits)
+{
+	host_ctrl = (host_ctrl & ~(CTRL_8BIT | CTRL_HISPD)) | bits;
+	wr(hc, SDHCI_HOST_CTRL, host_ctrl);
+}
+
+/* EXT_CSD read through the current bus mode must match the 1-bit copy. */
+static bool
+river_emmc_ext_csd_same(const uint8_t *ref)
+{
+	uint32_t r;
+	const uint8_t *e = (const uint8_t *)block;
+	if (river_emmc_cmd(8, 0, RSP_R1, &r, block)) {
+		return false;
+	}
+	return e[EXT_CSD_REV] == ref[EXT_CSD_REV] && e[EXT_CSD_CARD_TYPE] == ref[EXT_CSD_CARD_TYPE] &&
+	       memcmp(e + EXT_CSD_SEC_COUNT, ref + EXT_CSD_SEC_COUNT, 4) == 0 &&
+	       memcmp(e + 224, ref + 224, 32) == 0;	/* read-only geometry/boot fields */
+}
+
+/*
+ * After 25 MHz 1-bit works: 8-bit bus, then high-speed timing at 50 MHz,
+ * then CMD23/CMD18 multi-block reads. Each step is verified by re-reading
+ * EXT_CSD (data on all lines) and undone on any mismatch. ABL already ran
+ * this card at HS400 8-bit, so the eight data pads are configured.
+ */
+static void
+river_emmc_fast_bus(void)
+{
+	static uint8_t ref[BLOCK];
+	uint32_t r;
+	if (river_emmc_cmd(8, 0, RSP_R1, &r, block)) {
+		printf("RIVER eMMC: EXT_CSD read failed; staying 1-bit 25 MHz\n");
+		return;
+	}
+	memcpy(ref, block, BLOCK);
+	printf("RIVER eMMC: EXT_CSD rev %u card_type 0x%x bus_width %u hs_timing %u\n",
+	    ref[EXT_CSD_REV], ref[EXT_CSD_CARD_TYPE], ref[EXT_CSD_BUS_WIDTH], ref[EXT_CSD_HS_TIMING]);
+
+	if (river_emmc_switch(EXT_CSD_BUS_WIDTH, 2) == 0) {
+		river_emmc_host_bus(CTRL_8BIT);
+		if (!river_emmc_ext_csd_same(ref)) {
+			printf("RIVER eMMC: 8-bit verify failed; back to 1-bit\n");
+			river_emmc_host_bus(0);
+			(void)river_emmc_switch(EXT_CSD_BUS_WIDTH, 0);
+		}
+	}
+	bool wide = (host_ctrl & CTRL_8BIT) != 0;
+
+	if ((ref[EXT_CSD_CARD_TYPE] & 0x2) && river_emmc_switch(EXT_CSD_HS_TIMING, 1) == 0) {
+		river_emmc_host_bus((wide ? CTRL_8BIT : 0) | CTRL_HISPD);
+		if (river_emmc_card_clock(RCG_CFG_50M, false) || !river_emmc_ext_csd_same(ref)) {
+			printf("RIVER eMMC: 50 MHz verify failed; back to 25 MHz\n");
+			(void)river_emmc_card_clock(RCG_CFG_25M, false);
+			river_emmc_host_bus(wide ? CTRL_8BIT : 0);
+			(void)river_emmc_switch(EXT_CSD_HS_TIMING, 0);
+		}
+	}
+	bool fast = (host_ctrl & CTRL_HISPD) != 0;
+
+	/* Multi-block: the first 8 blocks of boot_b must equal single-block reads. */
+	multi_ok = true;
+	if (!parts[42].count || river_emmc_read_multi(parts[42].first, 8, mblock)) {
+		multi_ok = false;
+	}
+	for (uint32_t i = 0; multi_ok && i < 8; i++) {
+		if (river_emmc_read_block(parts[42].first + i, block) ||
+		    memcmp(block, mblock + i * (BLOCK / 4), BLOCK)) {
+			multi_ok = false;
+		}
+	}
+	printf("RIVER eMMC: %s bus, %s MHz, multi-block reads %s\n", wide ? "8-bit" : "1-bit",
+	    fast ? "50" : "25", multi_ok ? "on" : "off");
+}
