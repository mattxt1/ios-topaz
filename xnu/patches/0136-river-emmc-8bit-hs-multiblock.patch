+static int
+river_emmc_cmd(uint32_t index, uint32_t arg, uint32_t rsp, uint32_t *resp, uint32_t *buf)
+{
+	return river_emmc_cmd_n(index, arg, rsp, resp, buf, 1);
+}
+
+/* Read `n` (2..MULTI_MAX) consecutive blocks: CMD23 count, CMD18. */
+static int
+river_emmc_read_multi(uint64_t lba, uint32_t n, void *dst)
+{
+	uint32_t resp;
+	if (!ready || !multi_ok || (lba + n) >> 32) {
+		return ENXIO;
+	}
+	int error = river_emmc_cmd(23, n, RSP_R1, &resp, NULL);
+	if (!error) {
+		error = river_emmc_cmd_n(18, (uint32_t)lba, RSP_R1, &resp, (uint32_t *)dst, n);
+	}
+	if (!error && (resp & R1_ERRORS)) {
+		printf("RIVER eMMC: CMD18 LBA %llu x%u R1 0x%x\n", lba, n, resp);
+		error = EIO;
+	}
+	return error;
+}
