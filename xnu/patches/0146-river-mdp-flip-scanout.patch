 #if defined(RIVER)
+extern "C" vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+static AppleCLCD *river_scan_fb;
+extern "C" char river_mdp_note[320];
+char river_mdp_note[320] = "RIVER MDP: no summary";
+
+static volatile uint32_t *
+river_mdp_map(uint64_t pa)
+{
+	vm_offset_t va = ml_io_map_unmappable(pa & ~0x3fffULL, 0x4000, VM_WIMG_IO);
+	return va ? (volatile uint32_t *)(va + (pa & 0x3fff)) : NULL;
+}
+
+/* panic: point the pipe back at ABL's splash, where the console draws (MMIO only) */
+static void
+river_cons_show(void)
+{
+	AppleCLCD *fb = river_scan_fb;
+	if (fb != NULL && fb->fVig0 != NULL && fb->fScanPhys != fb->fBootSrc) {
+		fb->scanFrom(fb->fBootSrc, fb->fBootStride);
+	}
+}
+
+/*
+ * MDP5 (river DT: MDSS 0x1a00000, VIG0 +0x5000, RGB0/1 +0x15000/+0x17000,
+ * DMA0 +0x25000, CTL0-2 +0x2000/+0x2200/+0x2400). Always: log what ABL set
+ * up (read-only). With boot-arg riverscan=1: find the pipe scanning the
+ * splash, allocate two contiguous BGRA flip buffers, and let the existing
+ * flip path point that pipe at them (BGRX8888) instead of converting every
+ * frame into the 24bpp splash. Flush bits from Linux mdss_mdp_ctl.c.
+ */
+void
+AppleCLCD::riverMdpSetup(void)
+{
+	static const struct { const char *name; uint32_t off, flush; } pipes[] = {
+		{ "VIG0", 0x05000, 1u << 0 }, { "RGB0", 0x15000, 1u << 3 },
+		{ "RGB1", 0x17000, 1u << 4 }, { "DMA0", 0x25000, 1u << 11 },
+	};
+	volatile uint32_t *pipe = NULL, *ctl = NULL;
+	uint32_t flush = 0;
+	const char *pname = "none";
+	for (unsigned i = 0; i < sizeof(pipes) / sizeof(pipes[0]); i++) {
+		volatile uint32_t *p = river_mdp_map(0x1a00000ULL + pipes[i].off);
+		if (p == NULL) {
+			continue;
+		}
+		IOLog("RIVER MDP: %s src %#x size %#x img %#x xy %#x out %#x oxy %#x ystride %u fmt %#x unpack %#x op %#x\n",
+		    pipes[i].name, p[0x14 / 4], p[0x00 / 4], p[0x04 / 4], p[0x08 / 4], p[0x0c / 4], p[0x10 / 4],
+		    p[0x24 / 4], p[0x30 / 4], p[0x34 / 4], p[0x38 / 4]);
+		if (pipe == NULL && p[0x14 / 4] == (uint32_t)fPhys) {
+			pipe = p;
+			flush = pipes[i].flush;
+			pname = pipes[i].name;
+			snprintf(river_mdp_note, sizeof(river_mdp_note),
+			    "RIVER MDP: splash pipe %s size %#x out %#x oxy %#x ystride %u fmt %#x unpack %#x op %#x",
+			    pname, p[0x00 / 4], p[0x0c / 4], p[0x10 / 4], p[0x24 / 4], p[0x30 / 4], p[0x34 / 4], p[0x38 / 4]);
+		}
+	}
+	for (unsigned c = 0; c < 3; c++) {
+		volatile uint32_t *r = river_mdp_map(0x1a02000ULL + 0x200 * c);
+		if (r == NULL) {
+			continue;
+		}
+		IOLog("RIVER MDP: CTL%u layer0 %#x layer1 %#x top %#x flush %#x\n", c, r[0x00 / 4], r[0x04 / 4],
+		    r[0x14 / 4], r[0x18 / 4]);
+		size_t l = strlen(river_mdp_note);
+		snprintf(river_mdp_note + l, sizeof(river_mdp_note) - l, "; CTL%u %#x/%#x", c, r[0x00 / 4], r[0x04 / 4]);
+		if (ctl == NULL && (r[0x00 / 4] | r[0x04 / 4]) != 0) {
+			ctl = r;
+		}
+	}
+	int on = 0;
+	PE_parse_boot_argn("riverscan", &on, sizeof(on));
+	if (!on || pipe == NULL || ctl == NULL || pipe[0x24 / 4] != SWEET_EARLY_FB_STRIDE) {
+		IOLog("RIVER MDP: direct scanout off (riverscan %d, pipe %s, ctl %s)\n", on, pname,
+		    ctl ? "found" : "none");
+		size_t l = strlen(river_mdp_note);
+		snprintf(river_mdp_note + l, sizeof(river_mdp_note) - l, "; scanout OFF");
+		return;
+	}
+	vm_size_t fsz = (vm_size_t)fRowBytes * fHeight;
+	for (int i = 0; i < 2; i++) {
+		fFlip[i] = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, fsz, 0x00000000fffff000ull);
+		fFlipPhys[i] = fFlip[i] ? fFlip[i]->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
+	}
+	if (fFlip[0] == NULL || fFlip[1] == NULL || !fFlipPhys[0] || !fFlipPhys[1]) {
+		OSSafeReleaseNULL(fFlip[0]);
+		OSSafeReleaseNULL(fFlip[1]);
+		IOLog("RIVER MDP: no contiguous flip buffers; keeping the 24bpp copy\n");
+		return;
+	}
+	fBootSrc = pipe[0x14 / 4];
+	fBootStride = pipe[0x24 / 4];
+	fBootFormat = pipe[0x30 / 4];
+	fBootUnpack = pipe[0x34 / 4];
+	fScanPhys = fBootSrc;
+	fScanStride = fBootStride;
+	fPipeFlush = flush | (1u << 17);
+	fCtl0 = ctl;
+	fVig0 = pipe;	/* last: enables the flip path */
+	river_scan_fb = this;
+	sweet_console_show_hook = river_cons_show;
+	IOLog("RIVER MDP: direct scanout via %s, flush %#x, flip buffers %#llx %#llx (BGRX, stride %u)\n",
+	    pname, fPipeFlush, fFlipPhys[0], fFlipPhys[1], fRowBytes);
+	size_t l = strlen(river_mdp_note);
+	snprintf(river_mdp_note + l, sizeof(river_mdp_note) - l, "; scanout ON flush %#x", fPipeFlush);
+}
