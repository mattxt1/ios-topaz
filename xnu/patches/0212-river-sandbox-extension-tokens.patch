diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 00d2ee4..a585d14 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -281,13 +281,15 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
  * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
  * "profile not found"). SWEET runs without a sandbox: operations succeed
  * (checks allow, profile init is accepted); the few that must return
- * data (container paths, extension tokens) fail with ENOENT. The first
- * use of each operation number is logged.
+ * data (container paths) fail with ENOENT. Extension issue returns the
+ * libsystem_sandbox "invalid" token, which consume treats as a no-op;
+ * no Sandbox policy is enforcing access on this board. The first use of
+ * each operation number is logged.
  */
 static uint64_t sweet_sandbox_seen;
 
 static int
-sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
 	if (call >= 0 && call < 64 && !(sweet_sandbox_seen & (1ULL << call))) {
 		sweet_sandbox_seen |= 1ULL << call;
@@ -297,10 +299,25 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 	}
 	switch (call) {
 	case 4:         /* container path (audit token / pid) */
-	case 5:         /* extension issue */
-	case 6:         /* extension consume */
 	case 0x43:      /* container expected */
 		return ENOENT;
+	case 5: {       /* extension issue: permissive token for missing Sandbox */
+		uint64_t request[7];
+		static const char token[] = "invalid";
+		if (copyin(arg, request, sizeof(request)) != 0 ||
+		    request[4] == 0 || request[5] < sizeof(token)) {
+			return EFAULT;
+		}
+		return copyout(token, (user_addr_t)request[4], sizeof(token));
+	}
+	case 6: {       /* extension consume: no restriction to relax */
+		uint64_t request[3];
+		uint64_t handle = 0;
+		if (copyin(arg, request, sizeof(request)) != 0 || request[2] == 0) {
+			return EFAULT;
+		}
+		return copyout(&handle, (user_addr_t)request[2], sizeof(handle));
+	}
 	default:
 		return 0;
 	}
