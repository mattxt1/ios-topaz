+/*
+ * After a failed data transfer the card may still be sending or receiving
+ * (r19: CMD18 timed out, then CMD17/CMD24 got command timeouts 0x18000 and
+ * SpringBoard died on a failed page-in). CMD12 STOP_TRANSMISSION returns it
+ * to tran, as Linux does; CMD13 confirms, polling out a write's busy state.
+ */
+static void
+river_emmc_recover(void)
+{
+	uint32_t r = 0;
+	int error = river_emmc_cmd(12, 0, RSP_R1B, &r, NULL);
+	uint64_t end = deadline(WRITE_TIMEOUT_NS);
+	int st = -1;
+	do {
+		if (!river_emmc_cmd(13, RCA << 16, RSP_R1, &r, NULL)) {
+			st = (r >> 9) & 0xf;
+			if (st == 4) {
+				break;
+			}
+		}
+		delay(1000);
+	} while (mach_absolute_time() < end);
+	printf("RIVER eMMC: recovery CMD12 %s, card state %d%s\n", error ? "failed" : "ok", st,
+	    st == 4 ? " (tran)" : " (NOT tran)");
+}
