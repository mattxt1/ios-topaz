+/*
+ * Kernel GPU service, first layer (what Mesa's freedreno later sits on, via
+ * /dev/rivergpu): GPU memory objects and submission with fences.
+ *
+ * Buffer objects are wired kernel pages (not physically contiguous), mapped
+ * 16 KiB page by page into the GPU address space at a first-fit GPU VA in
+ * [RGPU_HEAP_BASE, RGPU_HEAP_END). The GPU is not cache coherent: the CPU
+ * cleans before the GPU reads and invalidates before it reads GPU output.
+ *
+ * Submission follows mainline a5xx_submit without preemption: one
+ * CP_INDIRECT_BUFFER_PFE per command buffer, the seqno to CP_SCRATCH_REG(2),
+ * then CP_EVENT_WRITE CACHE_FLUSH_TS | IRQ writing the seqno to the fence
+ * word once prior work is flushed and raising RBBM_INT_0 CP_CACHE_FLUSH_TS on
+ * GIC SPI 33. Waiters sleep on that interrupt. The 4 KiB ring wraps.
+ */
+#define RGPU_HEAP_BASE	0x01100000ULL
+#define RGPU_HEAP_END	0xf0000000ULL
+#define RGPU_MAX_BO	1024
+#define OFF_FENCE	(OFF_SCRATCH + 0x100)
+
+struct rgpu_bo {
+	vm_offset_t va;
+	vm_size_t size;
+	uint64_t gpuva;
+	bool used;
+};
+static struct rgpu_bo rgpu_bos[RGPU_MAX_BO];
+static lck_grp_t *rgpu_grp;
+static lck_mtx_t *rgpu_lock;
+static uint64_t rgpu_ring_pa, rgpu_fence_va;
+static vm_offset_t rgpu_fence_cpu;
+static uint32_t rgpu_seqno;
+static volatile uint32_t rgpu_irqs, rgpu_irq_err, rgpu_irq_last;
+static int rgpu_fence_event;
+
+static void
+rgpu_irq(__unused void *arg)
+{
+	uint32_t st = g_rd(RBBM_INT_0_STATUS);
+	g_wr(RBBM_INT_CLEAR_CMD, st);
+	rgpu_irqs++;
+	rgpu_irq_last = st;
+	if (st & (INT_CP_HW_ERROR | INT_UCHE_OOB_ACCESS)) rgpu_irq_err++;
+	thread_wakeup((event_t)&rgpu_fence_event);
+}
+
+static uint32_t
+rgpu_fence_read(void)
+{
+	flush_dcache64((addr64_t)(rgpu_ring_pa - OFF_RING + OFF_FENCE), 64, TRUE);
+	return *(volatile uint32_t *)rgpu_fence_cpu;
+}
+
+/* Allocate a GPU buffer; returns its index or -1. */
+static int
+rgpu_bo_alloc(vm_size_t size)
+{
+	size = (size + PAGE_SIZE - 1) & ~(vm_size_t)PAGE_MASK;
+	lck_mtx_lock(rgpu_lock);
+	int slot = -1;
+	for (int i = 0; i < RGPU_MAX_BO; i++) if (!rgpu_bos[i].used) { slot = i; break; }
+	uint64_t at = RGPU_HEAP_BASE;
+	for (bool moved = true; moved && slot >= 0;) {
+		moved = false;
+		for (int i = 0; i < RGPU_MAX_BO; i++) {
+			struct rgpu_bo *b = &rgpu_bos[i];
+			if (b->used && at < b->gpuva + b->size && b->gpuva < at + size) {
+				at = b->gpuva + b->size;
+				moved = true;
+			}
+		}
+	}
+	vm_offset_t va = 0;
+	if (slot < 0 || at + size > RGPU_HEAP_END ||
+	    kmem_alloc(kernel_map, &va, size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		lck_mtx_unlock(rgpu_lock);
+		return -1;
+	}
+	flush_dcache64((addr64_t)va, (unsigned)size, FALSE);
+	bool ok = true;
+	for (vm_size_t o = 0; ok && o < size; o += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(va + o));
+		ok = pn && gmmu_map(at + o, ptoa_64(pn), PAGE_SIZE, false);
+	}
+	if (!ok) {
+		gmmu_unmap(at, size);
+		gmmu_sync();
+		kmem_free(kernel_map, va, size);
+		lck_mtx_unlock(rgpu_lock);
+		return -1;
+	}
+	gmmu_sync();
+	rgpu_bos[slot] = (struct rgpu_bo){ .va = va, .size = size, .gpuva = at, .used = true };
+	lck_mtx_unlock(rgpu_lock);
+	return slot;
+}
+
+/* Free a GPU buffer; the caller makes sure the GPU is done with it. */
+static void
+rgpu_bo_free(int slot)
+{
+	lck_mtx_lock(rgpu_lock);
+	struct rgpu_bo *b = &rgpu_bos[slot];
+	if (b->used) {
+		gmmu_unmap(b->gpuva, b->size);
+		gmmu_sync();
+		kmem_free(kernel_map, b->va, b->size);
+		*b = (struct rgpu_bo){ 0 };
+	}
+	lck_mtx_unlock(rgpu_lock);
+}
+
+static void
+rgpu_ring_space(unsigned dw)
+{
+	for (unsigned i = 0; i < 1000000; i++) {
+		unsigned rptr = g_rd(CP_RB_RPTR) & (RING_DW - 1);
+		if (((rptr - wptr - 1) & (RING_DW - 1)) >= dw) return;
+		delay(1);
+	}
+	printf("RIVER GPU: ring stays full (rptr %u wptr %u)\n", g_rd(CP_RB_RPTR), wptr);
+}
+
+/* Queue command buffers (GPU VA, size in dwords); returns the fence seqno. */
+static uint32_t
+rgpu_submit(const uint64_t *ib, const uint32_t *ib_dw, unsigned n)
+{
+	lck_mtx_lock(rgpu_lock);
+	rgpu_ring_space(4 * n + 2 + 5);
+	for (unsigned i = 0; i < n; i++) {
+		OUT(pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+		OUT((uint32_t)ib[i]);
+		OUT((uint32_t)(ib[i] >> 32));
+		OUT(ib_dw[i]);
+	}
+	uint32_t seq = ++rgpu_seqno;
+	OUT(pkt4(CP_SCRATCH_REG(2), 1));
+	OUT(seq);
+	OUT(pkt7(CP_EVENT_WRITE, 4));
+	OUT(CACHE_FLUSH_TS | CP_EVENT_WRITE_0_IRQ);
+	OUT((uint32_t)rgpu_fence_va);
+	OUT((uint32_t)(rgpu_fence_va >> 32));
+	OUT(seq);
+	flush_dcache64((addr64_t)rgpu_ring_pa, RING_SIZE, TRUE);
+	g_wr(CP_RB_WPTR, wptr);
+	lck_mtx_unlock(rgpu_lock);
+	return seq;
+}
+
+/* Sleep until fence seqno has signalled (wrap-safe compare); false on timeout. */
+static bool
+rgpu_wait(uint32_t seq, unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		if ((int32_t)(rgpu_fence_read() - seq) >= 0) return true;
+		if (mach_absolute_time() > deadline) return false;
+		(void)assert_wait_deadline((event_t)&rgpu_fence_event, THREAD_UNINT, deadline);
+		if ((int32_t)(rgpu_fence_read() - seq) >= 0) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+			return true;
+		}
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* Bring the service up on the running CP, then exercise it. */
+static void
+rgpu_service_test(vm_offset_t buf, uint64_t pa, uint64_t gva)
+{
+	rgpu_grp = lck_grp_alloc_init("rivergpu", LCK_GRP_ATTR_NULL);
+	rgpu_lock = lck_mtx_alloc_init(rgpu_grp, LCK_ATTR_NULL);
+	rgpu_ring_pa = pa + OFF_RING;
+	rgpu_fence_va = gva + OFF_FENCE;
+	rgpu_fence_cpu = buf + OFF_FENCE;
+	*(volatile uint32_t *)rgpu_fence_cpu = 0;
+	flush_dcache64((addr64_t)(pa + OFF_FENCE), 64, TRUE);
+	rgpu_seqno = 0;
+	g_wr(RBBM_INT_CLEAR_CMD, 0xffffffff);
+	bool irq = river_irq_register(GPU_INTID, false, rgpu_irq, NULL);
+	g_wr(RBBM_INT_0_MASK, INT_CP_CACHE_FLUSH_TS | INT_CP_HW_ERROR | INT_UCHE_OOB_ACCESS);
+	printf("RIVER GPU: service up: GPU IRQ INTID %u %s, ring %u dwords, BO heap %#llx-%#llx\n",
+	    GPU_INTID, irq ? "registered" : "NOT registered", RING_DW, RGPU_HEAP_BASE, RGPU_HEAP_END);
+
+	enum { N = 200 };
+	int tgt = rgpu_bo_alloc(64 * 1024), ibo = rgpu_bo_alloc(N * 64);
+	if (tgt < 0 || ibo < 0) { printf("RIVER GPU: BO allocation failed (%d %d)\n", tgt, ibo); return; }
+	struct rgpu_bo *T = &rgpu_bos[tgt], *I = &rgpu_bos[ibo];
+	printf("RIVER GPU: BOs: target %#lx bytes at GPU %#llx, IBs %#lx bytes at GPU %#llx\n",
+	    (unsigned long)T->size, T->gpuva, (unsigned long)I->size, I->gpuva);
+	uint64_t t0 = mach_absolute_time();
+	uint32_t last = 0, irqs0 = rgpu_irqs;
+	for (unsigned i = 0; i < N; i++) {
+		uint32_t *cmd = (uint32_t *)(I->va + i * 64);
+		uint64_t dst = T->gpuva + i * 4;
+		cmd[0] = pkt7(CP_MEM_WRITE, 3);
+		cmd[1] = (uint32_t)dst;
+		cmd[2] = (uint32_t)(dst >> 32);
+		cmd[3] = 0x5a000000u | i;
+		flush_dcache64((addr64_t)(vm_offset_t)cmd, 64, FALSE);
+		uint64_t ibva = I->gpuva + i * 64;
+		uint32_t dw = 4;
+		last = rgpu_submit(&ibva, &dw, 1);
+	}
+	bool done = rgpu_wait(last, 1000);
+	uint64_t t1 = mach_absolute_time(), ns;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	flush_dcache64((addr64_t)T->va, (unsigned)T->size, FALSE);
+	unsigned good = 0, firstbad = N;
+	for (unsigned i = 0; i < N; i++) {
+		if (((volatile uint32_t *)T->va)[i] == (0x5a000000u | i)) good++;
+		else if (firstbad == N) firstbad = i;
+	}
+	printf("RIVER GPU: %u submits (ring wrapped %u times): fence %s at %u (want %u) in %llu us, %u/%u writes ok (first bad %u), %u IRQs, %u error IRQs, last INT %#x\n",
+	    N, (N * 11) / RING_DW, done ? "signalled" : "TIMED OUT", rgpu_fence_read(), last,
+	    ns / 1000, good, N, firstbad, rgpu_irqs - irqs0, rgpu_irq_err, rgpu_irq_last);
+	rgpu_bo_free(ibo);
+	rgpu_bo_free(tgt);
+	int again = rgpu_bo_alloc(32 * 1024);
+	printf("RIVER GPU: BOs freed; reallocation got GPU %#llx (heap reuse %s)\n",
+	    again >= 0 ? rgpu_bos[again].gpuva : 0ULL, again >= 0 && rgpu_bos[again].gpuva == RGPU_HEAP_BASE ? "ok" : "unexpected");
+	if (again >= 0) rgpu_bo_free(again);
+}
