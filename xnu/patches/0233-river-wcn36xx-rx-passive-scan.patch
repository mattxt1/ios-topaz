From: mattxt1 <matttysonx1@gmail.com>
Subject: [PATCH] RIVER: reclaim DXE RX buffers and run bounded passive scan

--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -320,7 +320,7 @@
  * Do not touch radio clocks, PAS reset or reserved firmware memory here. */
 /* Pronto v3 DXE layout and controls follow upstream Linux wcn36xx/dxe.[ch].
  * Keep interrupts masked until a real IRQ/reclaim path exists.  TX rings
- * contain no VALID descriptors; RX buffers remain permanently owned by DMA.
+ * contain no VALID descriptors; RX buffers are recycled by the WCNSS worker.
  * This stage initializes channels; it does not publish an iOS interface. */
 extern void pmap_set_cache_attributes(ppnum_t, unsigned int);
 static vm_offset_t river_dxe_dma;
@@ -415,6 +415,191 @@
  printf("RIVER DXE: 100ms poll enabled=%#x done=%#x errors=%#x raw_irq=%#x RX_LOW=%#x RX_HIGH=%#x\n",
      ri_rd(dxe, 8), ri_rd(dxe, 0xc), ri_rd(dxe, 0x10), ri_rd(dxe, 0x20),
      ri_rd(dxe, 0x444), ri_rd(dxe, 0x4c4));
+}
+
+/* Polled RX is owned solely by the WCNSS worker. All buffers and MMIO
+ * mappings outlive the DMA engine. No packet pointer escapes reclaim. */
+static vm_offset_t river_dxe_mmio;
+static unsigned river_rx_head[2], river_scan_channel;
+static uint64_t river_rx_packets, river_rx_bad, river_rx_beacons;
+static uint8_t river_bss[32][6];
+static unsigned river_bss_count;
+static uint32_t
+river_bd_word(const volatile uint8_t *p)
+{
+ return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+     ((uint32_t)p[2] << 8) | p[3];
+}
+static void
+river_rx_inspect(const volatile uint8_t *p)
+{
+ /* RX BD words are big endian; the following 802.11 frame is not. */
+ uint32_t flags = river_bd_word(p), offsets = river_bd_word(p + 12);
+ unsigned hoff = (offsets >> 16) & 255, hlen = offsets >> 24;
+ unsigned doff = (offsets >> 7) & 511, len = river_bd_word(p + 16) >> 16;
+ river_rx_packets++;
+ if (flags & 4u) return; /* firmware flow-control record, not 802.11 */
+ if (hoff < 76 || doff <= hoff || len < hlen || hlen < 24 ||
+     hoff + len > 0xf20 || doff > hoff + len) {
+  if (river_rx_bad++ < 8)
+   printf("RIVER RX: invalid BD flags=%#x offsets=%#x len=%u\n", flags, offsets, len);
+  return;
+ }
+ const volatile uint8_t *f = p + hoff;
+ unsigned fc = f[0] | ((unsigned)f[1] << 8);
+ if (river_rx_packets <= 16)
+  printf("RIVER RX: frame %llu channel=%u fc=%#x len=%u RSSI=%d\n",
+      river_rx_packets, river_scan_channel, fc, len,
+      (int)(river_bd_word(p + 28) >> 24) - 100);
+ if ((fc & 0xfcu) != 0x80 && (fc & 0xfcu) != 0x50) return;
+ if (len < 36) { river_rx_bad++; return; }
+ river_rx_beacons++;
+ unsigned n;
+ for (n = 0; n < river_bss_count; n++) {
+  unsigned k;
+  for (k = 0; k < 6 && river_bss[n][k] == f[16 + k]; k++) {}
+  if (k == 6) return;
+ }
+ if (n == 32) return;
+ char ssid[33] = {0};
+ unsigned ch = river_scan_channel;
+ for (unsigned off = 36; off + 2 <= len;) {
+  unsigned id = f[off], size = f[off + 1];
+  off += 2;
+  if (size > len - off) { river_rx_bad++; return; }
+  if (id == 0 && size <= 32)
+   for (unsigned k = 0; k < size; k++) {
+    unsigned v = f[off + k];
+    ssid[k] = v >= 32 && v < 127 ? (char)v : '.';
+   }
+  if (id == 3 && size == 1) ch = f[off];
+  off += size;
+ }
+ for (unsigned k = 0; k < 6; k++) river_bss[n][k] = f[16 + k];
+ river_bss_count++;
+ printf("RIVER BSS: channel=%u bssid=%02x:%02x:%02x:%02x:%02x:%02x ssid=\"%s\"\n",
+     ch, f[16], f[17], f[18], f[19], f[20], f[21], ssid);
+}
+static void
+river_dxe_poll(void)
+{
+ if (!river_dxe_ready || !river_dxe_mmio) return;
+ vm_offset_t dxe = river_dxe_mmio + 0x2000;
+ static const unsigned counts[] = {512, 40}, regs[] = {0x440, 0x4c0};
+ static const unsigned desc_off[] = {0x1140, 0x5140};
+ static const unsigned buf_off[] = {0x10000, 0x210000};
+ static const uint32_t controls[] = {0x12ad2f, 0x12d12f}, masks[] = {2, 8};
+ for (unsigned c = 0; c < 2; c++) {
+  uint32_t status = ri_rd(dxe, regs[c] + 4), mask = masks[c];
+  if (status & 0xe000) ri_wr(dxe, 0x30, mask);
+  if (status & 0x4000) {
+   printf("RIVER DXE: RX%u error status=%#x; polling stopped\n", c, status);
+   ri_wr(dxe, 0x3c, mask);
+   river_dxe_ready = false; /* retain pool/mapping, never reclaim on error */
+   return;
+  }
+  if (status & 0x8000) ri_wr(dxe, 0x38, mask);
+  if (status & 0x2000) ri_wr(dxe, 0x34, mask);
+  volatile struct river_dxe_desc *ring =
+      (volatile struct river_dxe_desc *)(river_dxe_dma + desc_off[c]);
+  unsigned reclaimed = 0;
+  /* Bound each pass even if the firmware continually fills the ring. */
+  for (; reclaimed < 64; reclaimed++) {
+   unsigned i = river_rx_head[c];
+   if (ring[i].ctrl & 1u) break;
+   __asm__ volatile("dmb oshld" ::: "memory");
+   /* Use the host's fixed buffer map, never a device-supplied address. */
+   river_rx_inspect((const volatile uint8_t *)(river_dxe_dma + buf_off[c] + i * 4096));
+   ring[i].len = 0;
+   __asm__ volatile("dmb oshst" ::: "memory");
+   ring[i].ctrl = controls[c];
+   river_rx_head[c] = (i + 1) % counts[c];
+  }
+  if (reclaimed) {
+   __asm__ volatile("dsb osh" ::: "memory");
+   ri_wr(dxe, 4, mask); /* restart after returning buffers to DMA */
+  }
+ }
+}
+/* Single outstanding HAL request, using byte-exact SMD packet lengths.
+ * Nine-byte channel messages are NOT padded to four-byte boundaries. */
+static uint32_t
+river_smd_word(vm_offset_t smem, unsigned base, unsigned pos)
+{
+ uint32_t value = 0;
+ for (unsigned k = 0; k < 4; k++)
+  value |= (uint32_t)*(volatile uint8_t *)(smem + base + ((pos + k) & 8191)) << (8 * k);
+ return value;
+}
+static bool
+river_scan_xact(vm_offset_t smem, uint32_t info, uint32_t fifo,
+    vm_offset_t ipc, unsigned type, uint8_t *msg, unsigned len)
+{
+ if (len < 8 || len > 64 || !ipc) return false;
+ msg[0] = type; msg[1] = msg[2] = msg[3] = 0;
+ msg[4] = len; msg[5] = msg[6] = msg[7] = 0;
+ uint32_t head = ri_rd(smem, info + 16), tail = ri_rd(smem, info + 12);
+ if (head >= 8192 || tail >= 8192 || ((tail - head - 1) & 8191) < 20 + len) {
+  printf("RIVER SCAN: TX FIFO unavailable type=%u\n", type);
+  return false;
+ }
+ for (unsigned i = 0; i < 20 + len; i++) {
+  uint8_t v = i == 0 ? len : (i < 20 ? 0 : msg[i - 20]);
+  *(volatile uint8_t *)(smem + fifo + ((head + i) & 8191)) = v;
+ }
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(smem, info + 16, (head + 20 + len) & 8191);
+ ri_wr(smem, info + 8, 1u | (1u << 16));
+ ri_wr(ipc, 0, 1u << 17);
+ for (unsigned wait = 0; wait < 200; wait++) {
+  river_dxe_poll();
+  uint32_t rh = ri_rd(smem, info + 36), rt = ri_rd(smem, info + 32);
+  if (rh >= 8192 || rt >= 8192) return false;
+  unsigned available = (rh - rt) & 8191;
+  if (available >= 20) {
+   uint32_t bytes = river_smd_word(smem, fifo + 8192, rt);
+   if (bytes < 8 || bytes > 8191 - 20) {
+    printf("RIVER SCAN: malformed SMD packet len=%u\n", bytes);
+    return false;
+   }
+   if (available >= 20 + bytes) {
+    unsigned base = fifo + 8192;
+    unsigned reply = river_smd_word(smem, base, rt + 20) & 65535;
+    unsigned hlen = river_smd_word(smem, base, rt + 24);
+    unsigned status = bytes >= 12 ? river_smd_word(smem, base, rt + 28) : ~0u;
+    ri_wr(smem, info + 32, (rt + 20 + bytes) & 8191);
+    ri_wr(smem, info + 28, (1u << 8) | (1u << 16));
+    ri_wr(ipc, 0, 1u << 17);
+    printf("RIVER SCAN: reply=%u len=%u/%u status=%u channel=%u\n",
+        reply, bytes, hlen, status, river_scan_channel);
+    if (reply == type + 1) return bytes >= 12 && bytes == hlen && status == 0;
+   }
+  }
+  ri_wait(10);
+ }
+ printf("RIVER SCAN: timeout type=%u\n", type);
+ return false;
+}
+static void
+river_passive_scan(vm_offset_t smem, uint32_t info, uint32_t fifo, vm_offset_t ipc)
+{
+ uint8_t init[48] = {0}; /* hal.h init_scan_req, sizeof=48 */
+ init[8] = 2; /* HAL_SYS_MODE_SCAN, no active BSS to notify */
+ if (!river_scan_xact(smem, info, fifo, ipc, 4, init, sizeof(init))) return;
+ for (unsigned ch = 1; ch <= 11 && river_dxe_ready; ch++) {
+  uint8_t channel[9] = {0};
+  channel[8] = ch;
+  river_scan_channel = ch;
+  if (!river_scan_xact(smem, info, fifo, ipc, 6, channel, sizeof(channel))) break;
+  for (unsigned dwell = 0; dwell < 25; dwell++) { river_dxe_poll(); ri_wait(10); }
+  if (!river_scan_xact(smem, info, fifo, ipc, 8, channel, sizeof(channel))) break;
+ }
+ uint8_t finish[53] = {0}; /* packed finish_scan_req, cb_state at byte13 */
+ finish[8] = 2; finish[12] = 1;
+ bool finished = river_scan_xact(smem, info, fifo, ipc, 10, finish, sizeof(finish));
+ river_scan_channel = finished ? 1 : 0;
+ printf("RIVER SCAN: complete finish=%u RX=%llu bad=%llu beacons=%llu BSS=%u\n",
+     finished, river_rx_packets, river_rx_bad, river_rx_beacons, river_bss_count);
 }
 
 static void
@@ -1486,7 +1671,8 @@
           vm_offset_t wcn_mmio = ml_io_map_unmappable(0x0a200000, 0x8000, VM_WIMG_IO);
           if (wcn_mmio) {
            river_dxe_init(wcn_mmio);
-           ml_io_unmap(wcn_mmio, 0x8000);
+           if (river_dxe_ready) river_dxe_mmio = wcn_mmio;
+           else ml_io_unmap(wcn_mmio, 0x8000);
           }
          }
         } else {
@@ -1503,6 +1689,8 @@
       }
      }
     }
+    if (wlan_start_acked && river_dxe_ready && wcnss_wlan_info && wcnss_wlan_fifo)
+     river_passive_scan(smem, wcnss_wlan_info, wcnss_wlan_fifo, ipc_reg2);
     static const unsigned tbls[] = { 13, 266 };
     for (unsigned t = 0; t < sizeof(tbls) / sizeof(tbls[0]); t++) {
      unsigned tid = tbls[t];
@@ -1604,6 +1792,16 @@
   ri_wait(45000);
  }
  river_wcnss_probe();
+ if (river_dxe_ready) {
+  printf("RIVER DXE: persistent 10ms RX polling started\n");
+  for (unsigned ticks = 0; river_dxe_ready; ticks++) {
+   river_dxe_poll();
+   if (ticks && ticks % 3000 == 0)
+    printf("RIVER RX: total=%llu bad=%llu beacons=%llu BSS=%u\n",
+        river_rx_packets, river_rx_bad, river_rx_beacons, river_bss_count);
+   ri_wait(10);
+  }
+ }
 }
 
 static void
