+}
+
+static bool
+river_probe_tx(void)
+{
+ uint8_t f[36] = {0}; f[0] = 0x40;
+ for (unsigned k = 0; k < 6; k++) { f[4+k] = f[16+k] = 255; f[10+k] = river_test_mac[k]; }
+ f[26] = 1; f[27] = 8;
+ static const uint8_t rates[] = {0x82,0x84,0x8b,0x96,12,18,24,36};
+ memcpy(f+28, rates, sizeof(rates));
+ return river_mgmt_tx(f, sizeof(f), true);
 }
 
 /* Single outstanding HAL request, using byte-exact SMD packet lengths.
@@ -624,16 +772,17 @@
 river_scan_xact(vm_offset_t smem, uint32_t info, uint32_t fifo,
     vm_offset_t ipc, unsigned type, uint8_t *msg, unsigned len)
 {
