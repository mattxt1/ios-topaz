From: mattxt1 <matttysonx1@gmail.com>
Subject: [PATCH] RIVER: opt-in targeted BSS authentication and association

--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -426,6 +426,150 @@
 static unsigned river_bss_count;
 static const uint8_t river_test_mac[6] = {0x02, 0, 0, 0x36, 0x60, 1};
 static uint64_t river_rx_probe_responses, river_rx_probe_ours;
+/* The opt-in target is a hex SSID boot argument, never a compiled-in SSID
+ * or credential. Selection requires an exact beacon/probe-response match. */
+static struct {
+ uint8_t ssid[32], bssid[6], rates[12], rsn[22];
+ unsigned ssid_len, nrates, rsn_len, channel, beacon, caps, dtim;
+ bool enabled, found, security_ok, rates_ok;
+} river_target;
+static bool river_auth_seen, river_assoc_seen;
+static unsigned river_auth_status, river_assoc_status, river_assoc_aid;
+static unsigned river_eapol_seen;
+static uint8_t river_hal_reply[128];
+static unsigned river_hal_reply_len;
+static uint8_t river_target_bss = 255;
+static unsigned
+river_le16(const volatile uint8_t *p)
+{
+ return p[0] | ((unsigned)p[1] << 8);
+}
+static void
+river_le_put(uint8_t *p, unsigned v, unsigned n)
+{
+ for (unsigned i = 0; i < n; i++) p[i] = v >> (8 * i);
+}
+static bool
+river_mac_equal(const volatile uint8_t *a, const uint8_t *b)
+{
+ for (unsigned k = 0; k < 6; k++) if (a[k] != b[k]) return false;
+ return true;
+}
+static void
+river_target_config(void)
+{
+ char hex[65] = {0};
+ if (!PE_parse_boot_argn("riverwifi", hex, sizeof(hex))) return;
+ unsigned n = 0;
+ while (n < 65 && hex[n]) n++;
+ if (!n || n > 64 || (n & 1)) return;
+ for (unsigned i = 0; i < n; i++) {
+  unsigned v;
+  if (hex[i] >= '0' && hex[i] <= '9') v = hex[i] - '0';
+  else if (hex[i] >= 'a' && hex[i] <= 'f') v = hex[i] - 'a' + 10;
+  else if (hex[i] >= 'A' && hex[i] <= 'F') v = hex[i] - 'A' + 10;
+  else return;
+  if (!(i & 1)) river_target.ssid[i / 2] = v << 4;
+  else river_target.ssid[i / 2] |= v;
+ }
+ river_target.ssid_len = n / 2;
+ river_target.enabled = true;
+ printf("RIVER JOIN: target configured (%u SSID bytes)\n", n / 2);
+}
+static bool
+river_rsn_select(const volatile uint8_t *p, unsigned n)
+{
+ /* Only WPA2 PSK/CCMP, with no mandatory protected management frames.
+  * Copy the negotiated suite choice, not the AP's list of alternatives. */
+ if (n < 8 || river_le16(p) != 1 || p[2] || p[3] != 15 || p[4] != 172 || p[5] != 4)
+  return false;
+ unsigned count = river_le16(p + 6), off = 8;
+ bool aes = false, psk = false;
+ if (!count || count > (n - off) / 4) return false;
+ for (unsigned i = 0; i < count; i++, off += 4)
+  if (!p[off] && p[off+1] == 15 && p[off+2] == 172 && p[off+3] == 4) aes = true;
+ if (off + 2 > n) return false;
+ count = river_le16(p + off); off += 2;
+ if (!count || count > (n - off) / 4) return false;
+ for (unsigned i = 0; i < count; i++, off += 4)
+  if (!p[off] && p[off+1] == 15 && p[off+2] == 172 && p[off+3] == 2) psk = true;
+ if (off + 1 == n) return false;
+ if (!aes || !psk || (off + 2 <= n && (river_le16(p + off) & 64))) return false;
+ static const uint8_t rsn[] = {48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0};
+ memcpy(river_target.rsn, rsn, sizeof(rsn));
+ river_target.rsn_len = sizeof(rsn);
+ return true;
+}
+static void
+river_target_capture(const volatile uint8_t *f, unsigned len)
+{
+ if (!river_target.enabled || river_target.found || len < 36) return;
+ bool match = false;
+ for (unsigned off = 36; off + 2 <= len;) {
+  unsigned id = f[off], n = f[off + 1]; off += 2;
+  if (n > len - off) return;
+  if (id == 0 && n == river_target.ssid_len) {
+   unsigned k;
+   for (k = 0; k < n && f[off + k] == river_target.ssid[k]; k++) {}
+   match = k == n;
+  }
+  off += n;
+ }
+ if (!match) return;
+ river_target.caps = river_le16(f + 34);
+ river_target.beacon = river_le16(f + 32);
+ river_target.channel = river_scan_channel;
+ river_target.dtim = 1; river_target.rates_ok = true;
+ river_target.security_ok = !(river_target.caps & 16);
+ static const uint8_t supported[] = {2,4,11,22,12,18,24,36,48,72,96,108};
+ for (unsigned off = 36; off + 2 <= len;) {
+  unsigned id = f[off], n = f[off+1]; off += 2;
+  if (n > len - off) return;
+  if (id == 1 || id == 50) {
+   for (unsigned k = 0; k < n; k++) {
+    unsigned v = f[off+k], j;
+    for (j = 0; j < sizeof(supported) && (v & 127) != supported[j]; j++) {}
+    if (j == sizeof(supported)) { if (v & 128) river_target.rates_ok = false; continue; }
+    for (j = 0; j < river_target.nrates && (river_target.rates[j] & 127) != (v & 127); j++) {}
+    if (j < river_target.nrates) river_target.rates[j] |= v & 128;
+    else if (j < 12) river_target.rates[river_target.nrates++] = v;
+   }
+  }
+  if (id == 3 && n == 1) river_target.channel = f[off];
+  if (id == 5 && n >= 2 && f[off+1]) river_target.dtim = f[off+1];
+  if (id == 48) river_target.security_ok = river_rsn_select(f + off, n);
+  off += n;
+ }
+ for (unsigned k = 0; k < 6; k++) river_target.bssid[k] = f[16+k];
+ river_target.found = true;
+ printf("RIVER JOIN: target beacon channel=%u caps=%#x interval=%u DTIM=%u rates=%u security=%s supported=%u\n",
+     river_target.channel, river_target.caps, river_target.beacon, river_target.dtim,
+     river_target.nrates, river_target.rsn_len ? "WPA2-PSK/CCMP" : "open/other",
+     river_target.security_ok && river_target.rates_ok);
+}
+static void
+river_target_rx(const volatile uint8_t *f, unsigned len, unsigned hlen, unsigned fc)
+{
+ if (!river_target.found || !river_mac_equal(f + 4, river_test_mac) ||
+     !river_mac_equal(f + 10, river_target.bssid)) return;
+ if ((fc & 0xfcu) == 0xb0 && len >= 30 && river_le16(f+24) == 0 && river_le16(f+26) == 2) {
+  river_auth_seen = true; river_auth_status = river_le16(f+28);
+  printf("RIVER JOIN: authentication response status=%u\n", river_auth_status);
+ }
+ if ((fc & 0xfcu) == 0x10 && len >= 30) {
+  river_assoc_seen = true; river_assoc_status = river_le16(f+26);
+  river_assoc_aid = river_le16(f+28) & 0x3fff;
+  printf("RIVER JOIN: association response status=%u AID=%u\n", river_assoc_status, river_assoc_aid);
+ }
+ if ((fc & 0x0cu) == 8 && hlen <= len && len - hlen >= 8) {
+  static const uint8_t llc[] = {170,170,3,0,0,0,136,142};
+  unsigned k;
+  for (k = 0; k < sizeof(llc) && f[hlen+k] == llc[k]; k++) {}
+  if (k == sizeof(llc) && river_eapol_seen++ < 8)
+   printf("RIVER JOIN: received EAPOL frame (%u bytes); controlled port remains unauthorized\n", len-hlen-8);
+ }
+}
+
 static uint32_t
 river_bd_word(const volatile uint8_t *p)
 {
@@ -453,8 +597,10 @@
   printf("RIVER RX: frame %llu channel=%u fc=%#x len=%u RSSI=%d\n",
