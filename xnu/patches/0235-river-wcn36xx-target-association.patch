+  uint8_t v = i < 4 ? (uint8_t)(len >> (8*i)) : (i < 20 ? 0 : msg[i-20]);
   *(volatile uint8_t *)(smem + fifo + ((head + i) & 8191)) = v;
  }
  __asm__ volatile("dmb sy" ::: "memory");
