+/* Byte offsets and non-VHT lengths are checked against upstream hal.h by
+ * the local layout fixture. Firmware API1.5 uses v1 STA/BSS structures but
+ * WCN3660 omits the final VHT fields and retains header version0. */
+static void
+river_fill_sta(uint8_t *s, unsigned aid)
+{
+ memcpy(s, river_target.bssid, 6);
+ river_le_put(s+6, aid, 2);
+ s[9] = !!(river_target.caps & 32);
+ memcpy(s+10, river_test_mac, 6);
+ river_le_put(s+16, 10, 2); /* listen interval */
+ s[44] = river_self_sta; s[45] = river_target_bss;
+ river_le_put(s+48, 4, 4); /* STA_11bg, no HT/VHT/WMM advertised */
+ static const uint8_t ordered[] = {2,4,11,22,12,18,24,36,48,72,96,108};
+ unsigned dsss = 0, ofdm = 0;
+ for (unsigned i = 0; i < sizeof(ordered); i++)
+  for (unsigned k = 0; k < river_target.nrates; k++)
+   if ((river_target.rates[k] & 127) == ordered[i]) {
+    unsigned off = i < 4 ? 52 + 2 * dsss++ : 60 + 2 * ofdm++;
+    river_le_put(s+off, river_target.rates[k], 2);
+   }
+}
+static bool
+river_config_target_bss(vm_offset_t smem, uint32_t info, uint32_t fifo,
+    vm_offset_t ipc, bool update, unsigned aid)
+{
+ uint8_t msg[482] = {0}, *b = msg+8;
+ memcpy(b, river_target.bssid, 6); memcpy(b+6, river_test_mac, 6);
+ b[16] = 1; /* infrastructure STA, bss_type0 */
+ river_le_put(b+17, 2, 4); /* 11G network */
+ b[21] = !!(river_target.caps & 1024);
+ river_le_put(b+29, river_target.beacon, 2);
+ b[31] = river_target.dtim; b[33] = river_target.channel;
+ b[36] = river_target.ssid_len; memcpy(b+37, river_target.ssid, river_target.ssid_len);
+ b[69] = update; b[70] = river_target.nrates;
+ memcpy(b+71, river_target.rates, river_target.nrates);
+ b[355] = 10; /* request conservative power; firmware/NV limits apply */
+ river_fill_sta(b+356, aid);
+ if (!river_scan_xact(smem, info, fifo, ipc, 16, msg, 470) || river_hal_reply_len < 29)
+  return false;
+ river_target_bss = river_hal_reply[12];
+ printf("RIVER JOIN: CONFIG_BSS update=%u index=%u peer_sta=%u self_sta=%u DPU=%u\n",
+     update, river_target_bss, river_hal_reply[19], river_hal_reply[20], river_hal_reply[13]);
+ return river_target_bss < 2;
+}
+static bool
+river_target_link(vm_offset_t smem, uint32_t info, uint32_t fifo,
+    vm_offset_t ipc, unsigned state)
+{
+ uint8_t msg[24] = {0};
+ memcpy(msg+8, river_target.bssid, 6);
+ river_le_put(msg+14, state, 4); memcpy(msg+18, river_test_mac, 6);
+ return river_scan_xact(smem, info, fifo, ipc, 44, msg, sizeof(msg));
+}
+static void
+river_target_associate(vm_offset_t smem, uint32_t info, uint32_t fifo, vm_offset_t ipc)
+{
+ if (!river_target.enabled) return;
+ if (!river_target.found || !river_self_ready || !river_dxe_ready || river_tx_stalled ||
+     !river_target.security_ok || !river_target.rates_ok || !river_target.nrates ||
+     river_target.channel < 1 || river_target.channel > 11) {
+  printf("RIVER JOIN: target unavailable or unsupported; authentication withheld\n");
+  return;
+ }
+ river_scan_channel = river_target.channel;
+ if (!river_target_link(smem, info, fifo, ipc, 1)) return; /* PREASSOC */
+ uint8_t join[31] = {0};
+ memcpy(join+8, river_target.bssid, 6); join[14] = river_target.channel;
+ memcpy(join+15, river_test_mac, 6); join[26] = 1; join[30] = 0xbf;
+ bool ok = river_scan_xact(smem, info, fifo, ipc, 20, join, sizeof(join));
+ if (ok) ok = river_config_target_bss(smem, info, fifo, ipc, false, 0);
+ if (ok) {
+  uint8_t auth[30] = {0}; auth[0] = 0xb0;
+  memcpy(auth+4, river_target.bssid, 6); memcpy(auth+10, river_test_mac, 6);
+  memcpy(auth+16, river_target.bssid, 6); auth[26] = 1; /* open-system sequence1 */
+  river_auth_seen = false;
+  ok = river_mgmt_tx(auth, sizeof(auth), false);
+  for (unsigned w = 0; ok && !river_auth_seen && w < 100; w++) { river_dxe_poll(); ri_wait(10); }
+  ok = ok && river_auth_seen && river_auth_status == 0;
+  printf("RIVER JOIN: authentication accepted=%u response=%u status=%u\n", ok, river_auth_seen, river_auth_status);
+ }
+ if (ok) {
+  uint8_t assoc[128] = {0};
+  memcpy(assoc+4, river_target.bssid, 6); memcpy(assoc+10, river_test_mac, 6);
+  memcpy(assoc+16, river_target.bssid, 6);
+  river_le_put(assoc+24, river_target.caps & (1u|16u|32u|1024u), 2);
+  river_le_put(assoc+26, 10, 2);
+  unsigned n = 28; assoc[n++] = 0; assoc[n++] = river_target.ssid_len;
+  memcpy(assoc+n, river_target.ssid, river_target.ssid_len); n += river_target.ssid_len;
+  unsigned rates = river_target.nrates < 8 ? river_target.nrates : 8;
+  assoc[n++] = 1; assoc[n++] = rates; memcpy(assoc+n, river_target.rates, rates); n += rates;
+  if (river_target.nrates > 8) {
+   assoc[n++] = 50; assoc[n++] = river_target.nrates-8;
+   memcpy(assoc+n, river_target.rates+8, river_target.nrates-8); n += river_target.nrates-8;
+  }
+  memcpy(assoc+n, river_target.rsn, river_target.rsn_len); n += river_target.rsn_len;
+  river_assoc_seen = false;
+  ok = river_mgmt_tx(assoc, n, false);
+  for (unsigned w = 0; ok && !river_assoc_seen && w < 100; w++) { river_dxe_poll(); ri_wait(10); }
+  ok = ok && river_assoc_seen && river_assoc_status == 0 && river_assoc_aid && river_assoc_aid <= 2007;
+  printf("RIVER JOIN: AP association accepted=%u response=%u status=%u AID=%u\n",
+      ok, river_assoc_seen, river_assoc_status, river_assoc_aid);
+ }
+ if (ok) ok = river_target_link(smem, info, fifo, ipc, 2); /* POSTASSOC */
+ if (ok) ok = river_config_target_bss(smem, info, fifo, ipc, true, river_assoc_aid);
+ if (ok) {
+  uint8_t sta[124] = {0}; river_fill_sta(sta+8, river_assoc_aid);
+  ok = river_scan_xact(smem, info, fifo, ipc, 12, sta, 114);
+ }
+ printf("RIVER JOIN: firmware association setup=%u; controlled data port CLOSED, WPA keys absent\n", ok);
+ if (!ok) {
+  if (river_target_bss != 255) {
+   uint8_t del[9] = {0}; del[8] = river_target_bss;
+   (void)river_scan_xact(smem, info, fifo, ipc, 18, del, sizeof(del));
+  }
+  (void)river_target_link(smem, info, fifo, ipc, 0);
+ }
+}
