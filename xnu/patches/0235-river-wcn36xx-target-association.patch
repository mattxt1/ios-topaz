+ river_target_rx(f, len, hlen, fc);
  if ((fc & 0xfcu) != 0x80 && (fc & 0xfcu) != 0x50) return;
  if (len < 36) { river_rx_bad++; return; }
+ river_target_capture(f, len);
  river_rx_beacons++;
  if ((fc & 0xfcu) == 0x50) {
