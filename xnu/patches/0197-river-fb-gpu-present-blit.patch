 #if defined(RIVER)
+		/*
+		 * 0197: a full-screen 32-bit layer goes to the back buffer by the GPU's
+		 * 2D blitter; the CPU never reads it (no copy, nothing to go stale).
+		 */
+		if (river_blit < 0) {
+			river_blit = 0;
+			PE_parse_boot_argn("riverblit", &river_blit, sizeof(river_blit));
+			IOLog("RIVER FB: GPU present %s\n", river_blit ? "on (riverblit=1)" : "off");
+		}
+		if (river_blit && src != 0 && bpe == 4 && fFlip[0] != NULL && dx == 0 && dy == 0 &&
+		    w == (int32_t)fWidth && h == (int32_t)fHeight) {
+			uint32_t back = fFlipIdx ^ 1;
+			if (!river_blit_flushed) {
+				/* no CPU lines of the flip buffers may later land on GPU pixels */
+				for (int i = 0; i < 2; i++) {
