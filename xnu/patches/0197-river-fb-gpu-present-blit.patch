+				IOLog("RIVER FB: GPU present failed (%d), CPU copy instead\n", err);
+			}
+			absolutetime_to_nanoseconds(t1 - river_blit_report, &ns);
+			if (ns >= 10000000000ULL) {
+				if (river_blit_report != 0) {
+					IOLog("RIVER FB: 10 s: %u GPU presents (avg %llu us), %u fell back\n", river_blit_ok,
+					    river_blit_ok ? river_blit_ns / river_blit_ok / 1000 : 0, river_blit_fail);
+				}
+				river_blit_report = t1;
+				river_blit_ok = river_blit_fail = 0;
+				river_blit_ns = 0;
+			}
