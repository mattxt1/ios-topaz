+			uint64_t first = s->memory->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+			uint64_t start = (first & PAGE_MASK) + s->offset;
+			uint32_t npages = (uint32_t)((start + s->memory->getLength() + PAGE_MASK) / PAGE_SIZE);
+			uint64_t *pa = first ? (uint64_t *)IOMallocData(npages * sizeof(uint64_t)) : NULL;
+			bool have = pa != NULL;
+			for (uint32_t p = 0; have && p < npages; p++) {
+				uint64_t at = p == 0 ? 0 : (uint64_t)p * PAGE_SIZE - (first & PAGE_MASK);
+				uint64_t phys = s->memory->getPhysicalSegment(at, &seg, kIOMemoryMapperNone);
+				pa[p] = phys & ~(uint64_t)PAGE_MASK;
+				have = phys != 0;
+			}
+			uint64_t t0 = mach_absolute_time();
+			int err = have ? river_gpu_blit(pa, npages, start, s->bytesPerRow, (uint32_t)sx, (uint32_t)sy,
+			    fFlipPhys[back], fFlip[back]->getLength(), fRowBytes, 0, 0, (uint32_t)w, (uint32_t)h, 50) : ENOMEM;
+			uint64_t t1 = mach_absolute_time(), ns;
