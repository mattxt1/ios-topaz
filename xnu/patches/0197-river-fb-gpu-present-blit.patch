diff --git a/bsd/dev/river_gpu.c b/bsd/dev/river_gpu.c
index 2fa188f..f6a7da8 100644
--- a/bsd/dev/river_gpu.c
+++ b/bsd/dev/river_gpu.c
@@ -1229,6 +1229,135 @@ river_gpu_fence_done(uint32_t fence)
 	return rgpu_fence_done(fence);
 }
 
+/*
+ * 0197: GPU present. Copy a w x h rectangle of 32-bit pixels from a surface
+ * (physical pages pa[], pixel (0,0) at byte start of the first page, row
+ * pitch src_pitch) at (sx, sy) to a physically contiguous buffer (the panel's
+ * back buffer, pitch dst_pitch) at (dx, dy), with the A5xx 2D blitter, as
+ * Mesa's fd5_blitter emit_setup + emit_blit (BLIT_OP_COPY, R8G8B8A8, linear,
+ * WZYX: the bytes are copied unchanged). Both are mapped into fixed GPU
+ * windows above the buffer heap for the call. The CPU never reads the
+ * surface. Returns 0, or an errno.
+ */
+#define RGPU_BLIT_DST_VA	0xf0000000ULL	/* <= 16 MiB */
+#define RGPU_BLIT_SRC_VA	0xf1000000ULL	/* <= 48 MiB */
+#define REG_A5XX_RB_RENDER_CNTL		0xe141
+#define REG_A5XX_RB_2D_BLIT_CNTL	0x2100
+#define REG_A5XX_GRAS_2D_BLIT_CNTL	0x2180
+#define REG_A5XX_UNKNOWN_2184		0x2184
+#define REG_A5XX_RB_CNTL		0xe140
+#define REG_A5XX_RB_MODE_CNTL		0x0cc6
+#define REG_A5XX_SP_MODE_CNTL		0x0ec2
+#define REG_A5XX_TPL1_MODE_CNTL		0x0f02
+#define REG_A5XX_HLSQ_MODE_CNTL		0x0e06
+#define REG_A5XX_GRAS_CL_CNTL		0xe000
+#define REG_A5XX_RB_2D_SRC_INFO		0x2107
+#define REG_A5XX_RB_2D_DST_INFO		0x2110
+#define REG_A5XX_GRAS_2D_SRC_INFO	0x2181
+#define REG_A5XX_GRAS_2D_DST_INFO	0x2182
+#define CP_WAIT_FOR_IDLE		38
+#define CP_SET_RENDER_MODE		108
+#define CP_BLIT				44
+#define RENDER_MODE_BLIT2D		5
+#define RENDER_MODE_END2D		8
+#define BLIT_OP_COPY			1
+#define RB5_R8G8B8A8_UNORM		48
+
+static int rgpu_blit_slot = -1;
+
+int river_gpu_blit(const uint64_t *pa, uint32_t npages, uint64_t start, uint32_t src_pitch, uint32_t sx, uint32_t sy,
+    uint64_t dst_pa, uint64_t dst_size, uint32_t dst_pitch, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h,
+    uint32_t timeout_ms);
+int
+river_gpu_blit(const uint64_t *pa, uint32_t npages, uint64_t start, uint32_t src_pitch, uint32_t sx, uint32_t sy,
+    uint64_t dst_pa, uint64_t dst_size, uint32_t dst_pitch, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h,
+    uint32_t timeout_ms)
+{
+	uint64_t src_bytes = (uint64_t)npages * PAGE_SIZE;
+	uint64_t dst_bytes = (dst_size + 0xfff) & ~0xfffULL;
+	if (!rgpu_up || w == 0 || h == 0 || w > 16383 || h > 16383 || (src_pitch & 63) || (dst_pitch & 63) ||
+	    (dst_pa & 63) || src_bytes > 48ULL * 1024 * 1024 || dst_bytes > 16ULL * 1024 * 1024) {
+		return EINVAL;
+	}
+	if (rgpu_blit_slot < 0) {
+		rgpu_blit_slot = rgpu_bo_alloc(PAGE_SIZE);	/* the command buffer, kept */
+		if (rgpu_blit_slot < 0) {
+			return ENOMEM;
+		}
+	}
+	/* pixel (0,0) must be 64-byte aligned: move the misalignment into x */
+	uint64_t src_base = RGPU_BLIT_SRC_VA + (start & ~63ULL);
+	sx += (uint32_t)((start & 63) / 4);
+	if (sx + w - 1 > 16383) {
+		return EINVAL;
+	}
+
+	lck_mtx_lock(rgpu_lock);
+	bool ok = gmmu_map(RGPU_BLIT_DST_VA, dst_pa & ~0xfffULL, dst_bytes, false);
+	for (uint32_t p = 0; ok && p < npages; p++) {
+		ok = gmmu_map(RGPU_BLIT_SRC_VA + (uint64_t)p * PAGE_SIZE, pa[p], PAGE_SIZE, true);
+	}
+	gmmu_sync();
+	lck_mtx_unlock(rgpu_lock);
+	uint64_t dst_base = RGPU_BLIT_DST_VA + (dst_pa & 0xfffULL);
+
+	struct rgpu_bo *ibo = &rgpu_bos[rgpu_blit_slot];
+	uint32_t *c = (uint32_t *)ibo->va, n = 0;
+#define B(v) (c[n++] = (v))
+	B(pkt4(REG_A5XX_RB_RENDER_CNTL, 1)); B(0x00000008);
+	B(pkt4(REG_A5XX_RB_2D_BLIT_CNTL, 1)); B(0x86000000);
+	B(pkt4(REG_A5XX_GRAS_2D_BLIT_CNTL, 1)); B(0x86000000);
+	B(pkt4(REG_A5XX_UNKNOWN_2184, 1)); B(0x00000009);
+	B(pkt4(REG_A5XX_RB_CNTL, 1)); B(0x00020000);		/* BYPASS */
+	B(pkt4(REG_A5XX_RB_MODE_CNTL, 1)); B(0x00000004);
+	B(pkt4(REG_A5XX_SP_MODE_CNTL, 1)); B(0x0000000c);
+	B(pkt4(REG_A5XX_TPL1_MODE_CNTL, 1)); B(0x00000344);
+	B(pkt4(REG_A5XX_HLSQ_MODE_CNTL, 1)); B(0x00000002);
+	B(pkt4(REG_A5XX_GRAS_CL_CNTL, 1)); B(0x00000181);
+	B(pkt7(CP_SET_RENDER_MODE, 1)); B(RENDER_MODE_BLIT2D);
+	B(pkt4(REG_A5XX_RB_2D_SRC_INFO, 9));
+	B(RB5_R8G8B8A8_UNORM);					/* linear, WZYX */
+	B((uint32_t)src_base); B((uint32_t)(src_base >> 32));
+	B(src_pitch >> 6);					/* ARRAY_PITCH 0: one layer */
+	B(0); B(0); B(0); B(0); B(0);
+	B(pkt4(REG_A5XX_GRAS_2D_SRC_INFO, 1)); B(RB5_R8G8B8A8_UNORM);
+	B(pkt4(REG_A5XX_RB_2D_DST_INFO, 9));
+	B(RB5_R8G8B8A8_UNORM);
+	B((uint32_t)dst_base); B((uint32_t)(dst_base >> 32));
+	B(dst_pitch >> 6);
+	B(0); B(0); B(0); B(0); B(0);
+	B(pkt4(REG_A5XX_GRAS_2D_DST_INFO, 1)); B(RB5_R8G8B8A8_UNORM);
+	B(pkt7(CP_BLIT, 5));
+	B(BLIT_OP_COPY);
+	B(sx | (sy << 16));
+	B((sx + w - 1) | ((sy + h - 1) << 16));
+	B(dx | (dy << 16));
+	B((dx + w - 1) | ((dy + h - 1) << 16));
+	B(pkt7(CP_SET_RENDER_MODE, 1)); B(RENDER_MODE_END2D);
+	B(pkt7(CP_WAIT_FOR_IDLE, 0));
+#undef B
+	flush_dcache64((addr64_t)ibo->va, n * 4, FALSE);
+
+	int err = 0;
+	if (!ok) {
+		err = ENOMEM;
+	} else {
+		uint64_t ib = ibo->gpuva;
+		uint32_t seq = rgpu_submit(&ib, &n, 1);
+		if (!rgpu_wait(seq, timeout_ms)) {
+			err = ETIMEDOUT;
+		}
+	}
+	if (err != ETIMEDOUT) {		/* a GPU still blitting keeps its mapping */
+		lck_mtx_lock(rgpu_lock);
+		gmmu_unmap(RGPU_BLIT_DST_VA, dst_bytes);
+		gmmu_unmap(RGPU_BLIT_SRC_VA, src_bytes);
+		gmmu_sync();
+		lck_mtx_unlock(rgpu_lock);
+	}
+	return err;
+}
+
 int river_gpu_wait(uint32_t fence, uint32_t ms);
 int
 river_gpu_wait(uint32_t fence, uint32_t ms)
