diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -13,7 +13,81 @@
 #include <pexpert/arm64/board_config.h>
 
 
-#if HAS_GIC_V3
+#if defined(RIVER)
+/* River's GICv2 has banked SGI/PPI registers and an MMIO CPU interface. */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+static vm_offset_t river_gicd_base;
+vm_offset_t river_gicc_base;
+
+static uint32_t
+river_gic_read32(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static void
+river_gic_write32(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+void
+river_gic_mask_intid(uint32_t intid)
+{
+	if (intid < 1020) {
+		river_gic_write32(river_gicd_base + 0x180 + 4 * (intid / 32),
+		    1U << (intid % 32)); /* GICD_ICENABLERn */
+	}
+}
+
+void
+pe_init_fiq(void)
+{
+	if (!river_gicd_base) {
+		DTEntry entry;
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+			panic("river: missing /arm-io/gic");
+		}
+		void const *reg;
+		unsigned int reg_size;
+		if (SecureDTGetProperty(entry, "reg", &reg, &reg_size) != kSuccess ||
+		    reg_size < 4 * sizeof(uint64_t)) {
+			panic("river: invalid GICv2 reg property");
+		}
+		void const *timer;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer,
+		    &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("river: invalid virtual timer INTID property");
+			}
+			sweet_vtimer_intid = *(const uint32_t *)timer;
+		}
+		if (sweet_vtimer_intid < 16 || sweet_vtimer_intid >= 32) {
+			panic("river: virtual timer INTID is not a PPI");
+		}
+		uint64_t const *regions = (uint64_t const *)reg;
+		vm_offset_t soc = pe_arm_get_soc_base_phys();
+		river_gicd_base = ml_io_map(soc + regions[0], regions[1]);
+		river_gicc_base = ml_io_map(soc + regions[2], regions[3]);
+		if (!river_gicd_base || !river_gicc_base) {
+			panic("river: cannot map GICv2 registers");
+		}
+	}
+
+	uint32_t bit = 1U << sweet_vtimer_intid;
+	vm_offset_t d = river_gicd_base;
+	vm_offset_t c = river_gicc_base;
+	river_gic_write32(d + 0x80, river_gic_read32(d + 0x80) | bit); /* IGROUPR0 */
+	*(volatile uint8_t *)(d + 0x400 + sweet_vtimer_intid) = 0xa0;
+	river_gic_write32(d + 0x100, bit); /* ISENABLER0 */
+	river_gic_write32(d, river_gic_read32(d) | 1U); /* Enable Group 1 */
+	river_gic_write32(c + 0x4, 0xff); /* GICC_PMR */
+	river_gic_write32(c, river_gic_read32(c) | 1U); /* GICC_CTLR */
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+}
+
+#elif HAS_GIC_V3
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 
