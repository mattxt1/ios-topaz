diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..370d1b3 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -13,7 +13,120 @@
 #include <pexpert/arm64/board_config.h>
 
 
-#if HAS_GIC_V3
+#if defined(RIVER)
+/*
+ * river (SDM632): Qualcomm GICv2 with Security Extensions, entered in
+ * Non-secure EL1. SGI/PPI enable, priority and target registers are banked
+ * per CPU, and the CPU interface is MMIO (no ICC_* system registers: they
+ * are UNDEFINED on these cores). The virtual timer and IPIs are Group 1 IRQs
+ * taken through sleh_irq(); NS writes to GICD_IGROUPR are ignored, so their
+ * group is whatever the secure firmware set (Group 1 on the measured phone).
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+static vm_offset_t river_gicd_base;
+vm_offset_t river_gicc_base;
+/* GIC CPU interface bit of each Gold core, indexed by MPIDR Aff0. */
+static uint8_t river_gic_iface[4];
+
+static uint32_t
+river_gic_read32(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static void
+river_gic_write32(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+void
+river_gic_mask_intid(uint32_t intid)
+{
+	if (intid < 1020) {
+		river_gic_write32(river_gicd_base + GICD_V2_ICENABLER0 + 4 * (intid / 32),
+		    1U << (intid % 32));
+	}
+}
+
+/* Raise SWEET_IPI_SGI on the Gold core with this MPIDR (SweetCPU::signalCPU). */
+void
+river_gic_send_sgi(uint64_t mpidr)
+{
+	unsigned int aff0 = mpidr & 3;
+	uint32_t iface = river_gic_iface[aff0];
+	if (((mpidr >> 8) & 0xff) != 1 || (mpidr & 0xfc)) {
+		panic("river: SGI target 0x%llx is not a Gold core", mpidr);
+	}
+	if (iface == 0) {
+		/* Not yet in pe_init_fiq: SDM632 numbers Gold interfaces 4-7. */
+		iface = (uint8_t)(1U << (4 + aff0));
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+	/* TargetListFilter 0: the CPUTargetList in bits 23:16; NSATT 0 */
+	river_gic_write32(river_gicd_base + GICD_V2_SGIR, ((uint32_t)iface << 16) | SWEET_IPI_SGI);
+}
+
+void
+pe_init_fiq(void)
+{
+	if (!river_gicd_base) {
+		DTEntry entry;
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+			panic("river: missing /arm-io/gic");
+		}
+		void const *reg;
+		unsigned int reg_size;
+		if (SecureDTGetProperty(entry, "reg", &reg, &reg_size) != kSuccess ||
+		    reg_size < 4 * sizeof(uint64_t)) {
+			panic("river: invalid GICv2 reg property");
+		}
+		void const *timer;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer,
+		    &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("river: invalid virtual timer INTID property");
+			}
+			sweet_vtimer_intid = *(const uint32_t *)timer;
+		}
+		if (sweet_vtimer_intid < 16 || sweet_vtimer_intid >= 32) {
+			panic("river: virtual timer INTID is not a PPI");
+		}
+		uint64_t const *regions = (uint64_t const *)reg;
+		vm_offset_t soc = pe_arm_get_soc_base_phys();
+		river_gicd_base = ml_io_map(soc + regions[0], regions[1]);
+		river_gicc_base = ml_io_map(soc + regions[2], regions[3]);
+		if (!river_gicd_base || !river_gicc_base) {
+			panic("river: cannot map GICv2 registers");
+		}
+		kprintf("RIVER GIC: v2 virtual timer INTID %u\n", sweet_vtimer_intid);
+	}
+
+	vm_offset_t d = river_gicd_base;
+	vm_offset_t c = river_gicc_base;
+	/* Banked GICD_ITARGETSR0..7 read back this CPU's own interface bit. */
+	uint8_t iface = (uint8_t)river_gic_read32(d + GICD_V2_ITARGETSR0);
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	if (iface == 0 || (iface & (iface - 1))) {
+		panic("river: GICD_ITARGETSR0 reads 0x%x on MPIDR 0x%llx", iface, mpidr & 0xffff);
+	}
+	river_gic_iface[mpidr & 3] = iface;
+
+	uint32_t bits = (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI);
+	river_gic_write32(d + GICD_V2_IGROUPR0, river_gic_read32(d + GICD_V2_IGROUPR0) | bits);
+	*(volatile uint8_t *)(d + GICD_V2_IPRIORITYR + sweet_vtimer_intid) = 0xa0;
+	*(volatile uint8_t *)(d + GICD_V2_IPRIORITYR + SWEET_IPI_SGI) = 0xa0;
+	/* SGI enable bits may be RAO/WI; PPI enables are banked. */
+	river_gic_write32(d + GICD_V2_ISENABLER0, bits);
+	river_gic_write32(d + GICD_CTLR, river_gic_read32(d + GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	river_gic_write32(c + GICC_V2_PMR, 0xff);
+	river_gic_write32(c + GICC_V2_CTLR, river_gic_read32(c + GICC_V2_CTLR) | 1U); /* EnableGrp1 */
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+	kprintf("RIVER GIC: cpu mpidr 0x%llx interface 0x%x\n", mpidr & 0xffff, iface);
+}
+
+#elif HAS_GIC_V3
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 
