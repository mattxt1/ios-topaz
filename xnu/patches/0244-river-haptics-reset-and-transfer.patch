 }
 static bool
 ri_spmi_write(vm_offset_t chnl, unsigned addr, uint8_t val)
 {
  if (!chnl) return false;
  ri_wr(chnl, 0x10, (uint32_t)val);
- ri_wr(chnl, 0x00, (3u << 27) | ((addr & 0xff) << 4));
+ /* PMIC arbiter opcode 0 = EXT_WRITEL; opcode 3 is RESET. */
+ ri_wr(chnl, 0x00, (addr & 0xff) << 4);
  for (unsigned i = 0; i < 2000; i++) {
   uint32_t s = ri_rd(chnl, 0x08);
-  if (s & 1) { ri_wr(chnl, 0x08, 1); return true; }
-  if (s & 0xe) { ri_wr(chnl, 0x08, s & 0xf); return false; }
+  if (s & 1) {
+   if (!(s & 0xe)) return true;
+   printf("RIVER HAPTICS: SPMI write reg=%#x status=%#x\n", addr, s);
+   return false;
+  }
   delay(1);
  }
+ printf("RIVER HAPTICS: SPMI write timeout reg=%#x status=%#x\n", addr, ri_rd(chnl, 8));
+ return false;
+}
+
+/* Read back every reset configuration write through the observer channel. */
+static bool
+ri_reset_wr(vm_offset_t ch, vm_offset_t obs, unsigned reg, uint8_t val)
+{
+ uint32_t got = 0;
+ if (ri_spmi_write(ch, reg, val) && ri_spmi_read(obs, reg, 1, &got) && (got & 0xff) == val) return true;
+ printf("RIVER HAPTICS: reset verify reg=%#x want=%#x got=%#x\n", reg, val, got);
  return false;
 }
 
