diff --git a/iokit/Kernel/arm/RiverGPU.cpp b/iokit/Kernel/arm/RiverGPU.cpp
new file mode 100644
index 0000000..00cd2ab
--- /dev/null
+++ b/iokit/Kernel/arm/RiverGPU.cpp
@@ -0,0 +1,200 @@
+/*
+ * RiverGPU: user-space interface to the river (Moto G7, SDM632) Adreno 506
+ * kernel GPU service in bsd/dev/river_gpu.c.
+ *
+ * The class matches IOResources once river_gpu.c publishes the
+ * "RiverGPUReady" resource (GPU powered, zap shader loaded, CP running, its
+ * self-test passed). Clients open it with IOServiceOpen(type 0) and use:
+ *
+ *   0 GET_PARAM   scalar in  { param }               out { value }
+ *   1 BO_NEW      scalar in  { size }                out { handle, gpuva, size }
+ *   2 BO_FREE     scalar in  { handle }
+ *   3 SUBMIT      struct in  { u32 ncmd, u32 nbos,
+ *                              ncmd x { u32 handle, u32 offset, u32 size_dw },
+ *                              nbos x u32 handle }  out { fence }
+ *   4 WAIT        scalar in  { fence, timeout_ms }
+ *   5 CPU_PREP    scalar in  { handle, timeout_ms }
+ *
+ * IOConnectMapMemory64(type = handle) maps a buffer into the caller, cached
+ * (SUBMIT cleans every named buffer; CPU_PREP waits and invalidates). This
+ * is the msm DRM model (GEM_NEW / GEM_INFO / GEM_SUBMIT / WAIT_FENCE /
+ * GEM_CPU_PREP) that Mesa's freedreno expects, behind an IOKit connection.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <sys/errno.h>
+
+#if defined(RIVER)
+extern "C" {
+struct river_gpu_cmd {
+	uint32_t handle, offset, size_dw;
+};
+bool river_gpu_is_ready(void);
+uint64_t river_gpu_param(uint32_t param);
+uint32_t river_gpu_bo_new(void *owner, uint64_t size, uint64_t *gpuva, uint64_t *rsize);
+int river_gpu_bo_kva(void *owner, uint32_t handle, vm_offset_t *kva, uint64_t *size);
+int river_gpu_bo_free(void *owner, uint32_t handle);
+int river_gpu_submit(void *owner, const struct river_gpu_cmd *cmd, uint32_t ncmd,
+    const uint32_t *bos, uint32_t nbos, uint32_t *fence);
+int river_gpu_wait(uint32_t fence, uint32_t ms);
+int river_gpu_cpu_prep(void *owner, uint32_t handle, uint32_t ms);
+void river_gpu_owner_release(void *owner);
+void river_gpu_publish(void);
+}
+
+void
+river_gpu_publish(void)
+{
+	IOService::publishResource("RiverGPUReady");
+}
+
+class RiverGPU : public IOService {
+	OSDeclareDefaultStructors(RiverGPU);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RiverGPU, IOService);
+
+bool
+RiverGPU::start(IOService *provider)
+{
+	if (!river_gpu_is_ready() || !IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "RiverGPUUserClient");
+	setProperty("chip-id", river_gpu_param(0), 32);
+	setProperty("gpu-id", river_gpu_param(1), 32);
+	registerService();
+	IOLog("RIVER GPU: RiverGPU service registered\n");
+	return true;
+}
+
+class RiverGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(RiverGPUUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RiverGPUUserClient, IOUserClient);
+
+IOReturn
+RiverGPUUserClient::clientClose(void)
+{
+	river_gpu_owner_release(this);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+river_gpu_ioreturn(int err)
+{
+	switch (err) {
+	case 0: return kIOReturnSuccess;
+	case ETIMEDOUT: return kIOReturnTimeout;
+	case EBUSY: return kIOReturnBusy;
+	case ENOMEM: return kIOReturnNoMemory;
+	default: return kIOReturnBadArgument;
+	}
+}
+
+IOReturn
+RiverGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	const uint64_t *in = args->scalarInput;
+	uint32_t nin = args->scalarInputCount, nout = args->scalarOutputCount;
+
+	switch (selector) {
+	case 0:		/* GET_PARAM */
+		if (nin != 1 || nout < 1) {
+			return kIOReturnBadArgument;
+		}
+		args->scalarOutput[0] = river_gpu_param((uint32_t)in[0]);
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+	case 1: {	/* BO_NEW */
+		if (nin != 1 || nout < 3) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t gpuva = 0, size = 0;
+		uint32_t h = river_gpu_bo_new(this, in[0], &gpuva, &size);
+		if (h == 0) {
+			return kIOReturnNoMemory;
+		}
+		args->scalarOutput[0] = h;
+		args->scalarOutput[1] = gpuva;
+		args->scalarOutput[2] = size;
+		args->scalarOutputCount = 3;
+		return kIOReturnSuccess;
+	}
+	case 2:		/* BO_FREE */
+		if (nin != 1) {
+			return kIOReturnBadArgument;
+		}
+		args->scalarOutputCount = 0;
+		return river_gpu_ioreturn(river_gpu_bo_free(this, (uint32_t)in[0]));
+	case 3: {	/* SUBMIT */
+		const void *buf = args->structureInput;
+		uint32_t len = args->structureInputSize;
+		if (args->structureInputDescriptor != NULL || buf == NULL || len < 8 || nout < 1) {
+			return kIOReturnBadArgument;
+		}
+		const uint32_t *w = (const uint32_t *)buf;
+		uint64_t need = 8 + (uint64_t)w[0] * sizeof(struct river_gpu_cmd) + (uint64_t)w[1] * 4;
+		if (need != len) {
+			return kIOReturnBadArgument;
+		}
+		const struct river_gpu_cmd *cmd = (const struct river_gpu_cmd *)(w + 2);
+		const uint32_t *bos = (const uint32_t *)(cmd + w[0]);
+		uint32_t fence = 0;
+		IOReturn r = river_gpu_ioreturn(river_gpu_submit(this, cmd, w[0], bos, w[1], &fence));
+		args->scalarOutput[0] = fence;
+		args->scalarOutputCount = 1;
+		return r;
+	}
+	case 4:		/* WAIT */
+		if (nin != 2) {
+			return kIOReturnBadArgument;
+		}
+		args->scalarOutputCount = 0;
+		return river_gpu_ioreturn(river_gpu_wait((uint32_t)in[0], (uint32_t)in[1]));
+	case 5:		/* CPU_PREP */
+		if (nin != 2) {
+			return kIOReturnBadArgument;
+		}
+		args->scalarOutputCount = 0;
+		return river_gpu_ioreturn(river_gpu_cpu_prep(this, (uint32_t)in[0], (uint32_t)in[1]));
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+
+IOReturn
+RiverGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	vm_offset_t kva = 0;
+	uint64_t size = 0;
+	if (river_gpu_bo_kva(this, type, &kva, &size) != 0) {
+		return kIOReturnBadArgument;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)kva,
+	    size, kIODirectionInOut, kernel_task);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	*options = 0;
+	*memory = md;
+	return kIOReturnSuccess;
+}
