 	}
 }
 
+#if defined(RIVER)
+/*
+ * Touch-to-wake: with iOS's display off (auto-lock), a finger landing on the
+ * glass sends one short Power press, as the side button does, and that touch
+ * is swallowed until it lifts so waking never taps the woken screen. Apple's
+ * digitizer has a dedicated wake gesture; this panel's firmware does not.
+ */
+extern "C" bool sweet_fb_display_off(void);
+static bool sweet_touch_waking[SWEET_TOUCH_FINGERS];
+#endif
+
 extern "C" void
 sweet_hid_touch(int finger, int down, int x, int y)
 {
+#if defined(RIVER)
+	if (finger >= 0 && finger < SWEET_TOUCH_FINGERS) {
+		if (sweet_touch_waking[finger]) {
+			if (!down) {
+				sweet_touch_waking[finger] = false;
+			}
+			return;
+		}
+		if (down && sweet_fb_display_off()) {
+			bool other = false;
+			for (int i = 0; i < SWEET_TOUCH_FINGERS; i++) {
+				other |= sweet_touch_waking[i];
+			}
+			sweet_touch_waking[finger] = true;
+			if (!other) {
+				IOLog("SWEET HID: touch %d wakes the display\n", finger);
+				sweet_hid_key(0, 1);
+				sweet_hid_key(0, 0);
+			}
+			return;
+		}
+	}
+#endif
 	if (gSweetTouch) {
 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
