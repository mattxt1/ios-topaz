@@ -221,12 +221,56 @@ ri_thread(void *arg, wait_result_t result)
   ri_wait(10);
  }
 }
+/* Wall clock from the PM8953 RTC (SID0 0x6000, qpnp-rtc layout): 32-bit
+ * seconds at 0x48..0x4b, enable in 0x46 bit 7. Read-only, through the
+ * SPMI observer channel of the RTC_RW peripheral (PPID 0x060). Boot-arg
+ * riverrtcoff=N adds N seconds (the RTC may count from another epoch). */
+static bool
+ri_spmi_read(vm_offset_t obs, unsigned addr, unsigned count, uint32_t *v)
+{
+ ri_wr(obs, 0, (1u << 27) | ((addr & 0xff) << 4) | ((count - 1) & 7));
+ for (unsigned i = 0; i < 1000; i++) {
+  unsigned st = ri_rd(obs, 8);
+  if (st & 1) { if (st & 14) return false; *v = ri_rd(obs, 0x18); return true; }
+  delay(1);
+ }
+ return false;
+}
+static void
+river_rtc_init(void)
+{
+ vm_offset_t core = ri_map(0x0200f000), obs = 0;
+ if (!core) return;
+ uint32_t ver = ri_rd(core, 0);
+ if (ver < 0x20010000 || ver >= 0x50000000) return;
+ for (unsigned i = 0; i < 256 && !obs; i++) {
+  if (((ri_rd(core, 0x800 + i*4) >> 8) & 0xfff) == 0x060) obs = ri_map(0x02c00000 + i*0x8000);
+ }
+ uint32_t ctrl = 0, a = 0, b0 = 0, b = 0;
+ if (!obs || !ri_spmi_read(obs, 0x46, 1, &ctrl) || !ri_spmi_read(obs, 0x48, 4, &a) ||
+     !ri_spmi_read(obs, 0x48, 1, &b0)) {
+  printf("RIVER RTC: PM8953 RTC not readable\n");
+  return;
+ }
+ b = a;
+ if ((b0 & 0xff) < (a & 0xff) && !ri_spmi_read(obs, 0x48, 4, &b)) return;	/* byte 0 rolled over */
+ int off = 0;
+ PE_parse_boot_argn("riverrtcoff", &off, sizeof(off));
+ uint64_t secs = (uint64_t)b + (int64_t)off;
+ printf("RIVER RTC: ctrl %#x raw %u offset %d -> %llu\n", ctrl & 0xff, b, off, secs);
+ if (!(ctrl & 0x80) || secs < 1577836800ULL) {	/* disabled, or before 2020 */
+  printf("RIVER RTC: not plausible; calendar left unset\n");
+  return;
+ }
+ clock_set_calendar_microtime((clock_sec_t)secs, 0);
+}
 void
 river_input_init(void)
 {
  int enabled=0;
  if(ri_started) return;
  ri_started=true;
+ river_rtc_init();
  if(!PE_parse_boot_argn("riverinput",&enabled,sizeof(enabled)) || enabled!=1) return;
  thread_t t;
  if(kernel_thread_start(ri_thread,NULL,&t)==KERN_SUCCESS)thread_deallocate(t);
