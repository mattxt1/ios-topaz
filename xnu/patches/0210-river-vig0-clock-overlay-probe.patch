+AppleCLCD::fitScanFrom(uint64_t pa)
+{
+	volatile uint32_t *p = fFitPipe;
+	/* QSEED2 VIG0: 21-bit phase steps and PCMN downscale. */
+	p[0x00 / 4] = (2436u << 16) | 1125u;
+	p[0x04 / 4] = (2436u << 16) | 1125u;
+	p[0x08 / 4] = 0;
+	p[0x0c / 4] = (2270u << 16) | 1048u;
+	p[0x10 / 4] = 16;
+	p[0x14 / 4] = (uint32_t)pa;
+	p[0x24 / 4] = 4608;
+	p[0x30 / 4] = 0x000236ffU;
+	p[0x34 / 4] = 0x03020001U;
+	p[0x38 / 4] = fVig0[0x38 / 4];
+	p[0x200 / 4] = 0;
+	p[0x210 / 4] = (uint32_t)(((uint64_t)1125 << 21) / 1048);
+	p[0x214 / 4] = (uint32_t)(((uint64_t)2436 << 21) / 2270);
+	p[0x220 / 4] = 0;
+	p[0x224 / 4] = 0;
+	p[0x204 / 4] = 3u | (2u << 8) | (2u << 10) | (2u << 16) | (2u << 18);
+	/* Keep ABL's RGB0 underneath as a fallback while VIG0 is tested. */
+	fFitMixer[0x20 / 4] = 0x100; /* opaque: FG_CONST=255, BG_CONST=0 */
+	fFitMixer[0x24 / 4] = 0xff;
+	fFitMixer[0x28 / 4] = 0;
+	fFitMixer[0] = fFitMixerMode | 2u; /* stage-0 blend enabled */
+	fCtl0[0x00 / 4] = 0x202;
+	__asm__ volatile("dsb sy" ::: "memory");
+	fCtl0[0x18 / 4] = 0x20049; /* CTL + LM0 + RGB0 + VIG0 */
+	__asm__ volatile("dsb sy" ::: "memory");
+	fFitActive = true;
+}
