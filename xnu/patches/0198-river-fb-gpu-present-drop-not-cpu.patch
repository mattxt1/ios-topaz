 #define RB5_R8G8B8A8_UNORM		48
 
 static int rgpu_blit_slot = -1;
+/* 0198: a blit that timed out keeps its windows mapped until it completes */
+static uint32_t rgpu_blit_pending;
+static uint64_t rgpu_blit_pending_src, rgpu_blit_pending_dst;
 
 int river_gpu_blit(const uint64_t *pa, uint32_t npages, uint64_t start, uint32_t src_pitch, uint32_t sx, uint32_t sy,
     uint64_t dst_pa, uint64_t dst_size, uint32_t dst_pitch, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h,
@@ -1285,6 +1288,18 @@ river_gpu_blit(const uint64_t *pa, uint32_t npages, uint64_t start, uint32_t src
 			return ENOMEM;
 		}
 	}
+	if (rgpu_blit_pending != 0) {
+		/* the previous blit timed out: let it finish before reusing its windows */
+		if (!rgpu_fence_done(rgpu_blit_pending) && !rgpu_wait(rgpu_blit_pending, timeout_ms)) {
+			return EBUSY;
+		}
+		lck_mtx_lock(rgpu_lock);
+		gmmu_unmap(RGPU_BLIT_DST_VA, rgpu_blit_pending_dst);
+		gmmu_unmap(RGPU_BLIT_SRC_VA, rgpu_blit_pending_src);
+		gmmu_sync();
+		lck_mtx_unlock(rgpu_lock);
+		rgpu_blit_pending = 0;
+	}
 	/* pixel (0,0) must be 64-byte aligned: move the misalignment into x */
 	uint64_t src_base = RGPU_BLIT_SRC_VA + (start & ~63ULL);
 	sx += (uint32_t)((start & 63) / 4);
@@ -1346,6 +1361,9 @@ river_gpu_blit(const uint64_t *pa, uint32_t npages, uint64_t start, uint32_t src
 		uint32_t seq = rgpu_submit(&ib, &n, 1);
 		if (!rgpu_wait(seq, timeout_ms)) {
 			err = ETIMEDOUT;
+			rgpu_blit_pending = seq;
+			rgpu_blit_pending_src = src_bytes;
+			rgpu_blit_pending_dst = dst_bytes;
 		}
 	}
 	if (err != ETIMEDOUT) {		/* a GPU still blitting keeps its mapping */
