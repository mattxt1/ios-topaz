+/* Five bounded TX_HIGH BD/payload pairs fit the existing unused pool gap.
+ * A timed-out pair is never overwritten or freed while DMA may own it. */
+static uint8_t river_self_sta, river_self_dpu;
+static bool river_self_ready, river_tx_stalled;
+static unsigned river_tx_slot, river_tx_submitted, river_tx_completed;
+static void
+river_put_be32(volatile uint8_t *p, uint32_t value)
+{
+ p[0] = value >> 24; p[1] = value >> 16; p[2] = value >> 8; p[3] = value;
+}
+static bool
+river_probe_tx(void)
+{
+ if (!river_dxe_ready || !river_self_ready || river_tx_stalled) return false;
+ unsigned slot = river_tx_slot, off = 0x6000 + slot * 0x1100;
+ volatile struct river_dxe_desc *ring =
+     (volatile struct river_dxe_desc *)(river_dxe_dma + 0x1000);
+ volatile struct river_dxe_desc *bd = &ring[slot * 2], *frame = bd + 1;
+ if ((bd->ctrl | frame->ctrl) & 1u) return false;
+ __asm__ volatile("dmb oshld" ::: "memory");
+ volatile uint8_t *b = (volatile uint8_t *)(river_dxe_dma + off);
+ volatile uint8_t *f = b + 0x100;
+ for (unsigned k = 0; k < 40; k++) b[k] = 0;
+ for (unsigned k = 0; k < 36; k++) f[k] = 0;
+ /* Probe request: broadcast DA/BSSID, local test SA, wildcard SSID.
+  * Advertise only legacy rates supported on 2.4GHz; no association. */
+ f[0] = 0x40;
+ for (unsigned k = 0; k < 6; k++) {
+  f[4 + k] = f[16 + k] = 255;
+  f[10 + k] = river_test_mac[k];
+ }
+ f[24] = 0; f[25] = 0; f[26] = 1; f[27] = 8;
+ static const uint8_t rates[] = {0x82, 0x84, 0x8b, 0x96, 12, 18, 24, 36};
+ for (unsigned k = 0; k < 8; k++) f[28 + k] = rates[k];
+ /* WCN36xx TX BD is 40 bytes, big-endian words. BMU25, no encryption,
+  * broadcast/no ACK, management rate, firmware non-QoS sequence number. */
+ river_put_be32(b, (25u << 24) | (1u << 7) | (1u << 3));
+ river_put_be32(b + 12, (24u << 24) | (40u << 16) | (64u << 7));
+ river_put_be32(b + 16, (36u << 16) | (1u << 12) | (7u << 8));
+ river_put_be32(b + 20, ((uint32_t)river_self_dpu << 24) |
+     ((uint32_t)river_self_sta << 16) | (1u << 14) | (2u << 12) | (10u << 7));
+ river_put_be32(b + 24, 0xbdbdbdbd);
+ bd->src = (uint32_t)(river_dxe_pa + off); bd->dst = 6; bd->len = 40;
+ frame->src = (uint32_t)(river_dxe_pa + off + 0x100); frame->dst = 6; frame->len = 36;
+ __asm__ volatile("dmb oshst" ::: "memory");
+ frame->ctrl = 0x32ce4d; /* valid, EOP, descriptor completion */
+ __asm__ volatile("dmb oshst" ::: "memory");
+ bd->ctrl = 0x30ce45; /* publish BD last, no EOP */
+ __asm__ volatile("dsb osh" ::: "memory");
+ vm_offset_t dxe = river_dxe_mmio + 0x2000;
+ ri_wr(dxe, 0x500, 0x853ecf4d);
+ river_tx_submitted++;
+ for (unsigned wait = 0; wait < 20; wait++) {
+  river_dxe_poll();
+  uint32_t status = ri_rd(dxe, 0x504);
+  if (status & 0x4000) break;
+  if (!((bd->ctrl | frame->ctrl) & 1u)) {
+   __asm__ volatile("dmb oshld" ::: "memory");
+   ri_wr(dxe, 0x30, 16);
+   if (status & 0x8000) ri_wr(dxe, 0x38, 16);
+   if (status & 0x2000) ri_wr(dxe, 0x34, 16);
+   river_tx_completed++;
+   river_tx_slot = (slot + 1) % 5;
+   printf("RIVER TX: DMA complete probe=%u slot=%u channel=%u status=%#x (no OTA ACK)\n",
+       river_tx_completed, slot, river_scan_channel, status);
+   return true;
+  }
+  ri_wait(10);
+ }
+ river_tx_stalled = true;
+ printf("RIVER TX: stalled probe=%u slot=%u channel=%u BD=%#x payload=%#x status=%#x errors=%#x; buffers retained\n",
+     river_tx_submitted, slot, river_scan_channel, bd->ctrl, frame->ctrl,
+     ri_rd(dxe, 0x504), ri_rd(dxe, 0x10));
+ return false;
+}
+
 /* Single outstanding HAL request, using byte-exact SMD packet lengths.
  * Nine-byte channel messages are NOT padded to four-byte boundaries. */
 static uint32_t
@@ -567,6 +656,15 @@
