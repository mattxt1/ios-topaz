+/* 0195: where pixel (0,0) is, from the start of the import's first page, and the row stride */
+void
+river_gpu_import_geometry(void *import, uint32_t *start, uint32_t *bpr, uint32_t *bpe, uint32_t *w, uint32_t *h)
+{
+	SweetSurface *s = (SweetSurface *)import;
+	IOByteCount seg = 0;
+	uint64_t first = s->memory->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+	*start = (uint32_t)(first & PAGE_MASK) + s->offset;
+	*bpr = s->bytesPerRow;
+	*bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+	*w = s->width;
+	*h = s->height;
+}
