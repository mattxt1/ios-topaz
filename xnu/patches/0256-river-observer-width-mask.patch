+/* Ignore unused bytes in the arbiter's 32-bit data register. */
+static bool
+ri_power_read(vm_offset_t obs, unsigned addr, unsigned count, uint32_t *out)
+{
+ uint32_t value;
+ if ((count != 1 && count != 2 && count != 4) || !ri_spmi_read(obs, addr, count, &value)) return false;
+ if (count == 1) value &= 0xffu;
+ else if (count == 2) value &= 0xffffu;
+ *out = value;
+ return true;
+}
 
