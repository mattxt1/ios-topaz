+static int
+river_emmc_write_block(uint64_t lba, const void *src)
+{
+	uint32_t resp, status;
+	if (!ready || !write_enabled || lba >> 32 || userdata_minor != 64 ||
+	    lba < parts[64].first || lba - parts[64].first >= parts[64].count) {
+		return EROFS;
+	}
+	int error = river_emmc_cmd(24, (uint32_t)lba, RSP_R1, &resp, (uint32_t *)src);
+	if (error) {
+		return error;
+	}
+	if (resp & R1_ERRORS) {
+		printf("RIVER eMMC: CMD24 LBA %llu rejected, R1 0x%x\n", lba, resp);
+		return EIO;
+	}
+	/* CMD24 transfer completion precedes the card's internal program cycle. */
+	uint64_t end = deadline(WRITE_TIMEOUT_NS);
+	do {
+		error = river_emmc_cmd(13, RCA << 16, RSP_R1, &status, NULL);
+		if (error) {
+			return error;
+		}
+		if (status & R1_ERRORS) {
+			printf("RIVER eMMC: CMD24 LBA %llu status error 0x%x\n", lba, status);
+			return EIO;
+		}
+		if ((status & (1U << 8)) && ((status >> 9) & 0xf) == 4) {
+			return 0;
+		}
+		delay(100);
+	} while (mach_absolute_time() < end);
+	printf("RIVER eMMC: CMD24 LBA %llu programming timeout, status 0x%x\n", lba, status);
+	return ETIMEDOUT;
+}
