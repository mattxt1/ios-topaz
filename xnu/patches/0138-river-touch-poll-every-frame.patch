diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 6338308..ca68ddb 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -198,7 +198,11 @@ ri_thread(void *arg, wait_result_t result)
   bool pok=ri_pon(&pon);
   int now[3]={!!(pon&1),vol_ok ? !(ri_rd(ri_key,0x1004)&1) : 0,!!(pon&2)};
   for (int k=0;k<3;k++) if((k==1?vol_ok:pok) && now[k]!=keys[k]) {keys[k]=now[k];sweet_hid_key(k,now[k]);}
