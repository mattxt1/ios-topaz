    if (ri_xfer(&reg,1,data,65)) {
     failures=0;
@@ -214,7 +218,7 @@ ri_thread(void *arg, wait_result_t result)
     for(unsigned i=0;i<10;i++) {if(down[i])sweet_hid_touch(i,0,0,0);down[i]=false;}
    }
   }
-  ri_wait(20);
+  ri_wait(10);
  }
 }
