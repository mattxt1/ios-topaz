+/* Strip alpha from the composed BGRA frame into the existing 3-byte scanout.
+ * Bounds are fixed to the measured ABL geometry; the last store is below
+ * 0x90001000 + 3240 * 2270, inside the reserved splash region. */
+void
+AppleCLCD::riverFlush(void)
+{
+	for (uint32_t y = 0; y < fHeight; y++) {
+		const uint8_t *src = (const uint8_t *)(fPixels + (uint64_t)y * fRowBytes);
+		volatile uint8_t *dst = fRiverScanout + (uint64_t)y * SWEET_EARLY_FB_STRIDE;
+		for (uint32_t x = 0; x < fWidth; x++) {
+			dst[3 * x] = src[4 * x];
+			dst[3 * x + 1] = src[4 * x + 1];
+			dst[3 * x + 2] = src[4 * x + 2];
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
 }
+#endif
 
