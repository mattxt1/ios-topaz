+/*
+ * Boot-arg rivergpu=1: read-only Adreno 506 power/clock survey (river DT:
+ * kgsl-3d0 0x1c00000, chipid 0x05000600; gdsc_oxili_cx 0x185904c,
+ * gdsc_oxili_gx 0x185901c fed by msm8953 GFX LDO 0x185f000; GCC GFX3D RCG
+ * 0x1859000, branches gfx3d/ahb/bimc_gfx/timer/aon at 0x1859020/28/34/40/44).
+ * GPU registers are read only when both GDSCs report power on and the AHB
+ * and core clocks are running (otherwise the access can hang the bus).
+ */
+static void
+river_gpu_probe(void)
+{
+ int on = 0;
+ if (!PE_parse_boot_argn("rivergpu", &on, sizeof(on)) || !on) return;
+ vm_offset_t g = ri_map(0x01859000), ldo = ri_map(0x0185f000);
+ if (!g || !ldo) { printf("RIVER GPU: map failed\n"); return; }
+ uint32_t gx = ri_rd(g, 0x1c), cx = ri_rd(g, 0x4c);
+ uint32_t gfx = ri_rd(g, 0x20), ahb = ri_rd(g, 0x28), bimc = ri_rd(g, 0x34), tmr = ri_rd(g, 0x40), aon = ri_rd(g, 0x44);
+ printf("RIVER GPU: GDSC gx %#x cx %#x; RCG cmd %#x cfg %#x; CBCR gfx3d %#x ahb %#x bimc_gfx %#x timer %#x aon %#x\n",
+     gx, cx, ri_rd(g, 0x00), ri_rd(g, 0x04), gfx, ahb, bimc, tmr, aon);
+ printf("RIVER GPU: GFX LDO ctrl %#x status %#x vref %#x ld_data %#x\n",
+     ri_rd(ldo, 0x1c), ri_rd(ldo, 0x28), ri_rd(ldo, 0x18), ri_rd(ldo, 0x10));
+ bool powered = (gx & (1u << 31)) && (cx & (1u << 31)) && !(ahb & (1u << 31)) && !(gfx & (1u << 31));
+ if (!powered) { printf("RIVER GPU: not powered/clocked; GPU registers not read\n"); return; }
+ vm_offset_t r = ri_map(0x01c00000);
+ if (!r) return;
+ printf("RIVER GPU: RBBM_STATUS %#x STATUS3 %#x INT_0_STATUS %#x CP_RB_BASE %#x\n",
+     ri_rd(r, 0x4f5 * 4), ri_rd(r, 0x530 * 4), ri_rd(r, 0x4e1 * 4), ri_rd(r, 0x800 * 4));
+}
+
 static void
 ri_probe(void)
 {
@@ -158,6 +187,7 @@ ri_probe(void)
   printf("%s (repeated for the live log)\n", river_emmc_note);
   extern char river_mdp_note[];
   printf("%s (repeated for the live log)\n", river_mdp_note);
+  river_gpu_probe();
  }
