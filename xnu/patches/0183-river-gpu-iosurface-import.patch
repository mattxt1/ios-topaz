 	return (uint32_t)slot + 1;
 }
 
+/*
+ * Wrap memory that stays wired elsewhere (an IOSurface's pages, mapped at
+ * kernel address kva, page aligned) as a buffer of owner. import is released
+ * with river_gpu_import_release() when the buffer is freed.
+ */
+uint32_t river_gpu_bo_import(void *owner, vm_offset_t kva, uint64_t size, void *import, uint64_t *gpuva);
+uint32_t
+river_gpu_bo_import(void *owner, vm_offset_t kva, uint64_t size, void *import, uint64_t *gpuva)
+{
+	if (!rgpu_up || size == 0 || (kva & PAGE_MASK) || (size & PAGE_MASK) || size > 256ULL * 1024 * 1024) return 0;
+	lck_mtx_lock(rgpu_lock);
+	int slot;
+	uint64_t at;
+	if (!rgpu_bo_place((vm_size_t)size, &slot, &at) || !rgpu_map_kernel_range(kva, (vm_size_t)size, at)) {
+		lck_mtx_unlock(rgpu_lock);
+		return 0;
+	}
+	rgpu_bos[slot] = (struct rgpu_bo){ .va = kva, .size = (vm_size_t)size, .gpuva = at, .used = true,
+		.owner = owner, .import = import };
+	lck_mtx_unlock(rgpu_lock);
+	*gpuva = at;
+	return (uint32_t)slot + 1;
+}
+
+int river_gpu_bo_info(void *owner, uint32_t handle, uint64_t *gpuva, uint64_t *size);
+int
+river_gpu_bo_info(void *owner, uint32_t handle, uint64_t *gpuva, uint64_t *size)
+{
+	struct rgpu_bo *b = rgpu_bo_get(owner, handle);
+	if (!b) return EINVAL;
+	*gpuva = b->gpuva;
+	*size = b->size;
+	return 0;
+}
