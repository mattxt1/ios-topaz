  __asm__ volatile("dmb oshst" ::: "memory"); data->ctrl = 0x328a4d;
  __asm__ volatile("dmb oshst" ::: "memory"); bd->ctrl = 0x308a45;
  __asm__ volatile("dsb osh" ::: "memory");
@@ -922,6 +999,16 @@
  river_wpa.data_tx_stalled = true;
  printf("RIVER WPA: EAPOL DMA stalled; buffers retained\n");
  return false;
