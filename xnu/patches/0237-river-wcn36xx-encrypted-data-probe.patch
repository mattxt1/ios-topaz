+static bool
+river_eapol_tx(const uint8_t *eapol, unsigned n)
+{
+ if (n < 99 || n > 512) return false;
+ uint8_t ethernet[526] = {0};
+ memcpy(ethernet,river_target.bssid,6);memcpy(ethernet+6,river_test_mac,6);
+ ethernet[12]=136;ethernet[13]=142;memcpy(ethernet+14,eapol,n);
+ return river_data_tx(ethernet,n+14,false);
 }
 
