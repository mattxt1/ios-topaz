+/* One encrypted DHCPDISCOVER is a data-path probe, not a lease or IP setup.
+ * Match a protected OFFER to our random XID/MAC before claiming RX success. */
+static uint8_t river_dhcp_xid[4];
+static bool river_dhcp_waiting, river_dhcp_offer;
+static unsigned river_encrypted_rx;
+static uint16_t
+river_ip_checksum(const uint8_t *p, unsigned n)
+{
+ uint32_t sum = 0;
+ for (unsigned i = 0; i+1 < n; i += 2) sum += ((unsigned)p[i]<<8)|p[i+1];
+ if (n & 1) sum += (unsigned)p[n-1]<<8;
+ while (sum>>16) sum = (sum&65535)+(sum>>16);
+ return ~sum;
+}
+static void
+river_encrypted_inspect(const volatile uint8_t *f, unsigned len, unsigned hlen, unsigned fc, uint32_t bd_flags)
+{
+ if (river_wpa.stage != 2 || (fc & 0x0c) != 8 || !(fc & 0x4000) ||
+     (bd_flags & 8) || (fc & 0x300) != 0x200 || hlen > len || len-hlen < 8 ||
+     !river_mac_equal(f+10, river_target.bssid)) return;
+ const volatile uint8_t *llc = f+hlen;
+ static const uint8_t ipllc[] = {170,170,3,0,0,0,8,0};
+ unsigned k;
+ for (k = 0; k < 8 && llc[k] == ipllc[k]; k++) {}
+ if (k != 8) return;
+ river_encrypted_rx++;
+ if (!river_dhcp_waiting || len-hlen-8 < 20) return;
+ const volatile uint8_t *ip = llc+8;
+ unsigned avail = len-hlen-8, ihl = (ip[0]&15)*4, total = ((unsigned)ip[2]<<8)|ip[3];
+ if (ip[0]>>4 != 4 || ihl < 20 || ihl > avail || total > avail || total < ihl+8 ||
+     ip[9] != 17 || (ip[6]&0x3f) || ip[7]) return;
+ const volatile uint8_t *udp = ip+ihl;
+ unsigned ulen = ((unsigned)udp[4]<<8)|udp[5];
+ if (udp[0] || udp[1] != 67 || udp[2] || udp[3] != 68 || ulen < 248 || ulen > total-ihl) return;
+ const volatile uint8_t *bootp = udp+8;
+ unsigned n = ulen-8;
+ if (bootp[0] != 2 || bootp[1] != 1 || bootp[2] != 6 ||
+     !river_mac_equal(bootp+28, river_test_mac) || bootp[236] != 99 || bootp[237] != 130 || bootp[238] != 83 || bootp[239] != 99) return;
+ for (k = 0; k < 4 && bootp[4+k] == river_dhcp_xid[k]; k++) {}
+ if (k != 4) return;
+ unsigned type = 0;
+ for (unsigned off = 240; off < n;) {
+  unsigned id = bootp[off++];
+  if (!id) continue;
+  if (id == 255) break;
+  if (off >= n) return;
+  unsigned size = bootp[off++];
+  if (size > n-off) return;
+  if (id == 53 && size == 1) type = bootp[off];
+  off += size;
+ }
+ if (type == 2) {
+  river_dhcp_offer = true; river_dhcp_waiting = false;
+  printf("RIVER DATA: matched protected DHCP OFFER; encrypted TX/RX probe passed\n");
+ }
+}
