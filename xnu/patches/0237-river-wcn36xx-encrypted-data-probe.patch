+static void river_network_drop(void);
+static void river_network_rx(const volatile uint8_t *,unsigned,unsigned,unsigned,uint32_t);
 static void
 river_target_rx(const volatile uint8_t *f, unsigned len, unsigned hlen, unsigned fc)
 {
  if (!river_target.found || !river_mac_equal(f + 4, river_test_mac) ||
