 }
+/* Ethernet-facing ifnet over the already associated 802.11 link. This
+ * exposes wl0 for IP plumbing; it is not an IO80211Family/Wi-Fi UI service.
+ * Stack callbacks only enqueue copies. The WCNSS worker alone submits DMA. */
+static ifnet_t river_wifi_ifp;
+static lck_mtx_t *river_net_lock;
+static bool river_net_live;
+static struct { uint16_t len; uint8_t bytes[1514]; } river_net_queue[32];
+static unsigned river_net_head, river_net_count;
+static void river_network_rx(const volatile uint8_t *, unsigned, unsigned, unsigned, uint32_t);
+static void
+river_network_drop(void)
+{
+ if (!river_net_lock) return;
+ lck_mtx_lock(river_net_lock); river_net_live = false; river_net_count = 0;
+ lck_mtx_unlock(river_net_lock);
+ if (river_wifi_ifp) ifnet_set_flags(river_wifi_ifp, 0, IFF_RUNNING);
+}
+static errno_t
+river_net_output(ifnet_t ifp, mbuf_t m)
+{
+ size_t n = mbuf_pkthdr_len(m); bool queued = false;
+ lck_mtx_lock(river_net_lock);
+ if (river_net_live && river_net_count < 32 && n >= 14 && n <= 1514) {
+  unsigned slot = (river_net_head+river_net_count)%32;
+  if (!mbuf_copydata(m,0,n,river_net_queue[slot].bytes)) {
+   river_net_queue[slot].len = n; river_net_count++; queued = true;
+  }
+ }
+ lck_mtx_unlock(river_net_lock);
+ mbuf_freem(m);
+ if (!queued) ifnet_stat_increment_out(ifp,0,0,1);
+ return 0;
+}
+static errno_t
+river_net_ioctl(ifnet_t ifp, unsigned long cmd, void *data __unused)
+{
+ switch (cmd) {
+ case SIOCSIFADDR: case SIOCAIFADDR: ifnet_set_flags(ifp,IFF_UP,IFF_UP); return 0;
+ case SIOCSIFFLAGS: case SIOCADDMULTI: case SIOCDELMULTI: return 0;
+ default: return EOPNOTSUPP;
+ }
+}
+static void
+river_net_detach(ifnet_t ifp __unused)
+{
+ river_network_drop();
+}
+static void
+river_network_create(void)
+{
+ if (!river_dhcp_offer || river_wpa.stage != 2 || river_wifi_ifp) return;
+ lck_grp_t *group = lck_grp_alloc_init("river_wifi", LCK_GRP_ATTR_NULL);
+ if (!group) return;
+ river_net_lock = lck_mtx_alloc_init(group,LCK_ATTR_NULL);
+ if (!river_net_lock) return;
+ struct ifnet_init_eparams init = {0};
+ init.ver=IFNET_INIT_CURRENT_VERSION;init.len=sizeof(init);init.flags=IFNET_INIT_LEGACY;
+ init.uniqueid="river-wcn36xx";init.uniqueid_len=sizeof("river-wcn36xx")-1;
+ init.name="wl";init.unit=0;init.family=IFNET_FAMILY_ETHERNET;init.type=IFT_ETHER;
+ init.output=river_net_output;init.demux=ether_demux;init.add_proto=ether_add_proto;
+ init.del_proto=ether_del_proto;init.check_multi=ether_check_multi;
+ init.framer_extended=ether_frameout_extended;init.ioctl=river_net_ioctl;init.detach=river_net_detach;
+ init.broadcast_addr=etherbroadcastaddr;init.broadcast_len=6;
+ if (ifnet_allocate_extended(&init,&river_wifi_ifp)) {river_wifi_ifp=NULL;return;}
+ ifnet_set_addrlen(river_wifi_ifp,6);ifnet_set_hdrlen(river_wifi_ifp,14);
+ ifnet_set_mtu(river_wifi_ifp,1500);ifnet_set_baudrate(river_wifi_ifp,54000000);
+ ifnet_set_flags(river_wifi_ifp,IFF_BROADCAST|IFF_SIMPLEX|IFF_MULTICAST,0xffff);
+ if (ifnet_attach(river_wifi_ifp,NULL)) {
+  ifnet_release(river_wifi_ifp);river_wifi_ifp=NULL;return;
+ }
+ ifnet_set_lladdr(river_wifi_ifp,river_test_mac,6);
+ errno_t err=proto_plumb(PF_INET,river_wifi_ifp);
+ if (!err) {
+  lck_mtx_lock(river_net_lock);river_net_live=true;lck_mtx_unlock(river_net_lock);
+  ifnet_set_flags(river_wifi_ifp,IFF_UP|IFF_RUNNING,IFF_UP|IFF_RUNNING);
+ }
+ printf("RIVER NET: wl0 Ethernet-facing Wi-Fi ifnet attached IPv4-plumb=%d; DHCP address not configured\n",err);
+}
+static void
+river_network_poll(void)
+{
+ if (!river_net_lock || !river_wifi_ifp) return;
+ uint8_t ethernet[1514];unsigned n=0;
+ lck_mtx_lock(river_net_lock);
+ if (river_net_live && river_net_count) {
+  unsigned slot=river_net_head;n=river_net_queue[slot].len;
+  memcpy(ethernet,river_net_queue[slot].bytes,n);
+  river_net_head=(slot+1)%32;river_net_count--;
+ }
+ lck_mtx_unlock(river_net_lock);
+ if (n) {
+  bool ok=river_data_tx(ethernet,n,true);
+  ifnet_stat_increment_out(river_wifi_ifp,ok?1:0,ok?n:0,ok?0:1);
+  if (!ok) river_network_drop();
+ }
+}
+static void
+river_network_rx(const volatile uint8_t *f,unsigned len,unsigned hlen,unsigned fc,uint32_t flags)
+{
+ if (!river_wifi_ifp || !river_net_live || river_wpa.stage!=2 || !(fc&0x4000) || (flags&8) ||
+     (fc&0x30c)!=0x208 || (fc&0x40) || hlen<24 || hlen>len || len-hlen<8 ||
+     !river_mac_equal(f+10,river_target.bssid)) return;
+ /* A-MSDU subframes require a separate deaggregator. */
+ if ((fc&0x80) && (hlen<26 || (f[24]&0x80))) return;
+ const volatile uint8_t *p=f+hlen;
+ static const uint8_t llc[]={170,170,3,0,0,0};
+ unsigned k;
+ for (k=0;k<6 && p[k]==llc[k];k++) {}
+ if (k!=6 || (p[6]==136 && p[7]==142)) return;
+ unsigned n=len-hlen-8+14;if(n>1514)return;
+ uint8_t ethernet[1514];
+ for(k=0;k<6;k++){ethernet[k]=f[4+k];ethernet[6+k]=f[16+k];}
+ ethernet[12]=p[6];ethernet[13]=p[7];
+ for(k=8;k<len-hlen;k++)ethernet[14+k-8]=p[k];
+ mbuf_t m=NULL;
+ if(mbuf_allocpacket(MBUF_DONTWAIT,n,NULL,&m)||mbuf_copyback(m,0,n,ethernet,MBUF_DONTWAIT)){
+  if(m)mbuf_freem(m);return;
+ }
+ void *header=mbuf_data(m);
+ mbuf_pkthdr_setrcvif(m,river_wifi_ifp);mbuf_pkthdr_setheader(m,header);
+ mbuf_pkthdr_adjustlen(m,-14);mbuf_setdata(m,(char*)header+14,mbuf_len(m)-14);
+ struct ifnet_stat_increment_param stats={0};stats.packets_in=1;stats.bytes_in=n;
+ ifnet_input(river_wifi_ifp,m,&stats);
+}
+
+static void
+river_dhcp_probe(void)
+{
+ if (river_wpa.stage != 2 || !river_wpa.keys_installed) return;
+ uint8_t ethernet[342] = {0};
+ for (unsigned k = 0; k < 6; k++) { ethernet[k] = 255; ethernet[6+k] = river_test_mac[k]; }
+ ethernet[12] = 8;
+ uint8_t *ip = ethernet+14, *udp = ip+20, *b = udp+8;
+ ip[0] = 0x45; river_be_put16(ip+2, sizeof(ethernet)-14); ip[8] = 64; ip[9] = 17;
+ memset(ip+16, 255, 4); river_be_put16(ip+10, river_ip_checksum(ip,20));
+ river_be_put16(udp,68); river_be_put16(udp+2,67); river_be_put16(udp+4,sizeof(ethernet)-34);
+ b[0] = 1; b[1] = 1; b[2] = 6;
+ read_random(river_dhcp_xid,4); memcpy(b+4,river_dhcp_xid,4); b[10] = 0x80;
+ memcpy(b+28,river_test_mac,6); b[236]=99;b[237]=130;b[238]=83;b[239]=99;
+ unsigned n=240;
+ b[n++]=53;b[n++]=1;b[n++]=1; /* DISCOVER */
+ b[n++]=61;b[n++]=7;b[n++]=1;memcpy(b+n,river_test_mac,6);n+=6;
+ b[n++]=55;b[n++]=4;b[n++]=1;b[n++]=3;b[n++]=6;b[n++]=51;b[n++]=255;
+ river_dhcp_waiting = true;
+ bool sent = river_data_tx(ethernet,sizeof(ethernet),true);
+ for (unsigned w=0; sent && !river_dhcp_offer && w<300; w++) { river_dxe_poll();ri_wait(10); }
+ river_dhcp_waiting = false;
+ if (river_dhcp_offer) river_network_create();
+ printf("RIVER DATA: encrypted DHCP probe DMA=%u matched-offer=%u protected-IPv4=%u; no lease requested\n",sent,river_dhcp_offer,river_encrypted_rx);
+}
+
