From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mattxt1 <matttysonx1@gmail.com>
Date: Sat, 24 Oct 2026 19:25:00 -0400
Subject: [PATCH] RIVER: ring periodic doorbells, monitor GIC and WCNSS SMD/SMP2P

---
 bsd/dev/sweet_keys.c | 175 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 175 insertions(+)

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a88eae8..8899aabb 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -750,6 +750,181 @@ river_wcnss_probe(void)
    ml_io_unmap(ipc_page, 0x4000);
   }
  }
+ uint32_t reset = 0;
+ if (PE_parse_boot_argn("riverwcnssreset", &reset, sizeof(reset)) && reset) {
+  vm_offset_t pmu = ml_io_map_unmappable(0x0a21c000, 0x4000, VM_WIMG_IO);
+  if (pmu) {
+   uint32_t spare = ri_rd(pmu, 0x88) | (1u << 25);
+   ri_wr(pmu, 0x88, spare);
+   printf("RIVER WCNSS: PMU spare set to %#x (NVBIN_DLND)\n", ri_rd(pmu, 0x88));
+   ri_wr(pmu, 0x04, 0);
+   uint32_t val = (1u << 5) | (1u << 4);
+   ri_wr(pmu, 0x04, val);
+   val |= (1u << 7);
+   ri_wr(pmu, 0x04, val);
+   unsigned spin = 0;
+   while ((ri_rd(pmu, 0x04) & (1u << 8)) && spin++ < 1000) delay(10);
+   val &= ~(1u << 7);
+   ri_wr(pmu, 0x04, val);
+   val |= (1u << 3);
+   ri_wr(pmu, 0x04, val);
+   spin = 0;
+   while ((ri_rd(pmu, 0x04) & (1u << 6)) && spin++ < 1000) delay(10);
+   val &= ~((1u << 5) | (1u << 3));
+   ri_wr(pmu, 0x04, val);
+   printf("RIVER WCNSS: Iris XO configured (pmu_cfg %#x); waiting 20ms...\n", ri_rd(pmu, 0x04));
+   delay(20000);
+   ml_io_unmap(pmu, 0x4000);
+  }
+  printf("RIVER WCNSS: invoking PAS 6 auth_and_reset...\n");
+  uint64_t ares = 0;
+  int64_t ast = river_scm(0x02, 0x05, 1, 6, 0, 0, &ares);
+  printf("RIVER WCNSS: PAS 6 auth_and_reset status %lld result %llu\n", ast, ares);
+  if (ast == 0 && ares == 0) {
+   printf("RIVER WCNSS: Pronto v3 brought out of reset!\n");
+   unsigned ent451 = SMEM_TOC + 451 * SMEM_ENTRY;
+   uint32_t alloc451 = ri_rd(smem, ent451);
+   uint32_t smp_buf = 0;
+   if (!alloc451) {
+    uint32_t foff = ri_rd(smem, 0xc4);
+    uint32_t favail = ri_rd(smem, 0xc8);
+    uint32_t req_sz = 344;
+    if (favail >= req_sz && foff + req_sz <= SMEM_SIZE) {
+     smp_buf = foff;
+     ri_wr(smem, ent451 + 4, foff);
+     ri_wr(smem, ent451 + 8, req_sz);
+     ri_wr(smem, ent451 + 12, 0);
+     __asm__ volatile("dmb sy" ::: "memory");
+     ri_wr(smem, ent451, 1);
+     ri_wr(smem, 0xc4, foff + req_sz);
+     ri_wr(smem, 0xc8, favail - req_sz);
+     printf("RIVER WCNSS: allocated SMEM item 451 at offset %#x size %u\n", smp_buf, req_sz);
+    }
+   } else {
+    smp_buf = ri_rd(smem, ent451 + 4);
+    printf("RIVER WCNSS: SMEM item 451 already allocated at offset %#x\n", smp_buf);
+   }
+   if (smp_buf && smp_buf < SMEM_SIZE) {
+    for (unsigned i = 0; i < 344; i += 4) ri_wr(smem, smp_buf + i, 0);
+    ri_wr(smem, smp_buf + 0, 0x504d5324);
+    ri_wr(smem, smp_buf + 8, (4u << 16) | 0u);
+    ri_wr(smem, smp_buf + 12, (1u << 16) | 16u);
+    ri_wr(smem, smp_buf + 16, 0);
+    ri_wr(smem, smp_buf + 20, 0x7473616d);
+    ri_wr(smem, smp_buf + 24, 0x6b2d7265);
+    ri_wr(smem, smp_buf + 28, 0x656e7265);
+    ri_wr(smem, smp_buf + 32, 0x0000006c);
+    ri_wr(smem, smp_buf + 36, 0);
+    __asm__ volatile("dmb sy" ::: "memory");
+    ri_wr(smem, smp_buf + 4, 1);
+    printf("RIVER WCNSS: initialized SMP2P item 451 master-kernel (version 1)\n");
+   }
+   vm_offset_t ipc_page2 = ml_io_map_unmappable(0x0b010000, 0x4000, VM_WIMG_IO);
+   vm_offset_t ipc_reg2 = ipc_page2 ? (ipc_page2 + 0x1008) : 0;
+   if (ipc_reg2) {
+    ri_wr(ipc_reg2, 0, (1u << 19) | (1u << 18) | (1u << 17));
+    printf("RIVER WCNSS: rang initial APCS IPC doorbells (bits 17..19, %#x)\n",
+        (1u << 19) | (1u << 18) | (1u << 17));
+   }
+   vm_offset_t gic = ml_io_map_unmappable(0x0b000000, 0x4000, VM_WIMG_IO);
+   uint32_t last_gic = 0;
+   for (unsigned w = 0; w < 40; w++) {
+    delay(100000);
+    if (ipc_reg2 && (w % 2 == 1)) {
+     ri_wr(ipc_reg2, 0, (1u << 19) | (1u << 18) | (1u << 17));
+    }
+    if (gic) {
+     uint32_t gp = ri_rd(gic, 0x214);
+     if (gp != last_gic || ((w + 1) % 5 == 0)) {
+      printf("RIVER WCNSS: GICD_ISPENDR5 = %#x (smd=%u smp=%u smsm=%u rdy=%u wdog=%u, waited %u ms)\n",
+          gp, (gp >> 14) & 1, (gp >> 15) & 1, (gp >> 16) & 1, (gp >> 19) & 1, (gp >> 21) & 1, (w + 1) * 100);
+      last_gic = gp;
+     }
+    }
+    unsigned ent422 = SMEM_TOC + 422 * SMEM_ENTRY;
+    uint32_t alloc422 = ri_rd(smem, ent422);
+    if (alloc422 && ((w + 1) % 5 == 0 || w == 0)) {
+     uint32_t off422 = ri_rd(smem, ent422 + 4);
+     uint32_t len422 = ri_rd(smem, ent422 + 8);
+     if (off422 < SMEM_SIZE && len422 >= 16) {
+      char sfr[81];
+      unsigned slen = len422 < 80 ? len422 : 80;
+      for (unsigned j = 0; j < slen; j++) {
+       unsigned char c = *(volatile unsigned char *)(smem + off422 + j);
+       sfr[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : ' ';
+      }
+      sfr[slen] = 0;
+      printf("RIVER WCNSS: SMEM 422 SFR (waited %u ms): [%s]\n", (w + 1) * 100, sfr);
+     }
+    }
+    unsigned ent431 = SMEM_TOC + 431 * SMEM_ENTRY;
+    if (ri_rd(smem, ent431)) {
+     uint32_t o431 = ri_rd(smem, ent431 + 4);
+     uint32_t l431 = ri_rd(smem, ent431 + 8);
+     if (o431 < SMEM_SIZE && l431 >= 20) {
+      uint32_t m431 = ri_rd(smem, o431);
+      uint32_t v431 = ri_rd(smem, o431 + 4);
+      uint32_t p431 = ri_rd(smem, o431 + 8);
+      uint32_t e431 = ri_rd(smem, o431 + 12);
+      char ename[17];
+      for (unsigned j = 0; j < 16; j++) {
+       unsigned char c = *(volatile unsigned char *)(smem + o431 + 20 + j);
+       ename[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : 0;
+      }
+      ename[16] = 0;
+      uint32_t eval = ri_rd(smem, o431 + 36);
+      printf("RIVER WCNSS: SMP2P-in 431 magic %#x ver %#x pids %#x ent %#x entry0 '%s' val %#x (waited %u ms)\n",
+          m431, v431, p431, e431, ename, eval, (w + 1) * 100);
+     }
+    }
+    static const unsigned tbls[] = { 13, 266 };
+    for (unsigned t = 0; t < sizeof(tbls) / sizeof(tbls[0]); t++) {
+     unsigned tid = tbls[t];
+     unsigned ent = SMEM_TOC + tid * SMEM_ENTRY;
+     if (!ri_rd(smem, ent)) continue;
+     uint32_t toff = ri_rd(smem, ent + 4);
+     uint32_t tlen = ri_rd(smem, ent + 8);
+     if (toff < SMEM_SIZE && tlen >= 64 * 32) {
+      for (unsigned i = 0; i < 64; i++) {
+       if (i == 4 || i == 8) continue;
+       unsigned e = toff + i * 32;
+       uint32_t cid = ri_rd(smem, e + 20);
+       uint32_t flags = ri_rd(smem, e + 24);
+       uint32_t refs = ri_rd(smem, e + 28);
+       if (refs) {
+        char name[21];
+        for (unsigned j = 0; j < 20; j++) {
+         unsigned char c = *(volatile unsigned char *)(smem + e + j);
+         name[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : 0;
+        }
+        name[20] = 0;
+        printf("RIVER WCNSS: SMD tbl %u slot %u cid %u flags %#x refs %u name '%s' (waited %u ms)\n",
+            tid, i, cid, flags, refs, name, (w + 1) * 100);
+       }
+      }
+     }
+    }
+   }
+   if (ipc_page2) ml_io_unmap(ipc_page2, 0x4000);
+   if (gic) ml_io_unmap(gic, 0x4000);
+   unsigned ent333 = SMEM_TOC + 333 * SMEM_ENTRY;
+   if (ri_rd(smem, ent333)) {
+    uint32_t o333 = ri_rd(smem, ent333 + 4);
+    uint32_t l333 = ri_rd(smem, ent333 + 8);
+    if (o333 < SMEM_SIZE && l333 >= 16) {
+     char vstr[81];
+     unsigned vlen = l333 < 80 ? l333 : 80;
+     for (unsigned j = 0; j < vlen; j++) {
+      unsigned char c = *(volatile unsigned char *)(smem + o333 + j);
+      vstr[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : ' ';
+     }
+     vstr[vlen] = 0;
+     printf("RIVER WCNSS: SMEM 333 image version: [%s]\n", vstr);
+    }
+   }
+   unsigned ent78 = SMEM_TOC + 78 * SMEM_ENTRY;
+   unsigned ent79 = SMEM_TOC + 79 * SMEM_ENTRY;
+   if (ri_rd(smem, ent78) && ri_rd(smem, ent79)) {
+    uint32_t o78 = ri_rd(smem, ent78 + 4);
+    uint32_t o79 = ri_rd(smem, ent79 + 4);
+    uint32_t l79 = ri_rd(smem, ent79 + 8);
+    if (o78 < SMEM_SIZE && o79 < SMEM_SIZE) {
+     uint32_t idx0 = ri_rd(smem, o78);
+     uint32_t idx1 = ri_rd(smem, o78 + 4);
+     printf("RIVER WCNSS: SMEM 78/79 log: idx0=%#x idx1=%#x len79=%#x head=%#x %#x %#x %#x\n",
+         idx0, idx1, l79,
+         ri_rd(smem, o79), ri_rd(smem, o79 + 4), ri_rd(smem, o79 + 8), ri_rd(smem, o79 + 12));
+    }
+   }
+   printf("RIVER WCNSS: surveying allocated SMEM items post-reset:\n");
+   for (unsigned id = 0; id < 512; id++) {
+    unsigned ent = SMEM_TOC + id * SMEM_ENTRY;
+    uint32_t a = ri_rd(smem, ent);
+    if (a) {
+     uint32_t o = ri_rd(smem, ent + 4);
+     uint32_t l = ri_rd(smem, ent + 8);
+     uint32_t u = ri_rd(smem, ent + 12);
+     printf("RIVER WCNSS: post-reset SMEM item %u alloc %u offset %#x size %#x aux %#x\n",
+         id, a, o, l, u);
+    }
+   }
+  }
+ }
  if (auxmem) ml_io_unmap(auxmem, 0x8000);
  ml_io_unmap(smem, SMEM_SIZE);
 
-- 
