Date: Sun, 25 Oct 2026 00:05:00 -0400
Subject: [PATCH] RIVER: unaligned-safe SMD FIFO access and WCN36XX_HAL_START_REQ

---
 bsd/dev/sweet_keys.c | 510 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 510 insertions(+)

--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -54,6 +54,20 @@
  *(volatile uint32_t *)(base + off) = v;
  __asm__ volatile("dsb osh" ::: "memory");
 }
+static inline uint32_t ri_fifo_rd32(vm_offset_t base, uint32_t off)
+{
+ const volatile uint8_t *p = (const volatile uint8_t *)(base + off);
+ return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static inline void ri_fifo_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+ volatile uint8_t *p = (volatile uint8_t *)(base + off);
+ p[0] = (uint8_t)(val & 0xff);
+ p[1] = (uint8_t)((val >> 8) & 0xff);
+ p[2] = (uint8_t)((val >> 16) & 0xff);
+ p[3] = (uint8_t)((val >> 24) & 0xff);
+}
+
 static void
 ri_wait(unsigned ms)
 {
@@ -391,6 +405,14 @@
   return;
  }
  const uint32_t *image = (const uint32_t *)ml_static_ptovirt((vm_offset_t)image_pa);
+ static uint64_t nv_pa = 0, nv_len = 0;
+ static const uint8_t *nv_bytes = NULL;
+ if (SecureDTGetProperty(mm, "RiverWCNSSNV", &prop, &psize) == kSuccess && psize == 16) {
+  nv_pa = ((const uint64_t *)prop)[0];
+  nv_len = ((const uint64_t *)prop)[1];
+  nv_bytes = (const uint8_t *)ml_static_ptovirt((vm_offset_t)nv_pa);
+  printf("RIVER WCNSS: found RiverWCNSSNV blob at %#llx (%llu bytes)\n", nv_pa, nv_len);
+ }
  printf("RIVER WCNSS: PAS mem_setup about to call for %#x+%#x (image %#llx)\n",
      WCNSS_PA, WCNSS_SIZE, image_pa);
  ri_wait(12000);
@@ -753,6 +775,491 @@
    ml_io_unmap(ipc_page, 0x4000);
   }
  }
+ uint32_t reset = 0;
+ if (PE_parse_boot_argn("riverwcnssreset", &reset, sizeof(reset)) && reset) {
+  vm_offset_t gcc = ml_io_map_unmappable(0x01800000, 0x80000, VM_WIMG_IO);
+  if (gcc) {
+   ri_wr(gcc, 0x16008, (1u << 8) | 19u); /* GPLL0 / 10 = 80 MHz scm_core_clk_src */
+   ri_wr(gcc, 0x16004, 1);
+   unsigned spin = 0;
+   while ((ri_rd(gcc, 0x16004) & 1) && spin++ < 1000) delay(1);
+   ri_wr(gcc, 0x45004, ri_rd(gcc, 0x45004) | 0x7); /* bits 0,1,2: SCM crypto proxy branches */
+   printf("RIVER WCNSS: enabled proxy clocks in GCC (rcg %#x vote %#x)\n",
+       ri_rd(gcc, 0x16008), ri_rd(gcc, 0x45004));
+   ml_io_unmap(gcc, 0x80000);
+  }
+  vm_offset_t pmu = ml_io_map_unmappable(0x0a21c000, 0x4000, VM_WIMG_IO);
+  if (pmu) {
+   uint32_t spare = ri_rd(pmu, 0x88) | (1u << 25);
+   ri_wr(pmu, 0x88, spare);
+   printf("RIVER WCNSS: PMU spare set to %#x (NVBIN_DLND)\n", ri_rd(pmu, 0x88));
+   ri_wr(pmu, 0x04, 0);
+   uint32_t val = (1u << 5) | (1u << 4);
+   ri_wr(pmu, 0x04, val);
+   val |= (1u << 7);
+   ri_wr(pmu, 0x04, val);
+   unsigned spin = 0;
+   while ((ri_rd(pmu, 0x04) & (1u << 8)) && spin++ < 1000) delay(10);
+   val &= ~(1u << 7);
+   ri_wr(pmu, 0x04, val);
+   val |= (1u << 3);
+   ri_wr(pmu, 0x04, val);
+   spin = 0;
+   while ((ri_rd(pmu, 0x04) & (1u << 6)) && spin++ < 1000) delay(10);
+   val &= ~((1u << 5) | (1u << 3));
+   ri_wr(pmu, 0x04, val);
+   printf("RIVER WCNSS: Iris XO configured (pmu_cfg %#x); waiting 20ms...\n", ri_rd(pmu, 0x04));
+   delay(20000);
+   ml_io_unmap(pmu, 0x4000);
+  }
+  printf("RIVER WCNSS: invoking PAS 6 auth_and_reset...\n");
+  uint64_t ares = 0;
+  int64_t ast = river_scm(0x02, 0x05, 1, 6, 0, 0, &ares);
+  printf("RIVER WCNSS: PAS 6 auth_and_reset status %lld result %llu\n", ast, ares);
+  if (ast == 0 && ares == 0) {
+   printf("RIVER WCNSS: Pronto v3 brought out of reset!\n");
+   unsigned ent431 = SMEM_TOC + 431 * SMEM_ENTRY;
+   uint32_t alloc431 = ri_rd(smem, ent431);
+   uint32_t smp_buf = 0;
+   if (!alloc431) {
+    uint32_t foff = ri_rd(smem, 0xc4);
+    uint32_t favail = ri_rd(smem, 0xc8);
+    uint32_t req_sz = 344;
+    if (favail >= req_sz && foff + req_sz <= SMEM_SIZE) {
+     smp_buf = foff;
+     ri_wr(smem, ent431 + 4, foff);
+     ri_wr(smem, ent431 + 8, req_sz);
+     ri_wr(smem, ent431 + 12, 0);
+     __asm__ volatile("dmb sy" ::: "memory");
+     ri_wr(smem, ent431, 1);
+     ri_wr(smem, 0xc4, foff + req_sz);
+     ri_wr(smem, 0xc8, favail - req_sz);
+     printf("RIVER WCNSS: allocated SMEM item 431 at offset %#x size %u\n", smp_buf, req_sz);
+    }
+   } else {
+    smp_buf = ri_rd(smem, ent431 + 4);
+    printf("RIVER WCNSS: SMEM item 431 already allocated at offset %#x\n", smp_buf);
+   }
+   if (smp_buf && smp_buf < SMEM_SIZE) {
+    for (unsigned i = 0; i < 344; i += 4) ri_wr(smem, smp_buf + i, 0);
+    ri_wr(smem, smp_buf + 0, 0x504d5324);
+    ri_wr(smem, smp_buf + 8, (4u << 16) | 0u);
+    ri_wr(smem, smp_buf + 12, (1u << 16) | 16u);
+    ri_wr(smem, smp_buf + 16, 0);
+    ri_wr(smem, smp_buf + 20, 0x7473616d);
+    ri_wr(smem, smp_buf + 24, 0x6b2d7265);
+    ri_wr(smem, smp_buf + 28, 0x656e7265);
+    ri_wr(smem, smp_buf + 32, 0x0000006c);
+    ri_wr(smem, smp_buf + 36, 0);
+    __asm__ volatile("dmb sy" ::: "memory");
+    ri_wr(smem, smp_buf + 4, 1);
+    printf("RIVER WCNSS: initialized outbound SMP2P item 431 master-kernel (version 1)\n");
+   }
+   vm_offset_t ipc_page2 = ml_io_map_unmappable(0x0b010000, 0x4000, VM_WIMG_IO);
+   vm_offset_t ipc_reg2 = ipc_page2 ? (ipc_page2 + 0x1008) : 0;
+   if (ipc_reg2) {
+    ri_wr(ipc_reg2, 0, (1u << 19) | (1u << 18) | (1u << 17));
+    printf("RIVER WCNSS: rang initial APCS IPC doorbells (bits 17..19, %#x)\n",
+        (1u << 19) | (1u << 18) | (1u << 17));
+   }
+   vm_offset_t gic = ml_io_map_unmappable(0x0b000000, 0x4000, VM_WIMG_IO);
+   uint32_t last_gic = 0;
+   uint32_t wcnss_ctrl_info = 0, wcnss_ctrl_fifo = 0;
+   uint32_t wcnss_wlan_info = 0, wcnss_wlan_fifo = 0;
+   bool version_req_sent = false, version_rsp_received = false;
+   bool nv_download_sent = false, nv_download_acked = false;
+   bool wlan_start_sent = false, wlan_start_acked = false;
+   for (unsigned w = 0; w < 80; w++) {
+    delay(100000);
+    if (ipc_reg2 && (w % 2 == 1)) {
+     ri_wr(ipc_reg2, 0, (1u << 19) | (1u << 18) | (1u << 17));
+    }
+    if (gic) {
+     uint32_t gp = ri_rd(gic, 0x214);
+     if (gp != last_gic || ((w + 1) % 5 == 0)) {
+      printf("RIVER WCNSS: GICD_ISPENDR5 = %#x (smd=%u smp=%u smsm=%u rdy=%u wdog=%u, waited %u ms)\n",
+          gp, (gp >> 14) & 1, (gp >> 15) & 1, (gp >> 16) & 1, (gp >> 19) & 1, (gp >> 21) & 1, (w + 1) * 100);
+      last_gic = gp;
+     }
+     if (gp & (1u << 14)) {
+      ri_wr(gic, 0x294, 1u << 14);
+      if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 17);
+     }
+     if (gp & (1u << 15)) {
+      ri_wr(gic, 0x294, 1u << 15);
+      if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 18);
+     }
+    }
+    unsigned ent422 = SMEM_TOC + 422 * SMEM_ENTRY;
+    uint32_t alloc422 = ri_rd(smem, ent422);
+    if (alloc422 && ((w + 1) % 5 == 0 || w == 0)) {
+     uint32_t off422 = ri_rd(smem, ent422 + 4);
+     uint32_t len422 = ri_rd(smem, ent422 + 8);
+     if (off422 < SMEM_SIZE && len422 >= 16) {
+      char sfr[81];
+      unsigned slen = len422 < 80 ? len422 : 80;
+      for (unsigned j = 0; j < slen; j++) {
+       unsigned char c = *(volatile unsigned char *)(smem + off422 + j);
+       sfr[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : ' ';
+      }
+      sfr[slen] = 0;
+      printf("RIVER WCNSS: SMEM 422 SFR (waited %u ms): [%s]\n", (w + 1) * 100, sfr);
+     }
+    }
+    unsigned ent451 = SMEM_TOC + 451 * SMEM_ENTRY;
+    if (ri_rd(smem, ent451)) {
+     uint32_t o451 = ri_rd(smem, ent451 + 4);
+     uint32_t l451 = ri_rd(smem, ent451 + 8);
+     if (o451 < SMEM_SIZE && l451 >= 20) {
+      uint32_t m451 = ri_rd(smem, o451);
+      uint32_t v451 = ri_rd(smem, o451 + 4);
+      uint32_t p451 = ri_rd(smem, o451 + 8);
+      uint32_t e451 = ri_rd(smem, o451 + 12);
+      char ename[17];
+      for (unsigned j = 0; j < 16; j++) {
+       unsigned char c = *(volatile unsigned char *)(smem + o451 + 20 + j);
+       ename[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : 0;
+      }
+      ename[16] = 0;
+      uint32_t eval = ri_rd(smem, o451 + 36);
+      printf("RIVER WCNSS: SMP2P-in 451 magic %#x ver %#x pids %#x ent %#x entry0 '%s' val %#x (waited %u ms)\n",
+          m451, v451, p451, e451, ename, eval, (w + 1) * 100);
+      if (eval & 2) {
+       printf("RIVER WCNSS: Pronto err-ready is ASSERTED (val=%#x)! Pronto handshake complete!\n", eval);
+      }
+     }
+    }
+    uint32_t pt_magic = ri_rd(smem, SMEM_SIZE - 0x1000);
+    if (pt_magic == 0x434f5424 && ((w + 1) % 10 == 0 || w == 0 || w == 39)) {
+     uint32_t npart = ri_rd(smem, SMEM_SIZE - 0x1000 + 8);
+     for (unsigned p = 0; p < npart && p < 16; p++) {
+      uint32_t pe = (SMEM_SIZE - 0x1000 + 32) + p * 24;
+      uint32_t poff = ri_rd(smem, pe);
+      uint32_t psz = ri_rd(smem, pe + 4);
+      uint32_t phosts = ri_rd(smem, pe + 12);
+      uint16_t h0 = phosts & 0xffff;
+      uint16_t h1 = (phosts >> 16) & 0xffff;
+      if (w == 0) {
+       printf("RIVER WCNSS: ptable part %u: hosts %u:%u off %#x size %#x\n", p, h0, h1, poff, psz);
+      }
+      if ((h0 == 0 && h1 == 4) || (h0 == 4 && h1 == 0)) {
+       if (poff < SMEM_SIZE && psz >= 32) {
+        uint32_t pmag = ri_rd(smem, poff);
+        uint32_t pfree_unc = ri_rd(smem, poff + 12);
+        if (pmag == 0x54525024) {
+         uint32_t cpos = poff + 32;
+         while (cpos + 16 <= poff + pfree_unc && cpos + 16 < SMEM_SIZE) {
+          uint32_t w0 = ri_rd(smem, cpos);
+          uint16_t canary = w0 & 0xffff;
+          uint16_t itm = (w0 >> 16) & 0xffff;
+          uint32_t isz = ri_rd(smem, cpos + 4);
+          uint32_t pads = ri_rd(smem, cpos + 8);
+          uint16_t phdr = (pads >> 16) & 0xffff;
+          if (canary != 0xa5a5) break;
+          uint32_t data_off = cpos + 16 + phdr;
+          if (itm == 13 && data_off + 32 <= SMEM_SIZE) {
+           for (unsigned s = 0; s < 64; s++) {
+            uint32_t se = data_off + s * 32;
+            if (se + 32 > SMEM_SIZE) break;
+            uint32_t scid = ri_rd(smem, se + 20);
+            uint32_t sflg = ri_rd(smem, se + 24);
+            uint32_t sref = ri_rd(smem, se + 28);
+            if (sref) {
+             char sname[21];
+             for (unsigned j = 0; j < 20; j++) {
+              unsigned char c = *(volatile unsigned char *)(smem + se + j);
+              sname[j] = (c >= 0x20 && c <= 0x7e) ? (char)c : 0;
+             }
+             sname[20] = 0;
+             printf("RIVER WCNSS: part4 SMD slot %u cid %u flg %#x ref %u name '%s' (waited %u ms)\n",
+                 s, scid, sflg, sref, sname, (w + 1) * 100);
+            }
+           }
+          } else {
+           if (itm == 19) wcnss_ctrl_info = data_off;
+           if (itm == 343) wcnss_ctrl_fifo = data_off;
+           if (itm == 20) wcnss_wlan_info = data_off;
+           if (itm == 344) wcnss_wlan_fifo = data_off;
+           if (w == 0 || w == 39) {
+            printf("RIVER WCNSS: part4 item %u off %#x size %u phdr %u\n", itm, cpos, isz, phdr);
+           }
+          }
+          cpos += 16 + phdr + isz;
+         }
+        }
+       }
+      }
+     }
+    }
+    if (wcnss_ctrl_info && wcnss_ctrl_fifo) {
+     uint32_t tx_st = ri_rd(smem, wcnss_ctrl_info);
+     uint32_t rx_st = ri_rd(smem, wcnss_ctrl_info + 20);
+     if (w % 5 == 0 || tx_st != 2 || rx_st != 2) {
+      printf("RIVER WCNSS: WCNSS_CTRL state: tx=%u rx=%u (tx_t=%u tx_h=%u rx_t=%u rx_h=%u, waited %u ms)\n",
+          tx_st, rx_st, ri_rd(smem, wcnss_ctrl_info + 12), ri_rd(smem, wcnss_ctrl_info + 16),
+          ri_rd(smem, wcnss_ctrl_info + 32), ri_rd(smem, wcnss_ctrl_info + 36), (w + 1) * 100);
+     }
+     if (tx_st == 0) {
+      ri_wr(smem, wcnss_ctrl_info + 4, (1u << 16) | (1u << 8) | 1u); /* fDSR=1, fCTS=1, fCD=1 */
+      ri_wr(smem, wcnss_ctrl_info + 8, (1u << 16)); /* fSTATE=1 */
+      ri_wr(smem, wcnss_ctrl_info, 1); /* SMD_OPENING */
+      __asm__ volatile("dmb sy" ::: "memory");
+      if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 17);
+      printf("RIVER WCNSS: WCNSS_CTRL transitioned tx to SMD_OPENING\n");
+     } else if (tx_st == 1 && (rx_st == 1 || rx_st == 2)) {
+      ri_wr(smem, wcnss_ctrl_info, 2); /* SMD_OPENED */
+      ri_wr(smem, wcnss_ctrl_info + 8, (1u << 16)); /* fSTATE=1 */
+      __asm__ volatile("dmb sy" ::: "memory");
+      if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 17);
+      printf("RIVER WCNSS: WCNSS_CTRL transitioned tx to SMD_OPENED\n");
+     }
+     if (tx_st == 2 && rx_st == 2 && !version_req_sent) {
+      uint32_t head = ri_rd(smem, wcnss_ctrl_info + 16);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 0) & 8191), 8);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 4) & 8191), 0);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 8) & 8191), 0);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 12) & 8191), 0);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 16) & 8191), 0);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 20) & 8191), 0x01000000);
+      ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 24) & 8191), 8);
+      head = (head + 28) & 8191;
+      ri_wr(smem, wcnss_ctrl_info + 16, head);
+      ri_wr(smem, wcnss_ctrl_info + 8, 1u | (1u << 16)); /* fHEAD=1, fSTATE=1 */
+      __asm__ volatile("dmb sy" ::: "memory");
+      if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 17);
+      version_req_sent = true;
+      printf("RIVER WCNSS: sent WCNSS_VERSION_REQ (head=%u)!\n", head);
+     }
+     if (version_req_sent) {
+      uint32_t rx_fifo_off = wcnss_ctrl_fifo + 8192;
+      uint32_t rx_h = ri_rd(smem, wcnss_ctrl_info + 36);
+      uint32_t rx_t = ri_rd(smem, wcnss_ctrl_info + 32);
+      if (rx_h != rx_t) {
+       uint32_t smd_len = ri_fifo_rd32(smem, rx_fifo_off + (rx_t & 8191));
+       uint32_t r_type = ri_fifo_rd32(smem, rx_fifo_off + ((rx_t + 20) & 8191));
+       uint32_t r_len = ri_fifo_rd32(smem, rx_fifo_off + ((rx_t + 24) & 8191));
+       uint32_t r_ver = ri_fifo_rd32(smem, rx_fifo_off + ((rx_t + 28) & 8191));
+       printf("RIVER WCNSS: RX packet: smd_len=%u type=%#x len=%u ver_word=%#x (rx_h=%u rx_t=%u)\n",
+           smd_len, r_type, r_len, r_ver, rx_h, rx_t);
+       if (r_type == 0x01000001) {
+        uint8_t maj = r_ver & 0xff;
+        uint8_t min = (r_ver >> 8) & 0xff;
+        uint8_t ver = (r_ver >> 16) & 0xff;
+        uint8_t rev = (r_ver >> 24) & 0xff;
+        printf("RIVER WCNSS: Pronto Firmware Version: %u.%u.%u.%u\n", maj, min, ver, rev);
+        version_rsp_received = true;
+       } else if (r_type == 0x01000003) {
+        printf("RIVER WCNSS: received WCNSS_NVBIN_DNLD_RSP! status=%#x\n", r_ver);
+        nv_download_acked = true;
+       }
+       unsigned total_adv = 20 + smd_len;
+       rx_t = (rx_t + total_adv) & 8191;
+       ri_wr(smem, wcnss_ctrl_info + 32, rx_t);
+       ri_wr(smem, wcnss_ctrl_info + 28, (1u << 8) | (1u << 16)); /* fTAIL=1, fSTATE=1 */
+       __asm__ volatile("dmb sy" ::: "memory");
+       if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 17);
+      }
+     }
+     if (version_rsp_received && !nv_download_sent && nv_bytes && nv_len >= 16) {
+      printf("RIVER WCNSS: starting NV download (%llu bytes in 3072-byte frags)...\n", nv_len);
+      unsigned total_frags = (unsigned)((nv_len + 3071) / 3072);
+      for (unsigned f = 0; f < total_frags; f++) {
+       uint32_t off = f * 3072;
+       uint32_t chunk = (off + 3072 <= nv_len) ? 3072 : (uint32_t)(nv_len - off);
+       uint16_t flags = (f == total_frags - 1) ? 0x8001 : 0x0000;
+       uint32_t head = ri_rd(smem, wcnss_ctrl_info + 16);
+       unsigned wait_drain = 0;
+       while (ri_rd(smem, wcnss_ctrl_info + 12) != head && wait_drain++ < 500) {
+        delay(1000);
+       }
+       uint32_t smd_len = 16 + chunk;
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 0) & 8191), smd_len);
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 4) & 8191), 0);
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 8) & 8191), 0);
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 12) & 8191), 0);
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 16) & 8191), 0);
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 20) & 8191), 0x01000002); /* WCNSS_NVBIN_DNLD_REQ */
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 24) & 8191), 8 + chunk);
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 28) & 8191), f | ((uint32_t)flags << 16));
+       ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 32) & 8191), chunk);
+       for (unsigned b = 0; b < chunk; b += 4) {
+        uint32_t wval = 0;
+        unsigned remain = chunk - b;
+        if (remain >= 4) {
+         wval = *(const uint32_t *)(nv_bytes + off + b);
+        } else {
+         for (unsigned k = 0; k < remain; k++) {
+          wval |= ((uint32_t)nv_bytes[off + b + k]) << (k * 8);
+         }
+        }
+        ri_fifo_wr32(smem, wcnss_ctrl_fifo + ((head + 36 + b) & 8191), wval);
+       }
+       unsigned adv = 20 + ((smd_len + 3) & ~3);
+       head = (head + adv) & 8191;
+       ri_wr(smem, wcnss_ctrl_info + 16, head);
+       ri_wr(smem, wcnss_ctrl_info + 8, 1u | (1u << 16)); /* fHEAD=1, fSTATE=1 */
+       __asm__ volatile("dmb sy" ::: "memory");
+       if (ipc_reg2) ri_wr(ipc_reg2, 0, 1u << 17);
+       printf("RIVER WCNSS: sent NV frag %u/%u (chunk=%u, flags=%#x, head=%u)\n",
+           f + 1, total_frags, chunk, flags, head);
+      }
+      nv_download_sent = true;
+     }
