+/* On-demand, read-only observer sample. The atomic gate prevents concurrent
+ * readers from racing on the same SPMI observer command registers. */
+static int
+river_power_sample_sysctl SYSCTL_HANDLER_ARGS
+{
+ if (!__atomic_load_n(&ri_power_ready, __ATOMIC_ACQUIRE)) return ENXIO;
+ int expected = 0;
+ if (!__atomic_compare_exchange_n(&ri_power_busy, &expected, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return EBUSY;
+ uint32_t mod, en, s2, s3, cfg, threshold, usb, qstatus, qirq, soc, voltage;
+ int error = EIO;
+ if (ri_spmi_read(ri_power_led, 0x46, 1, &mod) && ri_spmi_read(ri_power_led, 0x4c, 1, &en) &&
+     ri_spmi_read(ri_power_charger, 7, 1, &s2) && ri_spmi_read(ri_power_charger, 8, 1, &s3) &&
+     ri_spmi_read(ri_power_charger, 0x60, 1, &cfg) && ri_spmi_read(ri_power_charger, 0x68, 1, &threshold) &&
+     ri_spmi_read(ri_power_usb, 0x10, 1, &usb) && ri_spmi_read(ri_power_qg, 8, 1, &qstatus) &&
+     ri_spmi_read(ri_power_qg, 0x10, 1, &qirq) && ri_spmi_read(ri_power_qg, 0xbf, 1, &soc) &&
+     ri_spmi_read(ri_power_qg, 0xc0, 2, &voltage)) {
+  char note[256];
+  snprintf(note, sizeof(note), "led_mod=%#x led_en=%#x charger=%#x/%#x cfg=%#x threshold=%#x usb_irq=%#x qg=%#x/%#x soc=%#x voltage_raw=%#x", mod, en, s2, s3, cfg, threshold, usb, qstatus, qirq, soc, voltage);
+  error = sysctl_handle_string(oidp, note, 0, req);
+ }
+ __atomic_store_n(&ri_power_busy, 0, __ATOMIC_RELEASE);
+ return error;
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_power_sample, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_power_sample_sysctl, "A", "River live power sample");
+
