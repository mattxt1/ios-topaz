#!/bin/sh
# Root shell (or one command) on River's iOS over USB Ethernet. Needs the
# receiver running (it gives the Mac 192.168.7.1) and the key from userland/.
#   tools/river-ssh ['command']
u="$(cd "$(dirname "$0")/../../userland" && pwd)"
exec ssh -i "$u/ssh/id_ed25519" -o UserKnownHostsFile="$u/ssh/known_hosts" \
	-o ConnectTimeout=30 root@192.168.7.2 "$@"
